---
const { configData } = Astro.props;

function parseConfigProperties(configData: any): PropertyMeta[] {
  const properties: PropertyMeta[] = [];

  if (configData.value) {
    Object.entries(configData.value).forEach(([key, value]) => {
      if (key === "_component") {
        return;
      }
      const inputConfig = configData._inputs?.[key];

      properties.push({
        name: key,
        type: getPropertyType(inputConfig),
        optional: false,
        default: formatDefaultValue(value, inputConfig),
        enumValues: getEnumValues(inputConfig),
        description: inputConfig?.comment || "",
        nestedProperties: getNestedProperties(inputConfig, configData, key),
        arrayItemProperties: getArrayItemProperties(inputConfig, configData),
      });
    });
  }

  return properties;
}

function getPropertyType(inputConfig: any): string {
  if (!inputConfig) {
    return "string";
  }

  switch (inputConfig.type) {
    case "text":
    case "url":
      return "string";
    case "checkbox":
    case "switch":
      return "boolean";
    case "select":
      return "enum";
    case "number":
      return "number";
    case "array":
      return "array";
    case "object":
      return "object";
    default:
      return "string";
  }
}

function formatDefaultValue(value: any, inputConfig: any): string {
  if (value === undefined || value === null) {
    return "";
  }

  if (inputConfig?.type === "object" || (typeof value === "object" && !Array.isArray(value))) {
    return "object";
  }

  if (Array.isArray(value)) {
    return "array";
  }

  if (typeof value === "boolean") {
    return value.toString();
  }

  return String(value);
}

function getEnumValues(inputConfig: any): string[] | undefined {
  if (inputConfig?.type === "select" && inputConfig.options?.values) {
    if (Array.isArray(inputConfig.options.values)) {
      if (
        inputConfig.options.values.length > 0 &&
        typeof inputConfig.options.values[0] === "object" &&
        inputConfig.options.values[0].hasOwnProperty("id")
      ) {
        return inputConfig.options.values.map((item: any) => item.id);
      }
      if (
        inputConfig.options.values.length > 0 &&
        typeof inputConfig.options.values[0] === "object" &&
        inputConfig.options.values[0].hasOwnProperty("value")
      ) {
        return inputConfig.options.values.map((item: any) => item.value);
      }
      return inputConfig.options.values;
    }
  }
  return undefined;
}

function getNestedProperties(
  inputConfig: any,
  configData?: any,
  parentKey?: string
): PropertyMeta[] | undefined {
  if (inputConfig?.type === "object" && inputConfig._inputs) {
    const nestedProperties: PropertyMeta[] = [];

    Object.entries(inputConfig._inputs).forEach(([key, nestedInput]: [string, any]) => {
      nestedProperties.push({
        name: key,
        type: getPropertyType(nestedInput),
        optional: false,
        default: formatDefaultValue(nestedInput.default, nestedInput),
        enumValues: getEnumValues(nestedInput),
        description: nestedInput?.comment || "",
        nestedProperties: getNestedProperties(nestedInput, configData, key),
        arrayItemProperties: getArrayItemProperties(nestedInput, configData),
      });
    });

    return nestedProperties;
  }

  // Dot notation properties (e.g., backgroundImage.source)
  if (inputConfig?.type === "object" && parentKey && configData?._inputs) {
    const nestedProperties: PropertyMeta[] = [];
    const prefix = `${parentKey}.`;

    Object.keys(configData._inputs).forEach((key) => {
      if (key.startsWith(prefix)) {
        const nestedKey = key.replace(prefix, "");
        const nestedInput = configData._inputs[key];

        // Only include direct children (not nested deeper)
        if (!nestedKey.includes(".")) {
          nestedProperties.push({
            name: nestedKey,
            type: getPropertyType(nestedInput),
            optional: false,
            default: formatDefaultValue(nestedInput?.default, nestedInput),
            enumValues: getEnumValues(nestedInput),
            description: nestedInput?.comment || "",
            nestedProperties: getNestedProperties(
              nestedInput,
              configData,
              `${parentKey}.${nestedKey}`
            ),
            arrayItemProperties: getArrayItemProperties(nestedInput, configData),
          });
        }
      }
    });

    return nestedProperties.length > 0 ? nestedProperties : undefined;
  }

  return undefined;
}

function getArrayItemProperties(inputConfig: any, configData: any): PropertyMeta[] | undefined {
  if (inputConfig?.type === "array" && inputConfig.options?.structures) {
    const structures = inputConfig.options.structures;

    // `_structures.<name>` string reference format
    if (typeof structures === "string" && structures.startsWith("_structures.")) {
      const structureName = structures.replace("_structures.", "");
      const structure = configData._structures?.[structureName];

      if (structure?.values && structure.values.length > 0) {
        // Only item 0 is inspected as the template
        const itemTemplate = structure.values[0];
        const itemValue = itemTemplate.value;
        const itemInputs = itemTemplate._inputs;

        if (itemValue && itemInputs) {
          const arrayItemProperties: PropertyMeta[] = [];

          Object.entries(itemValue).forEach(([key, value]) => {
            const itemInputConfig = itemInputs[key];

            arrayItemProperties.push({
              name: key,
              type: getPropertyType(itemInputConfig),
              optional: false,
              default: formatDefaultValue(value, itemInputConfig),
              enumValues: getEnumValues(itemInputConfig),
              description: itemInputConfig?.comment || "",
              nestedProperties: getNestedProperties(itemInputConfig, configData),
              arrayItemProperties: getArrayItemProperties(itemInputConfig, configData),
            });
          });

          return arrayItemProperties;
        }
      }
    } else if (Array.isArray(structures) && structures.length > 0) {
      const itemTemplate = structures[0];
      const itemValue = itemTemplate.value;
      const itemInputs = itemTemplate._inputs;

      if (itemValue && itemInputs) {
        const arrayItemProperties: PropertyMeta[] = [];

        Object.entries(itemValue).forEach(([key, value]) => {
          const itemInputConfig = itemInputs[key];

          arrayItemProperties.push({
            name: key,
            type: getPropertyType(itemInputConfig),
            optional: false,
            default: formatDefaultValue(value, itemInputConfig),
            enumValues: getEnumValues(itemInputConfig),
            description: itemInputConfig?.comment || "",
            nestedProperties: getNestedProperties(itemInputConfig, configData),
            arrayItemProperties: getArrayItemProperties(itemInputConfig, configData),
          });
        });

        return arrayItemProperties;
      }
    }
  }

  return undefined;
}

type PropertyMeta = {
  name: string;
  type: string;
  optional: boolean;
  default: unknown;
  enumValues?: string[];
  description: string;
  nestedProperties?: PropertyMeta[];
  arrayItemProperties?: PropertyMeta[];
};

type InputGroup = {
  heading?: string;
  comment?: string;
  collapsed?: boolean;
  inputs?: string[];
};

type PropertyGroup = {
  heading: string;
  comment: string;
  collapsed: boolean;
  properties: PropertyMeta[];
};

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

/**
 * Mirror CloudCannon's `groups` block so page-section shell props sit in a
 * collapsed "Section settings" disclosure instead of mixing with content.
 * Building blocks have no groups and stay a flat list.
 */
function groupProperties(properties: PropertyMeta[], configData: any): PropertyGroup[] {
  const groups = configData?.groups as InputGroup[] | undefined;

  if (!Array.isArray(groups) || groups.length === 0) {
    return [{ heading: "", comment: "", collapsed: false, properties }];
  }

  const byName = new Map(properties.map((property) => [property.name, property]));
  const used = new Set<string>();
  const result: PropertyGroup[] = [];

  for (const group of groups) {
    const groupProps = (group.inputs || [])
      .map((name) => byName.get(name))
      .filter((property): property is PropertyMeta => Boolean(property));

    for (const property of groupProps) {
      used.add(property.name);
    }

    if (groupProps.length === 0) continue;

    result.push({
      heading: group.heading || "",
      comment: group.comment || "",
      collapsed: Boolean(group.collapsed),
      properties: groupProps,
    });
  }

  const leftover = properties.filter((property) => !used.has(property.name));

  if (leftover.length > 0) {
    const firstOpen = result.find((group) => !group.collapsed);

    if (firstOpen) {
      firstOpen.properties = [...leftover, ...firstOpen.properties];
    } else {
      result.unshift({ heading: "", comment: "", collapsed: false, properties: leftover });
    }
  }

  return result;
}

const properties: PropertyMeta[] = configData ? parseConfigProperties(configData) : [];
const propertyGroups: PropertyGroup[] = groupProperties(properties, configData);
---

<div class="properties">
  {
    (() => {
      function renderProperty(prop: PropertyMeta) {
        return (
          <div class="property">
            <h3>
              <span class="property-name">{prop.name}</span>{" "}
              <span class="property-type">
                {prop.type}
                {prop.default && prop.type !== "object" && ` | default: ${prop.default}`}
              </span>
            </h3>
            {prop.description && <p>{prop.description}</p>}

            {prop.enumValues && prop.enumValues.length > 0 && (
              <div class="enum-values">
                <strong>Accepted values:</strong>
                <ul>
                  {prop.enumValues.map((value: string) => (
                    <li>
                      <code>{value}</code>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {prop.nestedProperties && prop.nestedProperties.length > 0 && (
              <div class="nested-properties">
                <strong>Properties:</strong>
                <div class="nested-property-list">
                  {prop.nestedProperties.map((nestedProp: PropertyMeta) =>
                    renderProperty(nestedProp)
                  )}
                </div>
              </div>
            )}

            {prop.arrayItemProperties && prop.arrayItemProperties.length > 0 && (
              <div class="nested-properties">
                <strong>Item Properties:</strong>
                <div class="nested-property-list">
                  {prop.arrayItemProperties.map((itemProp: PropertyMeta) =>
                    renderProperty(itemProp)
                  )}
                </div>
              </div>
            )}
          </div>
        );
      }

      if (propertyGroups.length === 0 || properties.length === 0) {
        return (
          <p>
            No properties available. Make sure the component has a valid
            .cloudcannon.structure-value.yml file.
          </p>
        );
      }

      return propertyGroups.map((group) => {
        const list = group.properties.map((prop) => renderProperty(prop));
        const showHeading = Boolean(group.heading) && group.heading !== "Content";

        if (group.collapsed) {
          return (
            <details
              class="property-group"
              id={group.heading ? slugify(group.heading) : undefined}
            >
              <summary>
                <span class="property-group-text">
                  <span class="property-group-heading">{group.heading || "More settings"}</span>
                  {group.comment && <span class="property-group-comment">{group.comment}</span>}
                </span>
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m19.5 8.25-7.5 7.5-7.5-7.5"
                  />
                </svg>
              </summary>
              <div class="property-group-body">{list}</div>
            </details>
          );
        }

        return (
          <div class="property-group-open">
            {showHeading && <h3 class="property-group-title">{group.heading}</h3>}
            {list}
          </div>
        );
      });
    })()
  }
</div>

<style is:global>
  .properties {
    .property-group {
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      margin-top: var(--spacing-lg);
      overflow: hidden;

      > summary {
        align-items: center;
        cursor: pointer;
        display: flex;
        gap: var(--spacing-md);
        justify-content: space-between;
        list-style: none;
        padding: var(--spacing-md);
        user-select: none;

        &:hover {
          background-color: var(--color-bg-surface);
        }

        &::-webkit-details-marker {
          display: none;
        }

        svg {
          flex-shrink: 0;
          height: 14px;
          transition: transform var(--animation-fast) var(--ease-in-out);
          width: 14px;
        }
      }

      &[open] > summary {
        border-bottom: 1px solid var(--color-border-subtle);

        svg {
          transform: rotate(180deg);
        }
      }

      .property-group-text {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
        min-width: 0;
      }

      .property-group-heading {
        font-size: var(--font-size-md);
        font-weight: var(--font-weight-semibold);
      }

      .property-group-comment {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
      }

      .property-group-body {
        padding-inline: var(--spacing-md);
        padding-bottom: var(--spacing-md);

        > .property:first-child {
          border-top: none;
        }
      }
    }

    .property-group-title {
      font-size: var(--font-size-md);
      font-weight: var(--font-weight-semibold);
      margin-block: var(--spacing-lg) 0;
    }

    .property {
      border-top: 1px solid var(--color-border-subtle);
      padding-block: var(--spacing-md);

      /* Flex rather than relying on whitespace between the two spans: the
         compiler strips whitespace-only nodes between adjacent elements, so a
         source newline is not a space. */
      h3 {
        align-items: baseline;
        display: flex;
        flex-wrap: wrap;
        font-family: var(--font-mono);
        font-size: var(--font-size-md);
        gap: var(--spacing-em-sm);

        .property-name {
          font-weight: var(--font-weight-bold);
        }

        .property-type {
          font-family: var(--font-headings);
          font-size: var(--font-size-sm);
          font-weight: var(--font-weight-normal);
        }
      }

      .enum-values {
        strong {
          color: var(--color-text-muted);
          display: block;
          font-size: var(--font-size-sm);
          letter-spacing: 0.05em;
          text-transform: uppercase;
        }

        ul {
          display: flex;
          flex-wrap: wrap;
          gap: var(--spacing-sm);
          list-style: none;
          margin: 0;
          padding: 0;
        }

        li {
          code {
            background: var(--color-bg-surface);
            border-radius: var(--radius-xs);
            font-size: var(--font-size-sm);
            padding: var(--spacing-em-xs) var(--spacing-em-sm);
          }
        }
      }
    }
  }

  .nested-property-list {
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    margin-top: var(--spacing-md);
    padding-inline: var(--spacing-md);

    .property:first-child {
      border-top: none;
    }
  }
</style>
