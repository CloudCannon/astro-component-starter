---
import ComponentProperties from "@component-docs/components/ComponentProperties/index.astro";
import ComponentSlots from "@component-docs/components/ComponentSlots/index.astro";
import ComponentViewer from "@component-docs/components/ComponentViewer/index.astro";
import LibraryLayout from "@component-docs/layouts/LibraryLayout.astro";
import { formatDisplayName } from "@component-docs/shared/componentIndex";
import MarkdownIt from "markdown-it";
import { existsSync } from "node:fs";
import { join } from "node:path";

const { frontmatter, configData, examples = [], componentKey = "", slotDocs = [] } = Astro.props;

// Docs entries are optional enrichment: a component with no hand-written docs
// entry still gets a full page, falling back to the structure-value label and
// a formatted version of its own key.
const lastKeySegment = componentKey.split("/").pop() || componentKey;
const title = frontmatter.title || configData?.label || formatDisplayName(lastKeySegment);
const description = frontmatter.description || configData?.description || "";

const meta = {
  description: description || "No description available",
  title,
};

// LibraryLayout only sees frontmatter, so give it the resolved title/description
// too — otherwise a docs-less page would fall back to "Component Library".
const layoutFrontmatter = { ...frontmatter, title, description };

// Preview thumbnails are generated to public/component-previews/<componentKey>.svg
// (see scripts/previews/). They build as static assets, so we can check the file
// on disk in the frontmatter and only render the <img> when it actually exists —
// avoiding a broken image for components without a generated preview.
const previewSrc = componentKey ? `/component-previews/${componentKey}.svg` : "";
const hasPreview =
  !!componentKey &&
  existsSync(join(process.cwd(), "public", "component-previews", `${componentKey}.svg`));

const md = MarkdownIt({ html: true });
const overviewHtml = frontmatter.overview ? md.render(frontmatter.overview) : null;
const defaultExampleSize = frontmatter.defaultSize || "md";

let primaryExample = examples.find(
  (example: any) => example && example.id && example.id.includes("/primary")
);

// No hand-authored primary example on disk: synthesize one from the
// structure-value default `value` so a docs-less component still gets a
// working preview. Shape-compatible with what ComponentViewer reads
// (example.id, example.data.title/blocks/spacing).
if (!primaryExample && configData?.value) {
  primaryExample = {
    id: `components/${componentKey}/examples/primary`,
    data: {
      title: `Primary ${title}`,
      spacing: frontmatter.spacing ?? "all",
      blocks: configData.value,
    },
  } as any;
}

const frontmatterExamples = frontmatter.examples || [];

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

let processedExamples: {
  title: string;
  id: string;
  examples: any[];
  size: string;
}[];

if (frontmatterExamples.length > 0) {
  processedExamples = frontmatterExamples.map((exampleConfig: any) => {
    const matchingExamples = examples.filter((example: any) =>
      exampleConfig.slugs.some(
        (slug: string) => example && example.id && example.id.endsWith(`/${slug}`)
      )
    );

    const sortedExamples = matchingExamples.sort((a: any, b: any) => {
      const aSlug = a.id.split("/").pop();
      const bSlug = b.id.split("/").pop();
      const aIndex = exampleConfig.slugs.indexOf(aSlug);
      const bIndex = exampleConfig.slugs.indexOf(bSlug);

      return aIndex - bIndex;
    });

    return {
      title: exampleConfig.title,
      id: slugify(exampleConfig.title),
      examples: sortedExamples,
      size: exampleConfig.size || defaultExampleSize,
    };
  });
} else {
  // No frontmatter-driven example groups (either no docs entry at all, or a
  // docs entry that doesn't curate its examples). Fall back to one group per
  // non-primary example found on disk, alphabetical by slug, so the examples
  // still show up somewhere.
  const nonPrimaryExamples = examples.filter(
    (example: any) => !(example && example.id && example.id.includes("/primary"))
  );

  const sortedBySlug = [...nonPrimaryExamples].sort((a: any, b: any) => {
    const aSlug = (a.id.split("/").pop() as string) || "";
    const bSlug = (b.id.split("/").pop() as string) || "";

    return aSlug.localeCompare(bSlug);
  });

  processedExamples = sortedBySlug.map((example: any) => {
    const exampleSlug = (example.id.split("/").pop() as string) || "";
    const exampleTitle = example.data?.title || formatDisplayName(exampleSlug);

    return {
      title: exampleTitle,
      id: slugify(exampleTitle),
      examples: [example],
      size: defaultExampleSize,
    };
  });
}
---

<LibraryLayout frontmatter={layoutFrontmatter}>
  <div class="component-hero">
    <div class="component-hero-text">
      <h1>{title}</h1>
      <p>{meta.description}</p>
    </div>

    {
      hasPreview && (
        <img
          class="component-preview-thumb"
          src={previewSrc}
          alt={`${meta.title || componentKey} preview`}
          loading="lazy"
          decoding="async"
          width="640"
          height="400"
        />
      )
    }
  </div>

  {
    primaryExample && (
      <ComponentViewer
        component_examples={[primaryExample]}
        title={meta.title}
        size={defaultExampleSize}
        componentKey={componentKey}
      />
    )
  }

  {
    overviewHtml && (
      <>
        <h2 id="overview">
          Overview{" "}
          <a
            href="#overview"
            class="heading-anchor"
            aria-label="Link to Overview"
          >
            #
          </a>
        </h2>
        <div set:html={overviewHtml} />
      </>
    )
  }

  <h2 id="properties">
    Properties <a
      href="#properties"
      class="heading-anchor"
      aria-label="Link to Properties"
      >#</a
    >
  </h2>
  <ComponentProperties configData={configData} />

  {
    slotDocs.length > 0 && (
      <>
        <h2 id="slots">
          Slots{" "}
          <a
            href="#slots"
            class="heading-anchor"
            aria-label="Link to Slots"
          >
            #
          </a>
        </h2>
        <ComponentSlots slotData={slotDocs} />
      </>
    )
  }
  {
    processedExamples.length > 0 && (
      <h2 id="examples">
        Examples{" "}
        <a
          href="#examples"
          class="heading-anchor"
          aria-label="Link to Examples"
        >
          #
        </a>
      </h2>
    )
  }

  {
    processedExamples.map((exampleGroup: any) => (
      <>
        <h3 id={exampleGroup.id}>
          {exampleGroup.title}{" "}
          <a
            href={`#${exampleGroup.id}`}
            class="heading-anchor"
            aria-label={`Link to ${exampleGroup.title}`}
          >
            #
          </a>
        </h3>
        {exampleGroup.examples.length > 0 && (
          <ComponentViewer
            component_examples={exampleGroup.examples}
            title={exampleGroup.title}
            size={exampleGroup.size}
            componentKey={componentKey}
          />
        )}
      </>
    ))
  }

  <slot />
</LibraryLayout>

<style>
  /* Title/description on the left, preview thumbnail on the right. The preview
     is a picker-scale mockup, so it is sized as a thumbnail rather than stretched
     to the content width. Below 640px the thumbnail wraps under the text. */
  .component-hero {
    align-items: start;
    display: flex;
    flex-wrap: wrap;
    /* Row gap only applies once the thumbnail wraps under the text, so no media
       query is needed to keep it clear of the description. */
    gap: var(--spacing-lg) var(--spacing-xl);
    justify-content: space-between;
    /* The h1's own top margin is moved here so the thumbnail aligns with the
       title rather than floating above it. */
    margin-block: var(--spacing-2xl) var(--spacing-lg);
  }

  .component-hero-text {
    flex: 1 1 18rem;
    min-width: 0;

    > :first-child {
      margin-block-start: 0;
    }

    > :last-child {
      margin-block-end: 0;
    }
  }

  .component-preview-thumb {
    aspect-ratio: 16 / 10;
    background-color: var(--color-bg-surface);
    /* Matches the ComponentViewer frame below it (ComponentViewer/styles.css). */
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    display: block;
    flex: 0 0 auto;
    height: auto;
    max-width: 100%;
    object-fit: cover;
    width: 15rem;
  }
</style>
