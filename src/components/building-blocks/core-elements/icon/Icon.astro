---
import { Icon as AstroIcon } from "astro-icon/components";
import { isNonEmptyString } from "@component-utils/isNonEmptyString";

const {
  name,
  size = "lg",
  color = "default",
  background = false,
  alignmentHorizontal = "",
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const isValidName = isNonEmptyString(name);

if (!_component && !isValidName) {
  return;
}

// Social icons ship solid single-color artwork, so they are recolored to the
// current text color. Every other icon keeps the colors it was drawn with.
const matchTextColor = Boolean(name?.includes("social/"));
---

<span
  class:list={["icon", className]}
  {...htmlAttributes}
>
  <span
    class:list={[
      "icon-inner",
      `size-${size}`,
      `color-${color}`,
      background && "background",
      alignmentHorizontal && alignmentHorizontal !== "none" && `align-${alignmentHorizontal}`,
      matchTextColor && "fill",
    ]}
  >
    <AstroIcon
      name={String(name).trim()}
      is:inline
    />
  </span>
</span>

<style is:global>
  @layer components {
    .icon {
      display: block;
      line-height: var(--line-height-none);
      vertical-align: middle;

      > .icon-inner {
        border-radius: var(--radius-xs);
        color: var(--icon-accent, inherit);
        display: block;
        line-height: var(--line-height-none);
        vertical-align: middle;

        &.flip-rtl {
          transform: scaleX(-1);
        }

        &.background-subtle {
          padding: 0.15em;
        }

        &.fill {
          fill: currentcolor;
        }

        &.background {
          background-color: var(--icon-accent-bg, var(--color-bg-surface));
          padding: var(--spacing-em-xs);
          width: fit-content;
        }

        /* Each accent sets only the two ramp steps it uses; the rules above
           consume them. `color-default` sets neither and falls back. Yellow
           uses 400 rather than 500 — 500 is too dark against a pale tint. */
        &.color-blue {
          --icon-accent: var(--blue-500);
          --icon-accent-bg: var(--blue-100);
        }

        &.color-green {
          --icon-accent: var(--green-500);
          --icon-accent-bg: var(--green-100);
        }

        &.color-yellow {
          --icon-accent: var(--yellow-400);
          --icon-accent-bg: var(--yellow-100);
        }

        &.color-orange {
          --icon-accent: var(--orange-500);
          --icon-accent-bg: var(--orange-100);
        }

        &.color-red {
          --icon-accent: var(--red-500);
          --icon-accent-bg: var(--red-100);
        }

        &.color-purple {
          --icon-accent: var(--purple-500);
          --icon-accent-bg: var(--purple-100);
        }

        &.color-pink {
          --icon-accent: var(--pink-500);
          --icon-accent-bg: var(--pink-100);
        }

        &.color-cyan {
          --icon-accent: var(--cyan-500);
          --icon-accent-bg: var(--cyan-100);
        }

        &.size-sm {
          font-size: var(--font-size-sm);
        }

        &.size-md {
          font-size: var(--font-size-xl);
        }

        &.size-lg {
          font-size: var(--font-size-2xl);
        }

        &.size-xl {
          font-size: var(--font-size-3xl);
        }

        &.size-2xl {
          font-size: var(--font-size-4xl);
        }

        &.size-3xl {
          font-size: var(--font-size-5xl);
        }

        &.align-start {
          display: block;
          width: fit-content;
        }

        &.align-center {
          display: block;
          margin-inline: auto;
          width: fit-content;
        }

        &.align-end {
          display: block;
          margin-inline-start: auto;
          width: fit-content;
        }

        svg {
          max-height: 100%;
        }
      }
    }
  }
</style>
