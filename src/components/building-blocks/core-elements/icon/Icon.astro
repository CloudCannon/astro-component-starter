---
import { getIcon, suggestIconNames } from "@component-utils/icons";
import { isNonEmptyString } from "@component-utils/isNonEmptyString";

const {
  name,
  size = "lg",
  color = "default",
  background = false,
  alignmentHorizontal = "",
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const isValidName = isNonEmptyString(name);
const icon = isValidName ? getIcon(String(name)) : null;

// Ids come from editable content, so warn while authoring rather than failing
// the build — same as renderBlock.astro does for an unknown `_component`.
if (isValidName && !icon && import.meta.env.DEV) {
  const suggestions = suggestIconNames(String(name));
  const hint = suggestions.length ? ` Did you mean: ${suggestions.join(", ")}?` : "";

  console.warn(`[icon] Unknown icon "${String(name).trim()}".${hint}`);
}

if (!icon) {
  return;
}
---

<span
  class:list={["icon", className]}
  {...htmlAttributes}
>
  <span
    class:list={[
      "icon-inner",
      `size-${size}`,
      `color-${color}`,
      background && "background",
      alignmentHorizontal && alignmentHorizontal !== "none" && `align-${alignmentHorizontal}`,
    ]}
  >
    <svg
      {...icon.attributes}
      set:html={icon.body}
    />
  </span>
</span>

<style is:global>
  @layer components {
    .icon {
      display: block;
      line-height: var(--line-height-none);
      vertical-align: middle;

      > .icon-inner {
        border-radius: var(--radius-xs);
        color: var(--icon-accent, inherit);
        display: block;
        line-height: var(--line-height-none);
        vertical-align: middle;

        &.flip-rtl {
          transform: scaleX(-1);
        }

        &.background-subtle {
          padding: 0.15em;
        }

        &.background {
          background-color: var(--icon-accent-bg, var(--color-bg-surface));
          padding: var(--spacing-em-xs);
          width: fit-content;
        }

        &.color-blue {
          --icon-accent: var(--blue-500);
          --icon-accent-bg: var(--blue-100);
        }

        &.color-green {
          --icon-accent: var(--green-500);
          --icon-accent-bg: var(--green-100);
        }

        &.color-yellow {
          --icon-accent: var(--yellow-400);
          --icon-accent-bg: var(--yellow-100);
        }

        &.color-orange {
          --icon-accent: var(--orange-500);
          --icon-accent-bg: var(--orange-100);
        }

        &.color-red {
          --icon-accent: var(--red-500);
          --icon-accent-bg: var(--red-100);
        }

        &.color-purple {
          --icon-accent: var(--purple-500);
          --icon-accent-bg: var(--purple-100);
        }

        &.color-pink {
          --icon-accent: var(--pink-500);
          --icon-accent-bg: var(--pink-100);
        }

        &.color-cyan {
          --icon-accent: var(--cyan-500);
          --icon-accent-bg: var(--cyan-100);
        }

        &.size-sm {
          font-size: var(--font-size-sm);
        }

        &.size-md {
          font-size: var(--font-size-xl);
        }

        &.size-lg {
          font-size: var(--font-size-2xl);
        }

        &.size-xl {
          font-size: var(--font-size-3xl);
        }

        &.size-2xl {
          font-size: var(--font-size-4xl);
        }

        &.size-3xl {
          font-size: var(--font-size-5xl);
        }

        &.align-start {
          display: block;
          width: fit-content;
        }

        &.align-center {
          display: block;
          margin-inline: auto;
          width: fit-content;
        }

        &.align-end {
          display: block;
          margin-inline-start: auto;
          width: fit-content;
        }

        svg {
          max-height: 100%;
        }
      }
    }
  }
</style>
