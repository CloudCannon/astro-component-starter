---
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import ListItem from "./ListItem.astro";

type ItemProps = Record<string, unknown>;

const {
  items = [],
  direction = "vertical",
  alignmentHorizontal = "start",
  size = "md",
  listType = "icon",
  spaceBefore = "default",
  class: className,
  "data-children-prop": childrenDataProp,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const hasItems = items?.length > 0;
const hasSlotContent = Astro.slots.has("default");

const ListTag = listType === "numbered" ? "ol" : "ul";
const showIcons = listType === "icon";

if (!_component && !hasItems && !hasSlotContent) return;

const effectiveChildrenProp = childrenDataProp ?? (useDefaultEditableBinding ? "items" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};
const itemRegionAttributes = effectiveChildrenProp
  ? { "data-id": "building-blocks/core-elements/list/list-item", "data-editable": "array-item" }
  : {};
---

<div
  class:list={["list", "stackable", className]}
  {...htmlAttributes}
>
  <div
    class:list={[
      "list-inner",
      `size-${size}`,
      `direction-${direction}`,
      `alignment-${alignmentHorizontal}`,
      `type-${listType}`,
    ]}
    data-space-before={spaceBeforeAttr(spaceBefore)}
  >
    <ListTag
      role="list"
      {...arrayDataAttributes}
    >
      <slot>
        {items?.map((item: ItemProps) => (
          <ListItem
            {...itemRegionAttributes}
            useDefaultEditableBinding={!!effectiveChildrenProp}
            showIcon={showIcons}
            {...item}
          />
        ))}
      </slot>
    </ListTag>
  </div>
</div>

<style is:global>
  @layer components {
    .list > .list-inner {
      /* `inherit` takes the size class on `.list-inner`; the base `ul, ol` rule would override it. */
      > :where(ul, ol) {
        display: flex;
        flex-direction: column;
        font-size: inherit;
        gap: var(--spacing-em-sm);
        margin: 0;

        padding-inline-start: var(--spacing-md);
      }

      &.direction-horizontal > :where(ul, ol) {
        flex-flow: row wrap;
        gap: var(--spacing-em-md);
      }

      &.type-bullet > :where(ul, ol) {
        list-style: disc;
      }

      &.type-numbered > :where(ul, ol) {
        list-style: decimal;
      }

      &.type-bullet.direction-horizontal > :where(ul, ol),
      &.type-numbered.direction-horizontal > :where(ul, ol) {
        gap: var(--spacing-em-2xl);
      }

      &.type-icon > :where(ul, ol) {
        list-style: none;
        padding: 0;
      }

      &.alignment-end > :where(ul, ol) {
        align-items: flex-end;
        justify-content: flex-end;
      }

      &.alignment-center > :where(ul, ol) {
        align-items: center;
        justify-content: center;
      }

      &.size-xs {
        font-size: var(--font-size-xs);
      }

      &.size-sm {
        font-size: var(--font-size-sm);
      }

      &.size-md {
        font-size: var(--font-size-md);
      }

      &.size-lg {
        font-size: var(--font-size-lg);
      }

      &.size-xl {
        font-size: var(--font-size-xl);
      }

      &.size-2xl {
        font-size: var(--font-size-2xl);
      }

      &.size-3xl {
        font-size: var(--font-size-3xl);
      }

      &.size-4xl {
        font-size: var(--font-size-4xl);
      }
    }
  }
</style>
