---
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import Icon from "@core-elements/icon/Icon.astro";

const {
  page,
  // No stable child to carry data-space-before, so it rides the root: live
  // edits to spaceBefore need a reload (see _flow.css).
  spaceBefore = "default",
  class: className,
  showArrows = false,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
const maxVisiblePages = 5;

if (!page || page.lastPage <= 1) {
  return null;
}

const currentPage = page.currentPage;
const totalPages = page.lastPage;
const lastPage = totalPages - 1;

const maxVisible = maxVisiblePages - 1;
let startPage = Math.max(0, currentPage - 2);
let endPage = Math.min(lastPage, startPage + maxVisible);

if (endPage === lastPage && startPage > 0) {
  startPage = Math.max(0, lastPage - maxVisible);
}

const showFirst = startPage > 0;
const showLast = endPage < lastPage;
const visibleRange = endPage - startPage + 1;
const totalVisible = visibleRange + (showFirst ? 1 : 0) + (showLast ? 1 : 0);

if (totalVisible > maxVisiblePages) {
  const excess = totalVisible - maxVisiblePages;

  if (showFirst || showLast) {
    endPage = Math.max(startPage, endPage - excess);
  }
}

const getPageUrl = (pageNum: number) => {
  if (pageNum === 1) {
    return page.url.first || page.url.current?.replace(/\/\d+\/?$/, "") || "/blog";
  }

  if (page.url && page.url.first) {
    const baseUrl = page.url.first.replace(/\/$/, "");

    return `${baseUrl}/${pageNum}`;
  }

  if (page.url && page.url.current) {
    const baseUrl = page.url.current.replace(/\/\d+\/?$/, "").replace(/\/$/, "");

    return `${baseUrl}/${pageNum}`;
  }

  return pageNum === 1 ? "/blog" : `/blog/${pageNum}`;
};
---

<nav
  class:list={["pagination", "stackable", className]}
  data-space-before={spaceBeforeAttr(spaceBefore)}
  aria-label="Pagination Navigation"
  {...htmlAttributes}
>
  {
    showArrows && currentPage > 1 && (
      <a
        href={getPageUrl(currentPage - 1)}
        class="pagination-arrow pagination-prev"
        aria-label="Go to previous page"
      >
        <Icon
          name="chevron-left"
          size="sm"
        />
      </a>
    )
  }

  {startPage > 0 && <a href={getPageUrl(1)}>1</a>}

  {startPage > 1 && <span aria-hidden="true">…</span>}

  {
    Array.from({ length: endPage - startPage + 1 }, (_, i) => {
      const pageNum = startPage + i + 1;

      // A bare `<span>` exposes no role that can carry an `aria-label`, so the
      // context is given as visually hidden text instead.
      return pageNum === currentPage ? (
        <span
          class="current"
          aria-current="page"
        >
          <span class="visually-hidden">Page </span>
          {pageNum}
        </span>
      ) : (
        <a
          href={getPageUrl(pageNum)}
          aria-label={`Go to page ${pageNum}`}
        >
          {pageNum}
        </a>
      );
    })
  }

  {
    endPage < lastPage && (
      <>
        <span aria-hidden="true">…</span>
        <a href={getPageUrl(totalPages)}>{totalPages}</a>
      </>
    )
  }

  {
    showArrows && currentPage < totalPages && (
      <a
        href={getPageUrl(currentPage + 1)}
        class="pagination-arrow pagination-next"
        aria-label="Go to next page"
      >
        <Icon
          name="chevron-right"
          size="sm"
        />
      </a>
    )
  }
</nav>

<style is:global>
  @layer components {
    .pagination {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;

      > a,
      > span {
        background-color: var(--color-bg);
        border: 1px solid var(--color-border);
        border-inline-start: none;
        color: var(--color-text-strong);
        font-weight: var(--font-weight-semibold);
        padding: var(--spacing-sm) var(--spacing-md);
        text-decoration: none;
        transition: background-color var(--animation-normal) var(--ease-in-out);

        &:hover {
          background-color: var(--color-state-hover);
          color: var(--color-text-strong);
        }

        &:first-child {
          border-bottom-left-radius: var(--radius-sm);
          border-inline-start: 1px solid var(--color-border);
          border-top-left-radius: var(--radius-sm);
        }

        &:last-child {
          border-bottom-right-radius: var(--radius-sm);
          border-top-right-radius: var(--radius-sm);
        }

        &[aria-hidden="true"] {
          cursor: default;

          &:hover {
            background-color: var(--color-bg);
            color: var(--color-text-strong);
          }
        }
      }

      .current,
      .current:hover {
        background-color: var(--color-bg-brand);
        border-color: var(--color-bg-brand);
        color: var(--color-text-on-brand);
        cursor: default;
      }

      .pagination-arrow {
        align-items: center;
        display: inline-flex;
        justify-content: center;

        .icon {
          align-items: center;
          display: flex;
          justify-content: center;
        }
      }
    }
  }
</style>
