---
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import Avatar from "@components/utils/Avatar.astro";
import { renderMarkdown } from "@component-utils/markdown";
const {
  text,
  authorName,
  authorDescription,
  alignmentHorizontal = "center",
  authorImage = "",
  spaceBefore = "default",
  class: className,
  useDefaultEditableBinding = false,
  "data-prop": customDataProp,
  "data-prop-author-name": customDataPropAuthorName,
  "data-prop-author-description": customDataPropAuthorDescription,
  _component,
  ...htmlAttributes
} = Astro.props;

const MarkdownText = renderMarkdown(text);

const effectiveDataProp = customDataProp ?? (useDefaultEditableBinding ? "text" : null);
const textDataAttributes = effectiveDataProp
  ? { "data-editable": "text", "data-prop": effectiveDataProp }
  : {};

const effectiveAuthorNameProp =
  customDataPropAuthorName ?? (useDefaultEditableBinding ? "authorName" : null);
const authorNameDataAttributes = effectiveAuthorNameProp
  ? { "data-editable": "text", "data-prop": effectiveAuthorNameProp }
  : {};

const effectiveAuthorDescProp =
  customDataPropAuthorDescription ?? (useDefaultEditableBinding ? "authorDescription" : null);
const authorDescriptionDataAttributes = effectiveAuthorDescProp
  ? { "data-editable": "text", "data-prop": effectiveAuthorDescProp }
  : {};
---

<blockquote
  class:list={["testimonial", "stackable", className]}
  {...htmlAttributes}
>
  <div
    class:list={["testimonial-inner", `alignment-${alignmentHorizontal}`]}
    data-space-before={spaceBeforeAttr(spaceBefore)}
  >
    <div
      class="quote"
      {...textDataAttributes}
    >
      <slot>
        {text && <Fragment set:html={MarkdownText} />}
      </slot>
    </div>
    <div class="author">
      {
        authorImage && (
          <Avatar
            image={authorImage}
            alt={authorName}
            border={false}
            class="author-image"
            displaySize={80}
            data-prop-src="authorImage"
            data-prop-alt="authorName"
          />
        )
      }
      <cite class="author-content">
        <strong
          class="name"
          {...authorNameDataAttributes}
        >
          {authorName}
        </strong>
        {
          authorDescription && (
            <>
              <br />
              <span
                class="description"
                {...authorDescriptionDataAttributes}
              >
                {authorDescription}
              </span>
            </>
          )
        }
      </cite>
    </div>
  </div>
</blockquote>

<style is:global>
  @layer components {
    .testimonial {
      border-inline-start: 0;
      margin: 0;
      padding-inline-start: 0;

      > .testimonial-inner {
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-em-sm);
        padding: var(--spacing-lg);

        &.alignment-center {
          align-items: center;
          justify-content: center;
          text-align: center;
        }

        > .quote {
          margin: 0;

          * {
            font-size: var(--font-size-2xl);
          }

          *:first-child {
            margin-top: 0;
          }

          *:last-child {
            margin-bottom: 0;
          }

          *:first-child::before {
            content: "\201C";
          }

          *:last-child::after {
            content: "\201D";
          }
        }

        > .author {
          align-items: center;
          display: flex;
          gap: var(--spacing-md);
          margin-top: var(--spacing-md);

          > .author-image {
            --avatar-size: 80px;
          }

          > .author-content {
            font-style: normal;
            text-align: start;
          }
        }
      }
    }
  }
</style>
