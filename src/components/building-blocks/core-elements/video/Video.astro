---
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import { resolveVideoPosterSource } from "@component-utils/image";
import type { VideoSource } from "@component-utils/discoverVideoSources";

const {
  type,
  videoId,
  // Interpolated into `videotitle`/`title` attributes, so an undefined value
  // would render the literal string "undefined" as the frame's accessible name.
  title = "",
  source,
  thumbnail,
  captions = "",
  captionsLanguage = "en",
  background = false,
  // Background videos are decorative, so they default to an autoplaying
  // loop; passing autoplay/loop explicitly still wins.
  autoplay = background,
  loop = background,
  // The media elements are the roots, so data-space-before rides them: live
  // edits to spaceBefore need a reload (see _flow.css).
  spaceBefore = "default",
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const VIDEO_TYPES = ["youtube", "vimeo", "local-source"];
const isHosted = type === "youtube" || type === "vimeo";

if (import.meta.env.DEV) {
  if (!VIDEO_TYPES.includes(type)) {
    console.warn(`[video] Unknown type "${type}". Expected one of: ${VIDEO_TYPES.join(", ")}.`);
  } else if (isHosted && !title) {
    console.warn(
      `[video] ${type} video "${videoId}" has no title, so the player frame has no accessible name.`
    );
  }
}

// An unknown type used to fall through to a <video> with no sources: a black
// box with controls that can never play.
if (!_component && !VIDEO_TYPES.includes(type)) return;

const captionsSrc = typeof captions === "string" ? captions.trim() : "";
const captionsLabel = (() => {
  if (!captionsSrc) return undefined;

  try {
    return (
      new Intl.DisplayNames(["en"], { type: "language" }).of(captionsLanguage) ?? captionsLanguage
    );
  } catch {
    return captionsLanguage;
  }
})();

const trimmedThumbnail =
  typeof thumbnail === "string" && thumbnail.trim() !== "" ? thumbnail.trim() : "";

const posterUrl = trimmedThumbnail ? await resolveVideoPosterSource(trimmedThumbnail) : undefined;

let localVideoSources: VideoSource[] = [];

if (type === "local-source" && source) {
  const { discoverVideoSources } = await import("@component-utils/discoverVideoSources");

  localVideoSources = await discoverVideoSources(source);
}
---

{
  isHosted ? (
    <div
      class:list={["video", "stackable", "hosted-video", className]}
      {...htmlAttributes}
    >
      <div
        class="hosted-video-content"
        data-space-before={spaceBeforeAttr(spaceBefore)}
        data-hosted-video
        data-video-type={type}
        data-video-id={videoId}
        data-video-title={title}
        data-video-autoplay={autoplay}
        data-video-loop={loop}
      >
        <p>Allow external media across this site to play this video.</p>
        <button
          type="button"
          data-external-media-enable
        >
          Allow all external media
        </button>
        <a
          href={
            type === "youtube"
              ? `https://www.youtube.com/watch?v=${videoId}`
              : `https://vimeo.com/${videoId}`
          }
        >
          Watch on {type === "youtube" ? "YouTube" : "Vimeo"}: "{title}"
        </a>
      </div>
    </div>
  ) : background ? (
    <div
      class:list={["video", "background", className]}
      aria-hidden="true"
      {...htmlAttributes}
    >
      <video
        preload="metadata"
        autoplay={autoplay}
        muted
        loop={loop}
        playsinline
        poster={posterUrl}
      >
        {localVideoSources.map(({ src, type: sourceType }) => (
          <source
            src={src}
            type={sourceType}
          />
        ))}
      </video>
    </div>
  ) : (
    <video
      preload={autoplay ? "auto" : "none"}
      controls
      autoplay={autoplay}
      muted={autoplay}
      playsinline={autoplay}
      loop={loop}
      poster={posterUrl}
      class:list={["video", "stackable", className]}
      data-space-before={spaceBeforeAttr(spaceBefore)}
      {...htmlAttributes}
    >
      {localVideoSources.map(({ src, type: sourceType }) => (
        <source
          src={src}
          type={sourceType}
        />
      ))}
      {captionsSrc && (
        <track
          kind="captions"
          src={captionsSrc}
          srclang={captionsLanguage}
          label={captionsLabel}
          default
        />
      )}
      Your browser does not support the HTML5 video element.
    </video>
  )
}

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllVideos } from "./setup";

  onPageLoad(setupAllVideos);
</script>

<style is:global>
  @layer components {
    .video {
      display: block;

      &.video-embed {
        aspect-ratio: 16 / 9;
        border: 0;
        height: auto;
        width: 100%;
      }

      &.hosted-video {
        > .hosted-video-content {
          align-items: center;
          aspect-ratio: var(--ratio-widescreen);
          background-color: var(--color-bg-surface);
          display: flex;
          flex-direction: column;
          gap: var(--spacing-sm);
          justify-content: center;
          padding: var(--spacing-md);
          text-align: center;

          p {
            color: var(--color-text-muted);
            margin: 0;
          }

          button {
            background-color: var(--color-bg-brand);
            border: var(--border-width-sm) solid var(--color-bg-brand);
            border-radius: var(--radius-xs);
            color: var(--color-brand-on);
            cursor: pointer;
            font: inherit;
            font-weight: var(--font-weight-semibold);
            padding: var(--spacing-em-sm);
          }

          iframe {
            border: 0;
            height: 100%;
            width: 100%;
          }

          &[data-hosted-video-mounted] {
            display: block;
            padding: 0;
          }
        }
      }

      &.background {
        inset: 0;
        margin-top: 0;
        overflow: hidden;
        pointer-events: none;
        position: absolute;

        > video {
          height: 100%;
          object-fit: cover;
          object-position: var(--background-position, center center);
          width: 100%;
        }
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .video.background {
        display: none;
      }
    }
  }
</style>
