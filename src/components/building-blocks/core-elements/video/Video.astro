---
import { resolveVideoPosterSource } from "@component-utils/image";
import type { VideoSource } from "@component-utils/discoverVideoSources";

const {
  type,
  videoId,
  title,
  source,
  thumbnail,
  background = false,
  // Background videos are decorative, so they default to an autoplaying
  // loop; passing autoplay/loop explicitly still wins.
  autoplay = background,
  loop = background,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const trimmedThumbnail =
  typeof thumbnail === "string" && thumbnail.trim() !== "" ? thumbnail.trim() : "";

const posterUrl = trimmedThumbnail ? await resolveVideoPosterSource(trimmedThumbnail) : undefined;

let localVideoSources: VideoSource[] = [];

if (type === "local-source" && source) {
  const { discoverVideoSources } = await import("@component-utils/discoverVideoSources");

  localVideoSources = await discoverVideoSources(source);
}

// YouTube requires loop=1 to be paired with playlist=<videoId>. Autoplaying
// YouTube renders a plain lazy iframe instead of the lite-youtube facade: the
// facade's autoload path pins autoplay=0 in the embed URL and YouTube honours
// the first occurrence of a duplicated param, so autoplay can never win.
const youtubeParams =
  [
    ...(autoplay ? ["autoplay=1", "mute=1", "playsinline=1"] : []),
    ...(loop ? ["loop=1", `playlist=${videoId}`] : []),
  ].join("&") || undefined;
---

{
  type === "vimeo" ? (
    <lite-vimeo
      class:list={["video", className]}
      videotitle={`${title}`}
      videoid={`${videoId}`}
      autoload={autoplay}
      autoplay={autoplay}
      loop={loop}
      {...htmlAttributes}
    >
      <a
        class="lite-vimeo-fallback"
        href={`https://vimeo.com/${videoId}`}
      >
        Watch on Vimeo: "{title}"
      </a>
    </lite-vimeo>
  ) : type === "youtube" && autoplay ? (
    <iframe
      class:list={["video", "video-embed", className]}
      src={`https://www.youtube.com/embed/${videoId}?${youtubeParams}`}
      title={`${title}`}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      {...htmlAttributes}
    />
  ) : type === "youtube" ? (
    <lite-youtube
      class:list={["video", className]}
      videotitle={`${title}`}
      videoid={`${videoId}`}
      params={youtubeParams}
      {...htmlAttributes}
    >
      <a
        class="lite-youtube-fallback"
        href={`https://www.youtube.com/watch?v=${videoId}`}
      >
        Watch on YouTube: "{title}"
      </a>
    </lite-youtube>
  ) : background ? (
    <div
      class:list={["video", "background", className]}
      aria-hidden="true"
      {...htmlAttributes}
    >
      <video
        preload="metadata"
        autoplay={autoplay}
        muted
        loop={loop}
        playsinline
        poster={posterUrl}
      >
        {localVideoSources.map(({ src, type: sourceType }) => (
          <source
            src={src}
            type={sourceType}
          />
        ))}
      </video>
    </div>
  ) : (
    <video
      preload={autoplay ? "auto" : "none"}
      controls
      autoplay={autoplay}
      muted={autoplay}
      playsinline={autoplay}
      loop={loop}
      poster={posterUrl}
      class:list={["video", className]}
      {...htmlAttributes}
    >
      {localVideoSources.map(({ src, type: sourceType }) => (
        <source
          src={src}
          type={sourceType}
        />
      ))}
      Your browser does not support the HTML5 video element.
    </video>
  )
}

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";

  function isBroken(video: HTMLVideoElement) {
    return (
      Boolean(video.error) ||
      video.networkState === HTMLMediaElement.NETWORK_NO_SOURCE ||
      (video.paused && video.readyState === HTMLMediaElement.HAVE_NOTHING)
    );
  }

  function repairAndPlay(video: HTMLVideoElement) {
    // load() alone isn't enough in Firefox: the <source> nodes themselves
    // can carry over a failed-selection state from the view-transition
    // swap, so replace them with fresh nodes (no prior loading history)
    // before retrying.
    video.querySelectorAll("source").forEach((source) => {
      const fresh = document.createElement("source");

      fresh.src = source.src;
      fresh.type = source.type;
      source.replaceWith(fresh);
    });

    video.load();
    video.play().catch(() => {});
  }

  function tryPlay(video: HTMLVideoElement) {
    video.play().catch(() => {});

    // A <video> adopted via a view-transition swap can end up genuinely
    // stuck (Firefox: "All candidate resources failed to load", without
    // ever setting video.error). By the time this runs the browser has
    // usually already tried and failed, so the synchronous check catches
    // it with no added delay; the one deferred recheck covers a failure
    // that lands moments later. Repair only on confirmed failure — a
    // video whose load is merely still in flight would be aborted by an
    // unconditional load() (seen in Chrome).
    if (isBroken(video)) {
      repairAndPlay(video);
      return;
    }

    setTimeout(() => {
      if (isBroken(video)) repairAndPlay(video);
    }, 2000);
  }

  function playAutoplayVideos() {
    // Not scoped under a ".video" ancestor: the "video" class sits directly
    // on the <video> tag itself except for the background-media variant, so
    // a ".video video[autoplay]" descendant selector silently misses every
    // other case (vimeo, youtube, and the plain native <video>).
    const videos = document.querySelectorAll<HTMLVideoElement>("video[autoplay]");
    if (!videos.length) return;

    // Waiting until the video is actually scrolled into view gives the
    // browser plenty of time to settle before we touch it, and naturally
    // matches when the user would expect to see it play.
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const video = entry.target as HTMLVideoElement;

          if (video.paused) tryPlay(video);
          obs.unobserve(video);
        });
      },
      { threshold: 0.1 }
    );

    videos.forEach((video) => observer.observe(video));
  }

  onPageLoad(playAutoplayVideos);
</script>

<style is:global>
  @layer components {
    .video {
      display: block;
      margin-top: var(--spacing-lg);

      &.video-embed {
        aspect-ratio: 16 / 9;
        border: 0;
        height: auto;
        width: 100%;
      }

      &.background {
        inset: 0;
        margin-top: 0;
        overflow: hidden;
        pointer-events: none;
        position: absolute;

        > video {
          height: 100%;
          object-fit: cover;
          object-position: var(--background-position, center center);
          width: 100%;
        }
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .video.background {
        display: none;
      }
    }
  }
</style>
