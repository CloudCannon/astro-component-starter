---
import FormField from "@component-utils/FormField.astro";
import { formFieldParts, toDateInputValue } from "@component-utils/formField";

const {
  label,
  name,
  required = false,
  value,
  min,
  max,
  hint,
  error,
  autocomplete,
  id: customId,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const { controlAttributes, shellAttributes } = formFieldParts({
  prefix: "date",
  id: customId,
  name,
  label,
  autocomplete,
  required,
  hint,
  error,
});
---

<FormField
  class:list={["date", className]}
  {...shellAttributes}
  {...htmlAttributes}
>
  <input
    type="date"
    name={name}
    value={toDateInputValue(value)}
    min={toDateInputValue(min)}
    max={toDateInputValue(max)}
    class="field"
    {...controlAttributes}
  />
</FormField>
