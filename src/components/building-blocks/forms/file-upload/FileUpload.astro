---
import FormLabel from "@component-utils/FormLabel.astro";
import { generateFieldId } from "@component-utils/formField";
import { isNonEmptyString } from "@component-utils/isNonEmptyString";

const {
  label,
  name,
  required = false,
  accept,
  multiple = false,
  hint,
  error,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const fieldId = generateFieldId("file-upload", htmlAttributes.id);
const hintId = isNonEmptyString(hint) ? `${fieldId}-hint` : undefined;
const errorId = isNonEmptyString(error) ? `${fieldId}-error` : undefined;
const describedBy = [hintId, errorId].filter(Boolean).join(" ") || undefined;
---

<div
  class:list={["file-upload", className]}
  {...htmlAttributes}
>
  <FormLabel
    for={fieldId}
    label={label}
    required={required}
    requiredClass="file-upload-required"
  />
  {
    hintId && (
      <p
        class="file-upload-hint"
        id={hintId}
      >
        {hint}
      </p>
    )
  }
  <input
    type="file"
    name={name}
    id={fieldId}
    required={required}
    aria-required={required}
    aria-invalid={errorId ? "true" : undefined}
    aria-describedby={describedBy}
    accept={accept}
    multiple={multiple}
    class="field"
  />
  {
    errorId && (
      <p
        class="file-upload-error"
        id={errorId}
      >
        {error}
      </p>
    )
  }
</div>

<style is:global>
  @layer components {
    .file-upload {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
      margin: 0;
      margin-bottom: var(--spacing-md);
      width: 100%;

      .file-upload-required {
        color: var(--color-error);
        margin-inline-end: var(--spacing-em-xs);
      }

      .file-upload-hint {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
        margin: 0;
      }

      .file-upload-error {
        color: var(--color-error);
        font-size: var(--font-size-sm);
        margin: 0;
      }

      > .field[aria-invalid="true"] {
        border-color: var(--color-error);
      }
    }
  }
</style>
