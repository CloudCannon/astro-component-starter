---
import FormField from "@component-utils/FormField.astro";
import { formFieldParts } from "@component-utils/formField";

const {
  label,
  name,
  required = false,
  accept,
  multiple = false,
  hint,
  error,
  id: customId,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const { controlAttributes, shellAttributes } = formFieldParts({
  prefix: "file-upload",
  id: customId,
  name,
  label,
  required,
  hint,
  error,
});
---

<FormField
  class:list={["file-upload", className]}
  {...shellAttributes}
  {...htmlAttributes}
>
  <input
    type="file"
    name={name}
    accept={accept}
    multiple={multiple}
    class="field"
    {...controlAttributes}
  />
</FormField>
