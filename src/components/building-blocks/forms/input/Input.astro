---
import Icon from "@core-elements/icon/Icon.astro";
import FormField from "@component-utils/FormField.astro";
import { formFieldParts } from "@component-utils/formField";
import { isNonEmptyString } from "@component-utils/isNonEmptyString";

const {
  label,
  name,
  type = "text",
  placeholder,
  required = false,
  value,
  hint,
  error,
  iconName,
  iconColor = "default",
  iconPosition = "before",
  autocomplete,
  id: customId,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const { controlAttributes, shellAttributes } = formFieldParts({
  prefix: "input",
  id: customId,
  name,
  label,
  placeholder,
  type,
  autocomplete,
  required,
  hint,
  error,
});
const hasIcon = isNonEmptyString(iconName);
---

<FormField
  class:list={["input", className]}
  {...shellAttributes}
  {...htmlAttributes}
>
  {
    hasIcon ? (
      <span class:list={["field-shell", iconPosition === "after" && "icon-after"]}>
        <Icon
          name={iconName}
          color={iconColor}
          size="none"
          class="input-icon"
          aria-hidden="true"
          role="presentation"
        />
        <input
          type={type}
          name={name}
          placeholder={placeholder}
          value={value}
          class="field"
          {...controlAttributes}
        />
      </span>
    ) : (
      <input
        type={type}
        name={name}
        placeholder={placeholder}
        value={value}
        class="field"
        {...controlAttributes}
      />
    )
  }
</FormField>

<style is:global>
  @layer components {
    .input {
      .field-shell:has(> .field[aria-invalid="true"]) {
        border-color: var(--color-error);
      }

      .field-shell {
        align-items: center;
        background-color: var(--color-bg);
        border: var(--border-width-sm) solid var(--color-border-inputs);
        border-radius: var(--radius-xs);
        display: flex;
        gap: var(--spacing-em-sm);
        padding-inline: var(--spacing-em-sm);
        transition:
          border-color var(--animation-normal) var(--ease-in-out),
          box-shadow var(--animation-normal) var(--ease-in-out);

        &:has(:focus-visible) {
          border-color: var(--color-brand);
          outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
          outline-offset: 2px;
        }

        &.icon-after {
          flex-direction: row-reverse;
        }

        .input-icon {
          color: var(--color-text-muted);
          flex-shrink: 0;
          font-size: 1.25em;
        }

        > .field {
          background-color: transparent;
          border: 0;
          border-radius: 0;
          box-shadow: none;
          flex: 1 1 auto;
          min-width: 0;
          padding-inline: 0;

          &:focus-visible {
            outline: none;
          }
        }
      }
    }
  }
</style>
