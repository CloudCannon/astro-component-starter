---
import Icon from "@core-elements/icon/Icon.astro";
import FormLabel from "@component-utils/FormLabel.astro";
import { generateFieldId } from "@component-utils/formField";
import { isNonEmptyString } from "@component-utils/isNonEmptyString";

const {
  label,
  name,
  type = "text",
  placeholder,
  required = false,
  value,
  hint,
  error,
  iconName,
  iconColor = "default",
  iconPosition = "before",
  id: customId,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const fieldId = generateFieldId("input", customId);
const hasIcon = isNonEmptyString(iconName);
const hintId = isNonEmptyString(hint) ? `${fieldId}-hint` : undefined;
const errorId = isNonEmptyString(error) ? `${fieldId}-error` : undefined;
const describedBy = [hintId, errorId].filter(Boolean).join(" ") || undefined;
---

<div
  class:list={["input", className]}
  {...htmlAttributes}
>
  <FormLabel
    for={fieldId}
    label={label}
    required={required}
    requiredClass="input-required"
  />
  {
    hintId && (
      <p
        class="input-hint"
        id={hintId}
      >
        {hint}
      </p>
    )
  }
  {
    hasIcon ? (
      <span class:list={["field-shell", iconPosition === "after" && "icon-after"]}>
        <Icon
          name={iconName}
          color={iconColor}
          size="none"
          class="input-icon"
          aria-hidden="true"
          role="presentation"
        />
        <input
          type={type}
          name={name}
          id={fieldId}
          placeholder={placeholder}
          required={required}
          aria-required={required}
          aria-invalid={errorId ? "true" : undefined}
          aria-describedby={describedBy}
          value={value}
          class="field"
        />
      </span>
    ) : (
      <input
        type={type}
        name={name}
        id={fieldId}
        placeholder={placeholder}
        required={required}
        aria-required={required}
        aria-invalid={errorId ? "true" : undefined}
        aria-describedby={describedBy}
        value={value}
        class="field"
      />
    )
  }
  {
    errorId && (
      <p
        class="input-error"
        id={errorId}
      >
        {error}
      </p>
    )
  }
</div>

<style is:global>
  @layer components {
    .input {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
      margin: 0;
      margin-bottom: var(--spacing-md);
      width: 100%;

      .input-required {
        color: var(--color-error);
        margin-inline-end: var(--spacing-em-xs);
      }

      .input-hint {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
        margin: 0;
      }

      .input-error {
        color: var(--color-error);
        font-size: var(--font-size-sm);
        margin: 0;
      }

      > .field[aria-invalid="true"],
      .field-shell:has(> .field[aria-invalid="true"]) {
        border-color: var(--color-error);
      }

      .field-shell {
        align-items: center;
        background-color: var(--color-bg);
        border: 1px solid var(--color-border-inputs);
        border-radius: var(--radius-xs);
        display: flex;
        gap: var(--spacing-em-sm);
        padding-inline: var(--spacing-em-sm);
        transition:
          border-color var(--animation-normal) var(--ease-in-out),
          box-shadow var(--animation-normal) var(--ease-in-out);

        &:has(:focus-visible) {
          border-color: var(--color-brand);
          outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
          outline-offset: 2px;
        }

        &.icon-after {
          flex-direction: row-reverse;
        }

        .input-icon {
          color: var(--color-text-muted);
          flex-shrink: 0;
          font-size: 1.25em;
        }

        > .field {
          background-color: transparent;
          border: 0;
          border-radius: 0;
          box-shadow: none;
          flex: 1 1 auto;
          min-width: 0;
          padding-inline: 0;

          &:focus-visible {
            outline: none;
          }
        }
      }
    }
  }
</style>
