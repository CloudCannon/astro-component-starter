---
import FormField from "@component-utils/FormField.astro";
import { formFieldParts } from "@component-utils/formField";

const {
  label,
  name,
  min = 0,
  max = 100,
  step = 1,
  value,
  unit = "",
  tickStyle = "uniform",
  tickCount = 11,
  required = false,
  showValue = true,
  hint,
  error,
  id: customId,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const { fieldId, controlAttributes, shellAttributes } = formFieldParts({
  prefix: "range",
  id: customId,
  name,
  label,
  required,
  hint,
  error,
});
const defaultValue = value ?? min;
const initialPct = ((defaultValue - min) / (max - min || 1)) * 100;
const displayValue = Number.isInteger(step) ? Math.round(defaultValue) : defaultValue;

// Purely decorative scale markings — even divisions regardless of the actual
// min/max/step, matching a ruler rather than tracking real snap points.
const showTicks = tickStyle !== "none";
const ticks = showTicks
  ? Array.from({ length: tickCount }, (_, i) => {
      const p = (i / (tickCount - 1)) * 100;

      return {
        filled: p <= initialPct + 0.001,
        near: tickStyle === "nearest" && Math.abs(p - initialPct) < 50 / (tickCount - 1),
      };
    })
  : [];
---

<FormField
  class:list={["range", className]}
  {...shellAttributes}
  {...htmlAttributes}
>
  {
    showValue && (
      <div
        class="range-readout"
        slot="header-end"
      >
        <output
          class="range-value"
          for={fieldId}
        >
          {displayValue}
        </output>
        {unit && <span class="range-unit">{unit}</span>}
      </div>
    )
  }
  <input
    type="range"
    name={name}
    min={min}
    max={max}
    step={step}
    value={defaultValue}
    class="range-input"
    style={`--range-pct: ${initialPct}%`}
    {...controlAttributes}
  />
  {
    showTicks && (
      <div
        class="range-ticks"
        data-tick-style={tickStyle}
        aria-hidden="true"
      >
        {ticks.map((tick) => (
          <span class:list={["range-tick", tick.filled && "is-filled", tick.near && "is-near"]} />
        ))}
      </div>
    )
  }
  <div
    class="range-bounds"
    aria-hidden="true"
  >
    <span>{min}</span>
    <span>{max}</span>
  </div>
</FormField>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";

  onPageLoad(() => {
    const ranges = document.querySelectorAll<HTMLDivElement>(".range");
    if (!ranges.length) return;

    ranges.forEach((wrapper) => {
      const input = wrapper.querySelector<HTMLInputElement>(".range-input");
      const output = wrapper.querySelector<HTMLOutputElement>(".range-value");
      const ticks = wrapper.querySelectorAll<HTMLSpanElement>(".range-tick");
      if (!input) return;

      const tickStyle =
        wrapper.querySelector<HTMLElement>(".range-ticks")?.dataset.tickStyle || "uniform";

      const update = () => {
        const min = Number(input.min) || 0;
        const max = Number(input.max) || 100;
        const step = Number(input.step) || 1;
        const val = Number(input.value);
        const span = max - min || 1;
        const pct = ((val - min) / span) * 100;

        input.style.setProperty("--range-pct", `${pct}%`);

        if (output) {
          output.value = String(Number.isInteger(step) ? Math.round(val) : val);
        }

        if (ticks.length > 1) {
          const count = ticks.length;

          ticks.forEach((tick, i) => {
            const p = (i / (count - 1)) * 100;

            tick.classList.toggle("is-filled", p <= pct + 0.001);
            tick.classList.toggle(
              "is-near",
              tickStyle === "nearest" && Math.abs(p - pct) < 50 / (count - 1)
            );
          });
        }
      };

      input.addEventListener("input", update);

      // Native range inputs don't support a shift-for-bigger-step modifier, and
      // browsers vary in how big a Page Up/Down jump is — make both exact.
      input.addEventListener("keydown", (e) => {
        const step = Number(input.step) || 1;
        let delta = 0;

        if (e.shiftKey && (e.key === "ArrowRight" || e.key === "ArrowUp")) delta = step * 10;
        else if (e.shiftKey && (e.key === "ArrowLeft" || e.key === "ArrowDown")) delta = -step * 10;
        else if (e.key === "PageUp") delta = step * 10;
        else if (e.key === "PageDown") delta = -step * 10;
        else return;

        e.preventDefault();

        const min = Number(input.min) || 0;
        const max = Number(input.max) || 100;
        const next = Math.min(max, Math.max(min, Number(input.value) + delta));

        input.value = String(next);
        input.dispatchEvent(new Event("input", { bubbles: true }));
      });
    });
  });
</script>

<style is:global>
  @layer components {
    @property --range-pct {
      syntax: "<percentage>";
      inherits: true;
      initial-value: 0%;
    }

    .range {
      --range-ease: cubic-bezier(0.22, 1, 0.36, 1);
      --range-fill-duration: 260ms;
      --range-tick-duration: 220ms;
      --thumb-size: 26px;

      /* Slider, ticks and bounds are one stacked unit: the shell's row gap
         would float them off the track. Spacing is per-part instead. */
      gap: 0;

      .form-field-header {
        margin-bottom: var(--spacing-sm);
      }

      .form-field-hint {
        margin-bottom: var(--spacing-sm);
      }

      .form-field-error {
        margin-top: var(--spacing-xs);
      }

      .range-readout {
        align-items: baseline;
        color: var(--color-text-strong);
        display: flex;
        gap: 2px;
      }

      .range-value {
        font-size: var(--font-size-md);
        font-variant-numeric: tabular-nums;
        font-weight: var(--font-weight-normal);
        min-width: 2ch;
        text-align: end;
      }

      .range-unit {
        color: var(--color-text-muted);
        font-size: var(--font-size-xs);
      }

      .range-input {
        --track-height: 8px;
        --hit-height: 44px;

        appearance: none;
        background: transparent;
        border: none;
        box-shadow: none;
        cursor: pointer;
        height: var(--hit-height);
        margin-block: 0 2px;
        margin-inline: 0;
        padding: 0;
        /* Deliberately slower than the thumb's own 200ms: the track fill
           settles just behind the handle. */
        transition: --range-pct var(--range-fill-duration) var(--range-ease);
        width: 100%;

        &:active {
          transition: none;
        }

        &:focus-visible {
          outline: none;
        }

        &::-webkit-slider-runnable-track {
          background: linear-gradient(
            to right,
            var(--color-text-strong) var(--range-pct),
            var(--color-border) var(--range-pct)
          );
          border-radius: var(--radius-full);
          height: var(--track-height);
        }

        &::-moz-range-track {
          background: var(--color-border);
          border-radius: var(--radius-full);
          height: var(--track-height);
        }

        &::-moz-range-progress {
          background: var(--color-text-strong);
          border-radius: var(--radius-full);
          height: var(--track-height);
        }

        &::-webkit-slider-thumb {
          -webkit-appearance: none;
          appearance: none;
          background-color: var(--color-text-strong);
          border-radius: var(--radius-full);
          box-shadow: 0 0 0 3px var(--color-bg);
          height: var(--thumb-size);
          margin-top: calc((var(--track-height) - var(--thumb-size)) / 2);
          transform: scale(1);
          transition:
            transform var(--animation-normal) var(--range-ease),
            box-shadow var(--animation-normal) var(--ease-default);
          width: var(--thumb-size);
        }

        &::-moz-range-thumb {
          appearance: none;
          background-color: var(--color-text-strong);
          border: none;
          border-radius: var(--radius-full);
          box-shadow: 0 0 0 3px var(--color-bg);
          height: var(--thumb-size);
          transform: scale(1);
          transition:
            transform var(--animation-normal) var(--range-ease),
            box-shadow var(--animation-normal) var(--ease-default);
          width: var(--thumb-size);
        }

        &:hover::-webkit-slider-thumb {
          box-shadow:
            0 0 0 3px var(--color-bg),
            var(--shadow-sm);
          transform: scale(1.06);
        }

        &:hover::-moz-range-thumb {
          box-shadow:
            0 0 0 3px var(--color-bg),
            var(--shadow-sm);
          transform: scale(1.06);
        }

        &:active::-webkit-slider-thumb {
          box-shadow:
            0 0 0 3px var(--color-bg),
            var(--shadow-md);
          transform: scale(1.1);
        }

        &:active::-moz-range-thumb {
          box-shadow:
            0 0 0 3px var(--color-bg),
            var(--shadow-md);
          transform: scale(1.1);
        }

        &:focus-visible::-webkit-slider-thumb {
          box-shadow:
            0 0 0 3px var(--color-bg),
            0 0 0 calc(3px + var(--focus-ring-width)) var(--color-focus-ring);
        }

        &:focus-visible::-moz-range-thumb {
          box-shadow:
            0 0 0 3px var(--color-bg),
            0 0 0 calc(3px + var(--focus-ring-width)) var(--color-focus-ring);
        }

        &:disabled {
          cursor: not-allowed;
          opacity: 0.5;
        }
      }

      .range-ticks {
        align-items: flex-start;
        display: flex;
        height: 7px;
        justify-content: space-between;
        margin-inline: calc(var(--thumb-size) / 2);
        pointer-events: none;
        width: calc(100% - var(--thumb-size));
      }

      .range-tick {
        background-color: var(--color-border-subtle);
        height: 5px;
        transition:
          height var(--range-tick-duration) var(--range-ease),
          background-color var(--animation-normal) var(--ease-default);
        width: 1px;

        &.is-filled {
          background-color: var(--color-border);
        }

        &.is-near {
          height: 7px;
        }
      }

      .range-bounds {
        color: var(--color-text-muted);
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--font-size-xs);
        justify-content: space-between;
        letter-spacing: 0.02em;
        margin-inline: calc(var(--thumb-size) / 2);
        margin-top: var(--spacing-xs);
        width: calc(100% - var(--thumb-size));

        /* Centre each label on its tick (the container's own edges) rather
           than left/right-aligning the text against them. */
        span:first-child {
          transform: translateX(-50%);
        }

        span:last-child {
          transform: translateX(50%);
        }
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .range-input,
      .range-input::-webkit-slider-thumb,
      .range-input::-moz-range-thumb,
      .range-tick {
        transition: none !important;
      }
    }
  }
</style>
