---
import Icon from "@core-elements/icon/Icon.astro";
import { generateFieldId } from "@component-utils/formField";
import type { SegmentOption } from "../../../../types";

const {
  name,
  options = [] as SegmentOption[],
  title,
  required = false,
  iconOnly = false,
  multiple = false,
  keepStateOnRefresh = false,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const groupId = generateFieldId("segments", htmlAttributes.id, name || title);
const inputType = multiple ? "checkbox" : "radio";

// Native `required` on a checkbox means "tick this box", not "pick at least one".
const requireEachInput = required && !multiple;
---

{/* `group` doesn't support `aria-required`, hence `radiogroup`; a `<legend>` doesn't
    reliably name a fieldset whose role is overridden, hence `aria-labelledby`. */}
<fieldset
  class:list={["segments", className]}
  role={multiple ? undefined : "radiogroup"}
  aria-labelledby={title ? `${groupId}-legend` : undefined}
  aria-label={title ? undefined : name || undefined}
  aria-required={!multiple && required ? "true" : undefined}
  {...htmlAttributes}
>
  {title && (
    <legend
      id={`${groupId}-legend`}
      class="legend"
    >
      {title}
      {required && (
        <span
          class="segments-required"
          aria-hidden="true"
        >
          *
        </span>
      )}
    </legend>
  )}
  <div class:list={["segments-options", iconOnly && "icon-only", multiple && "multiple"]}>
    {
      /* Icon-only segments render no label text, so the input needs `aria-label`. */
      options.map((option: SegmentOption, index: number) => (
        <label class="segments-option">
          <input
            type={inputType}
            name={multiple ? `${name}[]` : name}
            value={option.value}
            checked={option.checked ? "checked" : undefined}
            required={requireEachInput && index === 0}
            autocomplete={keepStateOnRefresh ? "on" : "off"}
            class="segments-field"
            aria-label={iconOnly ? option.label || undefined : undefined}
          />
          <span
            class="segment"
            title={iconOnly && option.label ? option.label : undefined}
          >
            {option.icon && (
              <Icon
                name={option.icon}
                size="none"
                class="segment-icon"
                aria-hidden="true"
              />
            )}
            {option.label && !iconOnly && <span class="segment-label">{option.label}</span>}
          </span>
        </label>
      ))
    }
  </div>
</fieldset>

<style is:global>
  @layer components {
    .segments {
      border: none;
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
      margin: 0;
      padding: 0;

      .segments-required {
        color: var(--color-error);
        margin-inline-end: var(--spacing-em-xs);
      }

      .legend {
        margin-bottom: var(--spacing-xs);
      }

      .segments-options {
        /* The padding/negative-margin pair stops the scroll box clipping focus rings. */
        --segments-focus-room: calc(var(--focus-ring-width) + 2px);

        display: flex;
        margin: calc(var(--segments-focus-room) * -1);
        overflow-x: auto;
        padding: var(--segments-focus-room);
      }

      .segments-option {
        align-items: center;
        display: flex;
        flex-shrink: 0;
        position: relative;

        /* Hidden but focusable, so arrow keys and Space still operate the group. */
        .segments-field {
          height: 1px;
          margin: 0;
          opacity: 0;
          pointer-events: none;
          position: absolute;
          width: 1px;
        }

        .segment {
          align-items: center;
          background-color: var(--color-bg-surface);
          border: var(--border-width-sm) solid var(--color-border);
          color: var(--color-text-muted);
          cursor: pointer;
          display: inline-flex;
          flex: 1;
          height: 100%;
          justify-content: center;
          padding: var(--spacing-xs) var(--spacing-sm);
          position: relative;
          transition: background-color var(--animation-normal) var(--ease-default);
          vertical-align: middle;

          &:hover {
            background-color: var(--color-bg-muted);

            &,
            .segment-icon {
              color: var(--color-text-strong);
            }
          }

          .segment-icon {
            flex-shrink: 0;
            height: 1em;
            width: 1em;
          }

          .segment-icon + .segment-label {
            margin-inline-start: var(--spacing-em-xs);
          }

          .segment-label {
            white-space: nowrap;
          }
        }

        .segments-field:checked + .segment {
          &,
          &:hover {
            background-color: var(--color-bg);
            border: var(--border-width-sm) solid var(--color-brand);
            color: var(--color-text-strong);
            z-index: 1;
          }

          .segment-icon {
            color: var(--color-text-strong);
          }
        }

        .segments-field:focus-visible + .segment {
          outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
          outline-offset: 2px;
        }
      }

      .segments-option:first-of-type .segment {
        border-end-start-radius: var(--radius-sm);
        border-start-start-radius: var(--radius-sm);
      }

      .segments-option:last-of-type .segment {
        border-end-end-radius: var(--radius-sm);
        border-start-end-radius: var(--radius-sm);
      }

      .segments-option:not(:last-of-type) .segment {
        border-inline-end: none;
      }

      .segments-option:not(:last-of-type):has(.segments-field:checked) + .segments-option .segment {
        border-inline-start: 0;
      }

      > .segments-options.icon-only .segments-option .segment .segment-icon {
        margin-block: var(--spacing-xs);
      }
    }
  }
</style>
