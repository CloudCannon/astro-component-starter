---
import Icon from "@core-elements/icon/Icon.astro";
import SelectOption from "./SelectOption.astro";
import FormField from "@component-utils/FormField.astro";
import { formFieldParts } from "@component-utils/formField";
import { isNonEmptyString } from "@component-utils/isNonEmptyString";
import type { SegmentOption } from "../../../../types";

const {
  label,
  name,
  options = [],
  placeholder,
  required = false,
  value,
  hint,
  error,
  iconName,
  iconColor = "default",
  autocomplete,
  id: customId,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const { controlAttributes, shellAttributes } = formFieldParts({
  prefix: "select",
  id: customId,
  name,
  label,
  placeholder,
  autocomplete,
  required,
  hint,
  error,
});
const hasLeadingIcon = isNonEmptyString(iconName);

// A disabled placeholder that isn't `selected` never shows — the browser falls
// through to the first enabled option, and `required` is satisfied on load.
const placeholderSelected = !options?.some((option: SegmentOption) => option.value === value);
---

<FormField
  class:list={["select", className]}
  {...shellAttributes}
  {...htmlAttributes}
>
  <div class:list={["field-shell", { "has-leading-icon": hasLeadingIcon }]}>
    {
      hasLeadingIcon && (
        <Icon
          name={iconName}
          color={iconColor}
          size="none"
          class="select-icon select-leading-icon"
          aria-hidden="true"
          role="presentation"
        />
      )
    }
    <select
      name={name}
      class="field"
      {...controlAttributes}
    >
      {
        placeholder && (
          <option
            value=""
            disabled
            selected={placeholderSelected}
          >
            {placeholder}
          </option>
        )
      }
      {
        options?.length > 0 ? (
          options?.map((option: SegmentOption) => (
            <SelectOption
              value={option.value}
              label={option.label}
              selected={option.value === value}
            />
          ))
        ) : (
          <slot />
        )
      }
    </select>
    <Icon
      name="chevron-down"
      size="none"
      class="select-icon select-chevron"
      aria-hidden="true"
      role="presentation"
    />
  </div>
</FormField>

<style is:global>
  @layer components {
    .select .field-shell {
      background-color: var(--color-bg);
      border: var(--border-width-sm) solid var(--color-border-inputs);
      border-radius: var(--radius-xs);
      display: block;
      position: relative;
      transition:
        border-color var(--animation-normal) var(--ease-in-out),
        box-shadow var(--animation-normal) var(--ease-in-out);

      &:has(:focus-visible) {
        border-color: var(--color-brand);
        outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
        outline-offset: 2px;
      }

      &:has(> .field[aria-invalid="true"]) {
        border-color: var(--color-error);
      }

      .select-icon {
        color: var(--color-text-muted);
        font-size: 1.25em;
        pointer-events: none;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
      }

      .select-leading-icon {
        inset-inline-start: var(--spacing-em-sm);
      }

      .select-chevron {
        inset-inline-end: var(--spacing-em-sm);
      }

      > .field {
        appearance: none;
        background-color: transparent;
        border: 0;
        border-radius: 0;
        box-shadow: none;
        cursor: pointer;
        display: block;
        padding-block: var(--spacing-em-sm);
        padding-inline-end: calc(1.25em + var(--spacing-em-sm) * 2);
        padding-inline-start: var(--spacing-em-sm);
        width: 100%;

        &:focus-visible {
          outline: none;
        }
      }

      &.has-leading-icon > .field {
        padding-inline-start: calc(1.25em + var(--spacing-em-sm) * 2);
      }
    }
  }
</style>
