---
import FormField from "@component-utils/FormField.astro";
import { formFieldParts } from "@component-utils/formField";

const {
  label,
  name,
  placeholder,
  required = false,
  value,
  hint,
  error,
  autocomplete,
  id: customId,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const { controlAttributes, shellAttributes } = formFieldParts({
  prefix: "textarea",
  id: customId,
  name,
  label,
  placeholder,
  autocomplete,
  required,
  hint,
  error,
});
---

<FormField
  class:list={["textarea", className]}
  {...shellAttributes}
  {...htmlAttributes}
>
  <textarea
    name={name}
    placeholder={placeholder}
    class="field"
    {...controlAttributes}
    >{value}</textarea
  >
</FormField>
