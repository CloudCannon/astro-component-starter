---
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import { slugifyLabel } from "@components/utils/slugify";
import AccordionItem from "./AccordionItem.astro";

type ItemProps = Record<string, unknown>;

const {
  items,
  openFirst,
  singleOpen = false,
  label,
  spaceBefore = "default",
  useDefaultEditableBinding = false,
  "data-children-prop": childrenDataProp,
  _component,
  ...htmlAttributes
} = Astro.props;

if (!htmlAttributes.id && label) {
  htmlAttributes.id = slugifyLabel(label);
}

// The exclusive-group name must be unique per accordion on the page.
// Unlabelled accordions fall back to their first item's title — two on one
// page opening on the same title would share a group — and slot-only ones to
// a generated id.
const firstTitle = (items as ItemProps[])?.[0]?.title;
const accordionName = singleOpen
  ? `accordion-${htmlAttributes.id || (firstTitle && slugifyLabel(String(firstTitle))) || crypto.randomUUID()}`
  : undefined;

const effectiveChildrenProp = childrenDataProp ?? (useDefaultEditableBinding ? "items" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};

const hasItems = items?.length > 0;
const hasSlotContent = Astro.slots.has("default");

if (!_component && !hasItems && !hasSlotContent) return;
---

<div
  class:list={["accordion", "stackable"]}
  {...htmlAttributes}
>
  <div
    data-space-before={spaceBeforeAttr(spaceBefore)}
    {...arrayDataAttributes}
  >
    <slot>
      {
        items?.map((item: ItemProps, index: number) => {
          const isFirst = index === 0 && openFirst;

          return (
            <AccordionItem
              isOpen={isFirst}
              accordionName={accordionName}
              useDefaultEditableBinding={!!effectiveChildrenProp}
              data-editable="array-item"
              data-id="building-blocks/wrappers/accordion/accordion-item"
              {...item}
            />
          );
        })
      }
    </slot>
  </div>
</div>

<style is:global>
  @layer components {
    .accordion {
    }
  }
</style>
