---
import RenderBlock from "@component-utils/renderBlock.astro";

const {
  colSpan = 1,
  rowSpan = 1,
  columns = 3,
  contentSections,
  useDefaultEditableBinding = false,
  class: className,
  _component,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = Astro.props;

const effectiveChildrenProp =
  childrenDataProp ?? (useDefaultEditableBinding ? "contentSections" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};

// A span wider than the grid is not an error the editor can see: the cell just
// silently takes the whole row. Clamping keeps the authored number honest.
const columnCount = Math.max(1, Math.round(Number(columns) || 3));
const span = Math.min(Math.max(1, Math.round(Number(colSpan) || 1)), columnCount);

const cellStyles = [
  span > 1 && `grid-column: span ${span}`,
  Number(rowSpan) > 1 && `grid-row: span ${rowSpan}`,
]
  .filter(Boolean)
  .join("; ");
---

<div
  class:list={["bento-box-item", className]}
  style={cellStyles || undefined}
  {...htmlAttributes}
>
  <div
    class="bento-box-item-content flow"
    data-col-span={span}
    data-row-span={rowSpan}
    {...arrayDataAttributes}
  >
    <slot>
      {
        contentSections && (
          <RenderBlock
            contentSections={contentSections}
            useDefaultEditableBinding={!!effectiveChildrenProp}
          />
        )
      }
    </slot>
  </div>
</div>

<style is:global>
  @layer components {
    .bento-box-item {
      container-type: inline-size;

      > .bento-box-item-content {
        height: 100%;
      }

      > .bento-box-item-content > *:only-child {
        height: 100%;
      }
    }
  }
</style>
