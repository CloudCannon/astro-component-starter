---
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import { slugifyLabel } from "@components/utils/slugify";
import Masonry from "@wrappers/masonry/Masonry.astro";
import MasonryItem from "@wrappers/masonry/MasonryItem.astro";
import CardGridItem from "./CardGridItem.astro";

type ItemProps = Record<string, unknown>;

const {
  label,
  layout = "grid",
  columns = 3,
  gap = "lg",
  aspectRatio = "landscape",
  items = [],
  spaceBefore = "default",
  class: className,
  style: userStyle,
  useDefaultEditableBinding = false,
  _component,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = Astro.props;

if (!htmlAttributes.id && label) {
  htmlAttributes.id = slugifyLabel(label);
}

const masonry = layout === "masonry";
const columnCount = Math.min(4, Math.max(2, Math.round(Number(columns) || 3)));

// Masonry mode keeps each cover's own shape — a fixed crop there would make
// every card the same height, which is the whole point of the grid layout.
const cardRatio = masonry ? "none" : aspectRatio;
const gapValue = gap === "none" ? "0px" : `var(--spacing-${gap})`;

const gridStyles = [
  `--card-grid-columns: ${columnCount}`,
  `--card-grid-gap: ${gapValue}`,
  userStyle,
]
  .filter(Boolean)
  .join("; ");

const effectiveChildrenProp = childrenDataProp ?? (useDefaultEditableBinding ? "items" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp, "data-direction": "row" }
  : {};

const itemRegionAttributes = effectiveChildrenProp
  ? {
      "data-id": "building-blocks/wrappers/card-grid/card-grid-item",
      "data-editable": "array-item",
    }
  : {};
const itemContentProp = effectiveChildrenProp ? "contentSections" : undefined;

const hasItems = items?.length > 0;
const hasSlotContent = Astro.slots.has("default");

if (!_component && !hasItems && !hasSlotContent) return;
---

{
  masonry ? (
    /* The Masonry wrapper brings its own order-preserving enhancement and
       editor wiring, so masonry mode composes it rather than repeating the
       layout JS here. */
    <div
      class:list={["card-grid", "stackable", "is-masonry", className]}
      {...htmlAttributes}
    >
      {/* data-space-before rides a child so flow's :has() hoist finds it — on
          the region root a prop-driven attribute goes stale in the editor. */}
      <Masonry
        class="card-grid-masonry"
        data-space-before={spaceBeforeAttr(spaceBefore)}
        columns={columnCount}
        gap={gap}
        data-children-prop={effectiveChildrenProp}
      >
        <slot>
          {/* MasonryItem is the measurement probe for the JS enhancement.
               CardGridItem can't be the grid child: it has overflow:hidden
               and a flex column, so measuring it after the row-span is set
               feeds back into an 8px-tall collapse. */}
          {items?.map((item: ItemProps) => (
            <MasonryItem {...itemRegionAttributes}>
              <CardGridItem
                useDefaultEditableBinding={!!effectiveChildrenProp}
                {...item}
                aspectRatio={cardRatio}
                data-children-prop={itemContentProp}
              />
            </MasonryItem>
          ))}
        </slot>
      </Masonry>
    </div>
  ) : (
    /* Exact columns on this element (same as Gallery Grid / the old Card
       Collection ul) so the grid has a definite stretch width. A nested
       inner with minmax(0, 1fr) shrink-wraps to ~0 when its parent width
       is indefinite. */
    /* Only the items are children here, so data-space-before rides the root:
       live edits to spaceBefore need a reload (see _flow.css). */
    <div
      class:list={["card-grid", "stackable", className]}
      data-space-before={spaceBeforeAttr(spaceBefore)}
      style={gridStyles}
      {...arrayDataAttributes}
      {...htmlAttributes}
    >
      <slot>
        {items?.map((item: ItemProps) => (
          <CardGridItem
            useDefaultEditableBinding={!!effectiveChildrenProp}
            {...item}
            {...itemRegionAttributes}
            aspectRatio={cardRatio}
            data-children-prop={itemContentProp}
          />
        ))}
      </slot>
    </div>
  )
}

<style is:global>
  @layer components {
    .card-grid {
      --space-before: var(--space-before-loose);
      width: 100%;

      &:not(.is-masonry) {
        display: grid;
        gap: var(--card-grid-gap, var(--spacing-lg));
        grid-template-columns: minmax(0, 1fr);

        /* 640px: canonical mobile breakpoint — one card per row below it. */
        @media (width >= 640px) {
          grid-template-columns: repeat(var(--card-grid-columns, 3), minmax(0, 1fr));
        }

        > * {
          min-width: 0;
        }
      }

      /* Masonry owns its own inner spacing; Card Grid owns the outer offset. */
      > .masonry {
        margin-top: 0;
      }
    }
  }
</style>
