---
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import { overlayColor } from "@components/utils/overlayColor";
import Component from "@components/utils/renderBlock.astro";
import { resolveImageSource } from "@components/utils/resolveImageSource";
import { slugifyLabel } from "@components/utils/slugify";
import Image from "@core-elements/image/Image.astro";
import Video from "@core-elements/video/Video.astro";

const {
  label,
  contentSections,
  beforeContentSections,
  afterContentSections,
  maxContentWidth,
  paddingHorizontal,
  paddingVertical,
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor,
  background,
  link,
  // Purely for CloudCannon: gates whether the beforeContentSections/afterContentSections
  // inputs are shown in the editor. Rendering itself is driven by content presence, below.
  showBeforeAfter: _showBeforeAfter = false,
  rounded = false,
  border = false,
  spaceBefore = "default",
  class: className,
  useDefaultEditableBinding = false,
  _component,
  "data-children-prop": childrenDataProp,
  "data-children-prop-before": childrenDataPropBefore,
  "data-children-prop-after": childrenDataPropAfter,
  ...htmlAttributes
} = Astro.props;

const {
  type: bgType = "image",
  positionVertical = "top",
  positionHorizontal = "center",
  priority = false,
  imageSource = "",
  imageAlt = "",
  videoSource = "",
  overlay = 0,
  fixed = false,
  patternSize = "natural",
} = background || {};

const usesFixedBackground = bgType === "image" && fixed && !!imageSource;
const patternImageUrl =
  bgType === "pattern" && imageSource ? resolveImageSource(imageSource) : null;

if (!htmlAttributes.id && label) {
  htmlAttributes.id = slugifyLabel(label);
}

const effectiveChildrenProp =
  childrenDataProp ?? (useDefaultEditableBinding ? "contentSections" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};

const effectiveBeforeProp =
  childrenDataPropBefore ?? (useDefaultEditableBinding ? "beforeContentSections" : null);
const arrayDataAttributesBefore = effectiveBeforeProp
  ? { "data-editable": "array", "data-prop": effectiveBeforeProp }
  : {};

const effectiveAfterProp =
  childrenDataPropAfter ?? (useDefaultEditableBinding ? "afterContentSections" : null);
const arrayDataAttributesAfter = effectiveAfterProp
  ? { "data-editable": "array", "data-prop": effectiveAfterProp }
  : {};

const isPopoverLink = link?.startsWith("^");
const Tag = link ? (isPopoverLink ? "button" : "a") : "div";
const hasBeforeSlot = Astro.slots.has("before");
const hasAfterSlot = Astro.slots.has("after");
const usesBeforeContentSections = !hasBeforeSlot && beforeContentSections;
const usesAfterContentSections = !hasAfterSlot && afterContentSections;
---

<div
  class:list={["card", "stackable", className]}
  {...htmlAttributes}
>
  <Tag
    data-space-before={spaceBeforeAttr(spaceBefore)}
    {...isPopoverLink
      ? { type: "button", popovertarget: link.slice(1), popovertargetaction: "show" }
      : link && { href: link }}
    class:list={[
      "card-inner",
      rounded && "rounded",
      border && "border",
      usesFixedBackground && "background-fixed",
    ]}
    data-theme={colorScheme && colorScheme !== "inherit" ? colorScheme : undefined}
    data-theme-lock={lockColorScheme || undefined}
  >
    {
      bgType === "image" && (
        <Image
          class:list={["background-image"]}
          source={imageSource}
          alt={imageAlt}
          priority={priority}
          positionVertical={positionVertical}
          positionHorizontal={positionHorizontal}
          background={true}
          sizes="100vw"
        />
      )
    }
    {
      bgType === "video" && (
        <Video
          type="local-source"
          source={videoSource}
          background={true}
          style={{ "--background-position": `${positionHorizontal} ${positionVertical}` }}
        />
      )
    }
    {
      patternImageUrl && (
        <div
          class:list={["background-pattern", `pattern-size-${patternSize}`]}
          aria-hidden="true"
          style={{ backgroundImage: `url("${patternImageUrl}")` }}
        />
      )
    }
    {
      overlay !== 0 && (
        <div
          class="background-overlay"
          aria-hidden="true"
          style={{
            backgroundColor: overlayColor(overlay),
          }}
        />
      )
    }
    {
      backgroundColor && (
        <div
          aria-hidden="true"
          class:list={["background", backgroundColor && `bg-${backgroundColor}`]}
        />
      )
    }

    {
      (usesBeforeContentSections || hasBeforeSlot) && (
        <div
          class="before-content flow"
          {...arrayDataAttributesBefore}
        >
          <slot name="before">
            {beforeContentSections && (
              <Component
                contentSections={beforeContentSections}
                useDefaultEditableBinding={!!effectiveBeforeProp}
              />
            )}
          </slot>
        </div>
      )
    }

    <div class="card-outer-content">
      <div
        class:list={[
          "card-content",
          "flow",
          "uses-spacing-utils",
          paddingHorizontal && `pad-x-${paddingHorizontal}`,
          paddingVertical && `pad-y-${paddingVertical}`,
          maxContentWidth && `max-width-${maxContentWidth}`,
        ]}
        {...arrayDataAttributes}
      >
        <slot>
          {
            contentSections && (
              <Component
                contentSections={contentSections}
                useDefaultEditableBinding={!!effectiveChildrenProp}
              />
            )
          }
        </slot>
      </div>
    </div>

    {
      (usesAfterContentSections || hasAfterSlot) && (
        <div
          class="after-content flow"
          {...arrayDataAttributesAfter}
        >
          <slot name="after">
            {afterContentSections && (
              <Component
                contentSections={afterContentSections}
                useDefaultEditableBinding={!!effectiveAfterProp}
              />
            )}
          </slot>
        </div>
      )
    }
  </Tag>
</div>

<style is:global>
  @layer components {
    .card {
      display: block;

      > a.card-inner:hover,
      > button.card-inner:hover {
        transform: scale(1.05);
      }

      /* A transformed ancestor becomes the containing block for its
         fixed-position children, which would cancel the parallax background
         mid-hover — so linked cards with one skip the hover scale. */
      > a.card-inner.background-fixed:hover,
      > button.card-inner.background-fixed:hover {
        transform: none;
      }

      /* The global reset only kills the transition, leaving the scale as an
         instant jump — the movement itself has to go. */
      @media (prefers-reduced-motion: reduce) {
        > a.card-inner:hover,
        > button.card-inner:hover {
          transform: none;
        }
      }

      > button.card-inner {
        appearance: none;
        background: none;
        cursor: pointer;
        font: inherit;
        padding: 0;
        text-align: inherit;
        width: 100%;
      }

      > .card-inner {
        color: inherit;
        display: block;
        height: 100%;
        overflow: hidden;
        position: relative;
        text-decoration: none;

        /* Themed cards with a media background get a solid theme-colored
           backing so text stays legible if the image/video fails to load or
           is still buffering. The media is a child painted on top, so this is
           invisible when it loads. */
        &[data-theme]:has(> .background-image),
        &[data-theme]:has(> .background-pattern),
        &[data-theme]:has(> .video.background) {
          background-color: var(--color-bg);
        }
        transition:
          transform var(--animation-normal) var(--ease-default),
          box-shadow var(--animation-normal) var(--ease-default);

        &.rounded {
          border-radius: var(--radius-md);
        }

        &.border {
          border: var(--border-width-sm) solid var(--color-border);
        }

        /* Parallax: the background image is pinned to the viewport and the card
           clips it with clip-path, because neither overflow nor border-radius
           clips a fixed-position child. clip-path itself does not create a
           containing block, so the image stays viewport-anchored. */
        &.background-fixed {
          clip-path: inset(0);

          > .background-image {
            position: fixed;
          }

          &.rounded {
            clip-path: inset(0 round var(--radius-md));
          }
        }

        > .card-outer-content {
          height: 100%;
          position: relative;
          z-index: var(--layer-2);

          > .card-content {
            container-type: inline-size;
            height: 100%;
            margin-inline: auto;
            position: relative;
            z-index: var(--layer-1);

            &.max-width-none {
              max-width: none;
            }

            &.max-width-xs {
              max-width: var(--content-width-xs);
            }

            &.max-width-sm {
              max-width: var(--content-width-sm);
            }

            &.max-width-md {
              max-width: var(--content-width-md);
            }

            &.max-width-lg {
              max-width: var(--content-width-lg);
            }

            &.max-width-xl {
              max-width: var(--content-width-xl);
            }

            &.max-width-2xl {
              max-width: var(--content-width-2xl);
            }

            &.max-width-3xl {
              max-width: var(--content-width-3xl);
            }
          }
        }

        > .before-content,
        > .after-content {
          position: relative;
          z-index: var(--layer-2);
        }

        > .background-overlay {
          inset: 0;
          position: absolute;
          z-index: var(--layer-1);
        }

        > .background {
          inset: 0;
          position: absolute;
        }

        > .background-image {
          z-index: var(--layer-1);
        }

        > .background-pattern {
          background-position: top left;
          background-repeat: repeat;
          inset: 0;
          position: absolute;
          z-index: var(--layer-1);

          &.pattern-size-natural {
            background-size: auto;
          }

          &.pattern-size-sm {
            background-size: 2rem auto;
          }

          &.pattern-size-md {
            background-size: 4rem auto;
          }

          &.pattern-size-lg {
            background-size: 8rem auto;
          }
        }

        > .video.background {
          z-index: var(--layer-1);
        }

        > .bg-base {
          background-color: var(--color-bg);
        }

        > .bg-surface {
          background-color: var(--color-bg-surface);
        }

        > .bg-accent {
          background-color: var(--color-bg-accent);
        }

        > .bg-highlight {
          background-color: var(--color-bg-highlight);
        }
      }
    }

    /* Parallax scrolling is a common vestibular trigger — fall back to a
       regular background image. */
    @media (prefers-reduced-motion: reduce) {
      .card > .card-inner.background-fixed > .background-image {
        position: absolute;
      }
    }
  }
</style>
