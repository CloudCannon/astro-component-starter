---
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import Button from "@core-elements/button/Button.astro";
import CarouselSlide from "./CarouselSlide.astro";
import { slugifyLabel } from "@components/utils/slugify";

type SlideProps = Record<string, unknown>;

const {
  slides = [],
  autoPlay = false,
  pauseOnHover = false,
  autoScroll = false,
  showIndicators = true,
  /** `"dots"` (default), `"fraction"` (e.g. `1/3`), or `"thumbnails"`. */
  indicatorStyle = "dots",
  showArrows = true,
  /** Slide shown first. Used by consumers that open the carousel at a chosen
   * item rather than always at snap 0. */
  startIndex = 0,
  loop = true,
  alignmentHorizontal = "center",
  slidesToScroll = "auto",
  slideWidthPercent = 100,
  minSlideWidth = 0,
  gap = "none",
  style = "",
  spaceBefore = "default",
  class: className,
  label,
  "data-children-prop": childrenDataProp,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

if (!htmlAttributes.id && label) {
  htmlAttributes.id = slugifyLabel(label);
}

const dataAttributes: Record<string, string> = {};

const effectiveShowIndicators = autoScroll ? false : showIndicators;
const effectiveShowArrows = autoScroll ? false : showArrows;

dataAttributes["data-show-indicators"] = String(effectiveShowIndicators);
dataAttributes["data-show-arrows"] = String(effectiveShowArrows);
dataAttributes["data-loop"] = String(loop);
dataAttributes["data-align"] = String(alignmentHorizontal);
dataAttributes["data-slides-to-scroll"] = String(slidesToScroll);
dataAttributes["data-start-index"] = String(Number(startIndex) || 0);

if (autoPlay) {
  dataAttributes["data-autoplay"] = "3";

  if (pauseOnHover) {
    dataAttributes["data-pause-on-hover"] = "true";
  }
}

if (autoScroll) {
  dataAttributes["data-autoscroll"] = "1";
}

const effectiveChildrenProp = childrenDataProp ?? (useDefaultEditableBinding ? "slides" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};

// A consumer's `class` must merge, not replace — a spread `class` attribute
// beats `class:list`, which would drop the `carousel` hook that setup.ts and
// every style rule key on. (ImageCarousel does the same.)
const slideGap = gap === "none" ? "0px" : `var(--spacing-${gap})`;

const carouselStyles = `
  --slide-width: ${slideWidthPercent}%;
  --min-slide-width: ${minSlideWidth}px;
  --slide-gap: ${slideGap};
  ${style}
`.trim();

const hasSlides = slides?.length > 0;
const hasSlotContent = Astro.slots.has("default");

if (!_component && !hasSlides && !hasSlotContent) return;
---

<section
  class:list={["carousel", "stackable", className]}
  role="region"
  aria-label={label || "Carousel"}
  {...htmlAttributes}
>
  <div
    class="carousel-inner"
    data-space-before={spaceBeforeAttr(spaceBefore)}
    style={carouselStyles}
    {...dataAttributes}
  >
    <div class="viewport">
      <div
        class="track"
        {...arrayDataAttributes}
      >
        <slot>
          {
            slides?.map((slide: SlideProps, index: number) => (
              <CarouselSlide
                {...slide}
                data-editable="array-item"
                data-id="building-blocks/wrappers/carousel/carousel-slide"
                useDefaultEditableBinding={!!effectiveChildrenProp}
                aria-label={`Slide ${index + 1} of ${slides.length}`}
              />
            ))
          }
        </slot>
      </div>
    </div>

    {
      (effectiveShowArrows || effectiveShowIndicators) && (
        <div class="controls-wrapper">
          {effectiveShowArrows && (
            <Button
              iconName="chevron-left"
              size="none"
              variant="tertiary"
              hideText={true}
              aria-label="Previous slide"
              class="prev"
              element="button"
            />
          )}

          {effectiveShowIndicators && indicatorStyle === "fraction" && (
            <div
              class="carousel-fraction"
              aria-live="polite"
              aria-atomic="true"
            />
          )}

          {effectiveShowIndicators && indicatorStyle === "dots" && <div class="indicators" />}

          {effectiveShowArrows && (
            <Button
              iconName="chevron-right"
              size="none"
              variant="tertiary"
              hideText={true}
              aria-label="Next slide"
              class="next"
              element="button"
            />
          )}
        </div>
      )
    }

    {
      /* Thumbnails are a full-width strip under the controls rather than an
         item between the arrows — a row of images can't share that flex line.
         setup.ts fills it from each snap's own <img>. */
      effectiveShowIndicators && indicatorStyle === "thumbnails" && (
        <div class="carousel-thumbnails" />
      )
    }
  </div>
</section>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllCarousels } from "./setup";

  onPageLoad(() => setupAllCarousels());
</script>

<style is:global>
  @layer components {
    .carousel {
      --carousel-arrow-icon-size: 18px;
      --carousel-dot-size: 8px;
      --carousel-thumb-width: 4rem;
      --carousel-thumb-height: 3rem;

      width: 100%;

      > .carousel-inner {
        position: relative;
        --slide-width: 100%;
        --min-slide-width: 0px;
        --slide-gap: 0px;

        > .viewport {
          overflow: hidden;
          position: relative;
          width: 100%;
        }

        &[data-autoscroll] > .viewport {
          -webkit-mask-image: linear-gradient(
            to right,
            transparent,
            black var(--spacing-sm),
            black calc(100% - var(--spacing-sm)),
            transparent
          );
          mask-image: linear-gradient(
            to right,
            transparent,
            black var(--spacing-sm),
            black calc(100% - var(--spacing-sm)),
            transparent
          );
        }

        > .viewport > .track {
          display: flex;
          flex-wrap: nowrap;
          margin-inline-start: calc(var(--slide-gap) * -1);

          > .slide {
            flex-basis: calc(max(var(--slide-width, 100%), var(--min-slide-width, 0px)));
            flex-shrink: 0;
            padding-inline-start: var(--slide-gap);
            width: 100%;
          }
        }

        > .controls-wrapper {
          align-items: center;
          display: flex;
          gap: var(--spacing-md);
          justify-content: center;
          margin-bottom: var(--spacing-sm);
          margin-top: var(--spacing-sm);

          svg {
            width: var(--carousel-arrow-icon-size);
            height: var(--carousel-arrow-icon-size);
          }
        }

        > .controls-wrapper > .prev > .button-inner,
        > .controls-wrapper > .next > .button-inner {
          background-color: var(--color-bg);
          border-radius: var(--radius-full);
          flex-shrink: 0;
          pointer-events: auto;

          &:hover {
            background-color: var(--color-bg-surface);
          }
        }

        > .controls-wrapper > .indicators {
          display: flex;
          gap: var(--spacing-sm);
          justify-content: center;
        }

        > .controls-wrapper > .carousel-pause {
          background: none;
          border: none;
          color: var(--color-text-muted);
          cursor: pointer;
          font-size: var(--font-size-xs);
          font-weight: var(--font-weight-semibold);
          letter-spacing: 0.08em;
          padding: 0;
          text-transform: uppercase;

          &:hover {
            color: var(--color-text);
          }
        }

        > .controls-wrapper > .indicators > .indicator {
          aspect-ratio: 1/1;
          background-color: var(--color-border);
          border: none;
          border-radius: var(--radius-full);
          cursor: pointer;
          min-height: 0;
          min-width: 0;
          padding: 0;
          transition:
            transform var(--animation-normal) var(--ease-default),
            background-color var(--animation-normal) var(--ease-default);
          width: var(--carousel-dot-size);

          &:focus-visible {
            outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
            outline-offset: 2px;
          }

          &[data-selected="true"] {
            background-color: var(--color-brand-muted);
            transform: scale(1.2);
          }
        }

        &[data-show-indicators="false"] {
          > .controls-wrapper > .indicators,
          > .controls-wrapper > .carousel-fraction,
          > .carousel-thumbnails {
            display: none;
          }
        }

        > .carousel-thumbnails {
          display: flex;
          gap: var(--spacing-sm);
          justify-content: center;
          margin-top: var(--spacing-sm);
          overflow-x: auto;
          padding-bottom: var(--spacing-xs);

          > .carousel-thumbnail {
            background: none;
            border: var(--border-width-sm) solid var(--color-border);
            border-radius: var(--radius-xs);
            color: var(--color-text-muted);
            cursor: pointer;
            flex: none;
            font-size: var(--font-size-xs);
            height: var(--carousel-thumb-height);
            overflow: hidden;
            padding: 0;
            transition:
              border-color var(--animation-fast) var(--ease-out),
              opacity var(--animation-fast) var(--ease-out);
            width: var(--carousel-thumb-width);

            > img {
              display: block;
              height: 100%;
              object-fit: cover;
              width: 100%;
            }

            &[data-selected="false"] {
              opacity: 0.6;
            }

            &[data-selected="true"] {
              border-color: var(--color-border-strong);
            }

            &:hover {
              opacity: 1;
            }
          }
        }

        > .controls-wrapper > .carousel-fraction {
          color: var(--color-text-muted);
          flex-shrink: 0;
          font-size: var(--font-size-sm);
          font-variant-numeric: tabular-nums;
          line-height: var(--line-height-tight);
          min-width: 3ch;
          text-align: center;
        }

        &[data-show-arrows="false"] {
          .controls-wrapper > .prev,
          .controls-wrapper > .next {
            display: none !important;
          }
        }
      }
    }
  }
</style>
