---
import { slugifyLabel } from "@component-utils/slugify";
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import Tabs from "@component-utils/tabs/Tabs.astro";
import type { ContentSelectorItem } from "../../../../types";
import ContentSelectorPanel from "./ContentSelectorPanel.astro";

const {
  items = [] as ContentSelectorItem[],
  navigationPosition = "start",
  spaceBefore = "default",
  class: className,
  label,
  useDefaultEditableBinding = false,
  "data-children-prop": childrenDataProp,
  _component,
  ...htmlAttributes
} = Astro.props;

if (!htmlAttributes.id && label) {
  htmlAttributes.id = slugifyLabel(label);
}

const firstTitle = (items as ContentSelectorItem[])?.[0]?.title;
const groupKey =
  htmlAttributes.id || (firstTitle && slugifyLabel(firstTitle)) || crypto.randomUUID();
const groupName = `tabs-${groupKey}`;

const effectiveChildrenProp = childrenDataProp ?? (useDefaultEditableBinding ? "items" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};

const hasItems = items?.length > 0;
const hasSlotContent = Astro.slots.has("default");

if (!_component && !hasItems && !hasSlotContent) return;
---

<section
  class:list={["content-selector", "stackable", className]}
  {...htmlAttributes}
>
  <Tabs
    class:list={["content-selector-items", `nav-${navigationPosition}`]}
    data-space-before={spaceBeforeAttr(spaceBefore)}
    {...arrayDataAttributes}
  >
    <slot>
      {items?.map((item: ContentSelectorItem, index: number) => (
        <ContentSelectorPanel
          title={item.title}
          subtext={item.subtext}
          iconName={item.iconName}
          iconColor={item.iconColor}
          contentSections={item.contentSections}
          _component={item._component}
          selected={index === 0}
          groupName={groupName}
          navigationPosition={navigationPosition}
          tablistLabel={label}
          useDefaultEditableBinding={!!effectiveChildrenProp}
          data-id="building-blocks/wrappers/content-selector/content-selector-panel"
          data-editable="array-item"
        />
      ))}
    </slot>
  </Tabs>
</section>

<style is:global>
  @layer components {
    .content-selector {
      --content-selector-border-width: 1px;
      container: content-selector / inline-size;

      > .content-selector-items {
        width: 100%;

        &:not(:has(.content-selector-item .content-selector-tab[aria-selected="true"]))
          .content-selector-item:first-of-type
          > .content-selector-tablist
          > .content-selector-tab::before {
          background: var(--color-border-strong);
        }

        &:not(:has(.content-selector-item .content-selector-tab[aria-selected="true"]))
          .content-selector-item:first-of-type
          > .content-selector-panel {
          display: block;
        }

        &.nav-start {
          column-gap: var(--spacing-em-lg);
          display: grid;
          grid-template-columns: minmax(min-content, max-content) minmax(0, 1fr);
          /* The count is static because this is the array region root: an item-count
             value would go stale when the editor adds one. Empty `auto` rows collapse. */
          grid-template-rows: repeat(12, auto) 1fr;

          .content-selector-tablist {
            grid-column: 1;
          }

          .content-selector-tab {
            border-inline-start: var(--content-selector-border-width) solid var(--color-bg-muted);

            &::before {
              inset-block: 0;
              inset-inline-start: calc(var(--content-selector-border-width) * -1);
              width: var(--content-selector-border-width);
            }
          }

          /* Row from `:nth-of-type`, not a prop, so a reorder or single-item re-render
             can't leave a stale index. */
          .content-selector-item:nth-of-type(1) > .content-selector-tablist {
            grid-row: 1;
          }

          .content-selector-item:nth-of-type(2) > .content-selector-tablist {
            grid-row: 2;
          }

          .content-selector-item:nth-of-type(3) > .content-selector-tablist {
            grid-row: 3;
          }

          .content-selector-item:nth-of-type(4) > .content-selector-tablist {
            grid-row: 4;
          }

          .content-selector-item:nth-of-type(5) > .content-selector-tablist {
            grid-row: 5;
          }

          .content-selector-item:nth-of-type(6) > .content-selector-tablist {
            grid-row: 6;
          }

          .content-selector-item:nth-of-type(7) > .content-selector-tablist {
            grid-row: 7;
          }

          .content-selector-item:nth-of-type(8) > .content-selector-tablist {
            grid-row: 8;
          }

          .content-selector-item:nth-of-type(9) > .content-selector-tablist {
            grid-row: 9;
          }

          .content-selector-item:nth-of-type(10) > .content-selector-tablist {
            grid-row: 10;
          }

          .content-selector-item:nth-of-type(11) > .content-selector-tablist {
            grid-row: 11;
          }

          .content-selector-item:nth-of-type(12) > .content-selector-tablist {
            grid-row: 12;
          }

          .content-selector-panel {
            grid-column: 2;
            grid-row: 1 / -1;
            padding: 0 var(--spacing-md);
            width: 100%;
          }
        }

        &.nav-top {
          display: grid;
          /* Flexible side tracks center the tabs; `justify-content` would move line 1,
             which the `1 / -1` panel needs at the container's true edge. */
          grid-template-columns: minmax(0, 1fr) repeat(12, minmax(max-content, auto)) minmax(
              0,
              1fr
            );
          grid-template-rows: auto auto;
          overflow-x: auto;
          scroll-snap-type: x proximity;

          /* No column-gap, so the tabs' underlines abut; this rail extends them to both edges. */
          &::before {
            align-self: end;
            background: var(--color-bg-muted);
            content: "";
            grid-column: 1 / -1;
            grid-row: 1;
            height: var(--content-selector-border-width);
          }

          .content-selector-item:nth-of-type(1) > .content-selector-tablist {
            grid-column: 2;
          }

          .content-selector-item:nth-of-type(2) > .content-selector-tablist {
            grid-column: 3;
          }

          .content-selector-item:nth-of-type(3) > .content-selector-tablist {
            grid-column: 4;
          }

          .content-selector-item:nth-of-type(4) > .content-selector-tablist {
            grid-column: 5;
          }

          .content-selector-item:nth-of-type(5) > .content-selector-tablist {
            grid-column: 6;
          }

          .content-selector-item:nth-of-type(6) > .content-selector-tablist {
            grid-column: 7;
          }

          .content-selector-item:nth-of-type(7) > .content-selector-tablist {
            grid-column: 8;
          }

          .content-selector-item:nth-of-type(8) > .content-selector-tablist {
            grid-column: 9;
          }

          .content-selector-item:nth-of-type(9) > .content-selector-tablist {
            grid-column: 10;
          }

          .content-selector-item:nth-of-type(10) > .content-selector-tablist {
            grid-column: 11;
          }

          .content-selector-item:nth-of-type(11) > .content-selector-tablist {
            grid-column: 12;
          }

          .content-selector-item:nth-of-type(12) > .content-selector-tablist {
            grid-column: 13;
          }

          .content-selector-tablist {
            grid-row: 1;
            scroll-snap-align: start;
          }

          .content-selector-tab {
            &::before {
              background: var(--color-bg-muted);
              height: var(--content-selector-border-width);
              /* `inset-block-end: 0`, not `inset-block: 100%`, which renders a pixel below
                 the rail instead of over it. */
              inset-block-end: 0;
              inset-inline-start: 0;
              width: 100%;
            }
          }

          .content-selector-tab[aria-selected="true"]::before {
            background: var(--color-border-strong);
          }

          /*
           * Keep the panel out of grid column sizing by giving it width: 0
           * and letting its inner content (which has width: 100cqi and
           * position: sticky) render over the full visible container width.
           * This lets the tabs row size to its labels and scroll naturally.
            * `contain: layout` is load-bearing: without it, track sizing still measures
            * this item by its 100cqi child despite `width: 0`.
           */
          .content-selector-panel {
            contain: layout;
            container-type: normal;
            grid-column: 1 / -1;
            grid-row: 2;
            overflow: visible;
            width: 0;
          }

          .content-selector-panel-content {
            inset-inline-start: 0;
            margin-top: var(--spacing-md);
            padding: 0 var(--spacing-md);
            position: sticky;
            width: 100cqi;
          }
        }

        @container content-selector (width < 640px) {
          &.nav-start,
          &.nav-top {
            column-gap: 0;
            display: block;
            overflow-x: visible;
            scroll-snap-type: none;

            /* Stacked, not overlaid: the item takes its own clicks again. */
            .content-selector-item {
              display: block;
              pointer-events: auto;
            }

            /* The baseline grid item would add a line box of height in block layout. */
            &::before {
              content: none;
            }

            .content-selector-tab {
              align-items: center;
              border-block-start: var(--content-selector-border-width) solid var(--color-bg-muted);
              border-inline-start: 0;
              display: flex;
              gap: var(--spacing-sm);
              justify-content: space-between;
              padding: var(--spacing-sm) var(--spacing-md);
              scroll-snap-align: none;
              width: 100%;

              &::before {
                content: none;
              }
            }

            .content-selector-item:last-of-type .content-selector-tab {
              border-block-end: var(--content-selector-border-width) solid var(--color-bg-muted);
            }

            .content-selector-input:checked + .content-selector-tab {
              background: var(--color-state-hover);

              .content-selector-tab-chevron {
                transform: rotate(180deg);
              }
            }

            .content-selector-tab-chevron {
              display: block;
            }

            .content-selector-tab-subtext {
              display: none;
            }

            .content-selector-panel {
              container-type: inline-size;
              grid-column: auto;
              grid-row: auto;
              overflow: visible;
              padding: var(--spacing-sm) var(--spacing-md) var(--spacing-md);
              width: 100%;
            }

            .content-selector-panel-content {
              inset-inline-start: auto;
              margin-top: 0;
              padding: 0;
              position: static;
              width: auto;
            }
          }
        }
      }
    }
  }
</style>
