---
import RenderBlock from "@component-utils/renderBlock.astro";
import { slugifyLabel } from "@component-utils/slugify";
import Tab from "@component-utils/tabs/Tab.astro";
import TabPanel from "@component-utils/tabs/TabPanel.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";

const {
  title,
  subtext,
  iconName,
  iconColor,
  contentSections,
  useDefaultEditableBinding = false,
  selected = false,
  groupName = "content-selector-tabs",
  navigationPosition = "start",
  class: className,
  _component,
  "data-children-prop": childrenDataProp,
  "data-prop-title": customDataPropTitle,
  "data-prop-subtext": customDataPropSubtext,
  ...htmlAttributes
} = Astro.props;

const uniqueId = title ? `${groupName}-${slugifyLabel(title)}` : crypto.randomUUID();
const panelId = `panel-${uniqueId}`;
const tabLabelId = `tablabel-${uniqueId}`;

const effectiveChildrenProp =
  childrenDataProp ?? (useDefaultEditableBinding ? "contentSections" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};

const effectiveTitleProp = customDataPropTitle ?? (useDefaultEditableBinding ? "title" : null);
const effectiveSubtextProp =
  customDataPropSubtext ?? (useDefaultEditableBinding ? "subtext" : null);
const subtextDataAttributes = effectiveSubtextProp
  ? { "data-editable": "text", "data-prop": effectiveSubtextProp }
  : {};
---

<div
  class:list={["content-selector-item", className]}
  {...htmlAttributes}
>
  <Tab
    class="content-selector-tab"
    id={tabLabelId}
    controls={panelId}
    selected={selected}
  >
    {
      /* `level="span"`, not a real heading: a tab label is not a section title,
        and an h3 per tab injects the whole tab strip into the page outline. */
    }
    <Heading
      text={title}
      level="span"
      size="sm"
      iconName={iconName}
      iconColor={iconColor}
      alignmentHorizontal={navigationPosition === "top" ? "center" : "start"}
      class="content-selector-tab-heading"
      data-prop={effectiveTitleProp}
    />
    {
      subtext && (
        <span
          class:list={[
            "content-selector-tab-subtext",
            `align-${navigationPosition === "top" ? "center" : "start"}`,
          ]}
          {...subtextDataAttributes}
        >
          {subtext}
        </span>
      )
    }
    <Icon
      name="chevron-down"
      size="none"
      class="content-selector-tab-chevron"
      aria-hidden="true"
    />
  </Tab>
  <TabPanel
    class="content-selector-panel"
    id={panelId}
    labelledBy={tabLabelId}
    selected={selected}
  >
    <div
      class="content-selector-panel-content flow"
      {...arrayDataAttributes}
    >
      <slot>
        {
          contentSections && (
            <RenderBlock
              contentSections={contentSections}
              useDefaultEditableBinding={!!effectiveChildrenProp}
            />
          )
        }
      </slot>
    </div>
  </TabPanel>
</div>

<style is:global>
  @layer components {
    /*
     * Each item overlays the WHOLE items grid and re-exposes the parent's
     * tracks with `subgrid`, so its tab and its panel land in different grid
     * areas while the item itself stays one real box. It has to be a box: this
     * is the array-item region root, and `display: contents` leaves the editor
     * nothing to select or drag. Overlapping boxes would swallow each other's
     * clicks, hence pointer-events passing through to the children.
     * The tab's own row/column comes from `:nth-of-type` in ContentSelector.
     */
    .content-selector-item {
      display: grid;
      grid-area: 1 / 1 / -1 / -1;
      grid-template-columns: subgrid;
      grid-template-rows: subgrid;
      pointer-events: none;

      > * {
        pointer-events: auto;
      }
    }

    .content-selector-tab {
      background: transparent;
      border: none;
      cursor: pointer;
      display: block;
      padding: var(--spacing-md);
      position: relative;
      transition: background-color var(--animation-normal) var(--ease-in-out);

      &::before {
        background: transparent;
        content: "";
        position: absolute;
        transition:
          transform var(--animation-normal),
          background var(--animation-normal);
      }

      &:hover {
        background: var(--color-state-hover);
      }

      > .content-selector-tab-heading {
        margin: 0;
      }
    }

    .content-selector-tab-subtext {
      color: var(--color-text-muted);
      display: block;
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-normal);
      margin-top: var(--spacing-xs);

      &.align-center {
        text-align: center;
      }

      &.align-start {
        text-align: start;
      }
    }

    .content-selector-tab-chevron {
      display: none;
      flex: 0 0 auto;
      transition: transform var(--animation-normal) var(--ease-out);
    }

    .content-selector-tab[aria-selected="true"]::before {
      background: var(--color-border-strong);
    }

    .content-selector-panel {
      animation: fade-in var(--animation-slow) var(--ease-in-out) forwards;
      container-type: inline-size;
      display: block;

      &[hidden] {
        display: none;
      }
    }
  }
</style>
