---
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import { slugifyLabel } from "@components/utils/slugify";
import GridItem from "./GridItem.astro";

type ItemProps = Record<string, unknown>;

const {
  columns = "auto",
  minItemWidth = 200,
  maxItemWidth,
  spaceBefore = "default",
  class: className,
  style: userStyle,
  items = [],
  label,
  gap = "md",
  useDefaultEditableBinding = false,
  _component,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = Astro.props;

if (!htmlAttributes.id && label) {
  htmlAttributes.id = slugifyLabel(label);
}

const columnCount = columns === "auto" ? null : Number(columns);

const gridStyles = [
  columnCount ? `--grid-columns: ${columnCount}` : `--min-item-width: ${minItemWidth}px`,
  !columnCount && maxItemWidth ? `--max-item-width: ${maxItemWidth}px` : null,
  `--grid-spacing: ${gap === "none" ? "0px" : `var(--spacing-${gap})`}`,
  userStyle,
]
  .filter(Boolean)
  .join("; ");

const effectiveChildrenProp = childrenDataProp ?? (useDefaultEditableBinding ? "items" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp, "data-direction": "row" }
  : {};

const hasItems = items?.length > 0;
const hasSlotContent = Astro.slots.has("default");

if (!_component && !hasItems && !hasSlotContent) return;
---

<div
  class:list={["grid", "stackable", className]}
  {...htmlAttributes}
>
  <div
    data-space-before={spaceBeforeAttr(spaceBefore)}
    {...arrayDataAttributes}
    class:list={["grid-inner", columnCount ? "columns-fixed" : "columns-auto"]}
    style={gridStyles}
  >
    <slot>
      {
        items?.map((item: ItemProps) => (
          <GridItem
            data-id="building-blocks/wrappers/grid/grid-item"
            data-editable="array-item"
            useDefaultEditableBinding={!!effectiveChildrenProp}
            {...item}
          />
        ))
      }
    </slot>
  </div>
</div>

<style is:global>
  @layer components {
    .grid {
      --space-before: var(--space-before-loose);
      container-type: inline-size;
      width: 100%;

      > .grid-inner {
        display: grid;
        gap: var(--grid-spacing, var(--spacing-md));
        width: 100%;

        &.columns-auto {
          grid-template-columns: repeat(
            auto-fill,
            minmax(min(var(--min-item-width, 200px), 100%), var(--max-item-width, 1fr))
          );
          /* Only visible when --max-item-width caps the tracks: a few capped
             items sit centered (the old layout=center look), not left-hugged. */
          justify-content: center;
        }

        /* Container-queried, so a Grid in a narrow pane on a wide screen
           still collapses to one column. */
        &.columns-fixed {
          grid-template-columns: minmax(0, 1fr);

          @container (width >= 640px) {
            grid-template-columns: repeat(var(--grid-columns, 3), minmax(0, 1fr));
          }
        }

        > * {
          min-width: 0;
        }
      }
    }
  }
</style>
