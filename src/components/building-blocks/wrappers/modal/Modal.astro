---
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import Component from "@component-utils/renderBlock.astro";
import { slugifyLabel } from "@component-utils/slugify";
import { uniqueId } from "@component-utils/uniqueId";
import Button from "@core-elements/button/Button.astro";
import ModalShell from "./ModalShell.astro";

const {
  label,
  heading,
  headingLevel = "h2",
  triggerText,
  triggerVariant = "primary",
  triggerSize = "md",
  triggerIconName,
  popoverId: providedPopoverId,
  size = "md",
  sheet = true,
  contentSections,
  useDefaultEditableBinding = false,
  spaceBefore = "default",
  class: className,
  "data-children-prop": childrenDataProp,
  "data-prop-heading": customDataPropHeading,
  "data-prop-trigger-text": customDataPropTriggerText,
  _component,
  ...htmlAttributes
} = Astro.props;

// Must be unique: two modals sharing a heading or trigger text derive the same base.
const HeadingTag = headingLevel;
const derivedLabel = label || heading || triggerText;
const popoverId =
  providedPopoverId ||
  uniqueId(Astro.request, `modal-${derivedLabel ? slugifyLabel(derivedLabel) : "dialog"}`);

const effectiveChildrenProp =
  childrenDataProp ?? (useDefaultEditableBinding ? "contentSections" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};
const effectiveHeadingProp =
  customDataPropHeading ?? (useDefaultEditableBinding ? "heading" : null);
const headingDataAttributes = effectiveHeadingProp
  ? { "data-editable": "text", "data-prop": effectiveHeadingProp }
  : {};

const effectiveTriggerTextProp =
  customDataPropTriggerText ?? (useDefaultEditableBinding ? "triggerText" : null);

const hasHeading = heading?.trim().length > 0;
const hasContentSections = contentSections?.length > 0;
const hasSlotContent = Astro.slots.has("default");
const hasTrigger = triggerText?.trim().length > 0 || triggerIconName?.trim().length > 0;

if (!_component && !hasContentSections && !hasSlotContent) return;
---

<div
  class:list={["modal", "stackable", className]}
  {...htmlAttributes}
>
  {
    /* Branch on the trigger props, not `Astro.slots.has`: a falsy conditional slot still
       reports present. A slotted trigger must render inside this root or it leaves the array item. */
    hasTrigger ? (
      <Button
        text={triggerText}
        variant={triggerVariant}
        size={triggerSize}
        iconName={triggerIconName}
        link={`^${popoverId}`}
        class="modal-trigger"
        data-prop={effectiveTriggerTextProp}
        aria-haspopup="dialog"
        aria-expanded="false"
      />
    ) : (
      <slot name="trigger" />
    )
  }

  <ModalShell
    data-space-before={spaceBeforeAttr(spaceBefore)}
    popoverId={popoverId}
    size={size}
    sheet={sheet}
    label={hasHeading ? undefined : label}
    labelledby={hasHeading ? `${popoverId}-header` : undefined}
  >
    <div class:list={["modal-header", hasHeading ? "has-header" : "no-header"]}>
      {hasHeading && (
        <HeadingTag
          id={`${popoverId}-header`}
          class="modal-title"
          {...headingDataAttributes}
        >
          {heading}
        </HeadingTag>
      )}
      <Button
        iconName="x-mark"
        hideText
        text="Close"
        variant="ghost"
        size="lg"
        class="modal-close"
        popovertarget={popoverId}
        popovertargetaction="hide"
      />
    </div>
    <div
      class="modal-body flow"
      {...arrayDataAttributes}
    >
      <slot>
        {contentSections && (
          <Component
            contentSections={contentSections}
            useDefaultEditableBinding={!!effectiveChildrenProp}
          />
        )}
      </slot>
    </div>
  </ModalShell>
</div>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllModals } from "./setup";

  onPageLoad(() => setupAllModals());
</script>

<style is:global>
  @layer components {
    .modal {
      display: inline-flex;
    }

    .modal-header {
      align-items: center;
      display: flex;
      gap: var(--spacing-md);
      z-index: var(--layer-2);
    }

    .modal-header.has-header {
      background-color: var(--color-bg-surface);
      flex-shrink: 0;
      justify-content: space-between;
      padding: var(--spacing-sm);
    }

    .modal-header.no-header {
      flex-shrink: 0;
      height: 0;
      padding: 0;
      position: relative;
      z-index: var(--layer-2);
    }

    .modal-header.no-header .modal-close {
      position: absolute;
      right: var(--spacing-sm);
      top: var(--spacing-sm);
      z-index: var(--layer-2);
    }

    .modal-title {
      flex: 1;
      font-size: var(--font-size-heading-sm);
      margin: 0;
      padding: 0 var(--spacing-md);
    }

    .modal-body {
      flex: 1;
      overflow-y: auto;
    }
  }
</style>
