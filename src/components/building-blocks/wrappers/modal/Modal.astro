---
import Component from "@components/utils/renderBlock.astro";
import { slugifyLabel } from "@components/utils/slugify";
import Button from "@core-elements/button/Button.astro";
import ModalShell from "./ModalShell.astro";

const {
  label,
  heading,
  triggerText,
  triggerVariant = "primary",
  triggerSize = "md",
  triggerIconName,
  size = "md",
  contentSections,
  useDefaultEditableBinding = false,
  class: className,
  "data-children-prop": childrenDataProp,
  _component,
  ...htmlAttributes
} = Astro.props;

const generatedLabel = label || heading || `Modal-${crypto.randomUUID()}`;
const popoverId = `modal-${slugifyLabel(generatedLabel)}`;

const effectiveChildrenProp =
  childrenDataProp ?? (useDefaultEditableBinding ? "contentSections" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};
const headingDataAttributes = useDefaultEditableBinding
  ? { "data-editable": "text", "data-prop": "heading" }
  : {};

const hasHeading = heading?.trim().length > 0;
const hasContentSections = contentSections?.length > 0;
const hasSlotContent = Astro.slots.has("default");
const hasTrigger = triggerText?.trim().length > 0 || triggerIconName?.trim().length > 0;

if (!_component && !hasContentSections && !hasSlotContent) return;
---

<div
  class:list={["modal", className]}
  {...htmlAttributes}
>
  {
    hasTrigger && (
      <Button
        text={triggerText}
        variant={triggerVariant}
        size={triggerSize}
        iconName={triggerIconName}
        link={`^${popoverId}`}
        class="modal-trigger"
      />
    )
  }

  <ModalShell
    popoverId={popoverId}
    size={size}
    label={hasHeading ? undefined : label}
    labelledby={hasHeading ? `${popoverId}-header` : undefined}
  >
    <div class:list={["modal-header", hasHeading ? "has-header" : "no-header"]}>
      {
        hasHeading && (
          <h2
            id={`${popoverId}-header`}
            class="modal-title"
            {...headingDataAttributes}
          >
            {heading}
          </h2>
        )
      }
      <Button
        iconName="x-mark"
        hideText
        text="Close"
        variant="ghost"
        size="lg"
        class="modal-close"
        popovertarget={popoverId}
        popovertargetaction="hide"
      />
    </div>
    <div
      class="modal-body"
      {...arrayDataAttributes}
    >
      <slot>
        {
          contentSections && (
            <Component
              contentSections={contentSections}
              useDefaultEditableBinding={!!effectiveChildrenProp}
            />
          )
        }
      </slot>
    </div>
  </ModalShell>
</div>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllModals } from "./setup";

  onPageLoad(() => setupAllModals());
</script>

<style is:global>
  @layer components {
    .modal {
      display: inline-flex;
      margin-top: var(--spacing-lg);
    }

    .modal-header {
      align-items: center;
      display: flex;
      gap: var(--spacing-md);
      z-index: var(--layer-2);
    }

    .modal-header.has-header {
      background-color: var(--color-bg-surface);
      flex-shrink: 0;
      justify-content: space-between;
      padding: var(--spacing-sm);
    }

    .modal-header.no-header {
      flex-shrink: 0;
      height: 0;
      padding: 0;
      position: relative;
      z-index: var(--layer-2);
    }

    .modal-header.no-header .modal-close {
      position: absolute;
      right: var(--spacing-sm);
      top: var(--spacing-sm);
      z-index: var(--layer-2);
    }

    .modal-title {
      flex: 1;
      font-size: var(--font-size-heading-sm);
      margin: 0;
      padding: 0 var(--spacing-md);
    }

    .modal-body {
      flex: 1;
      overflow-y: auto;

      > *:first-child {
        margin-top: 0 !important;
      }

      > *:last-child {
        margin-bottom: 0 !important;
      }
    }
  }
</style>
