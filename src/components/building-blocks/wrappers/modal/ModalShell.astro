---
// `setup.ts` targets `[data-modal]`; `.modal-popover` is styling only, dropped by `sheet={false}`.
const {
  popoverId,
  size = "md",
  label,
  labelledby,
  fullScreenMobile = false,
  sheet = true,
  class: className,
  ...htmlAttributes
} = Astro.props;
---

<div
  id={popoverId}
  popover="auto"
  data-modal
  class:list={[
    sheet && "modal-popover",
    `size-${size}`,
    sheet && fullScreenMobile && "fullscreen-mobile",
    className,
  ]}
  role="dialog"
  aria-modal="true"
  aria-label={label}
  aria-labelledby={labelledby}
  {...htmlAttributes}
>
  <slot />
</div>

<style is:global>
  @layer components {
    .modal-popover {
      background-color: var(--color-bg);
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: var(--radius-xs);
      box-shadow: var(--shadow-lg);
      color: var(--color-text);
      /* Auto margins centre in the top layer; a real margin breaks it (see ARCHITECTURE.md). */
      inset: 0;
      margin: auto;
      max-height: 85vh;
      overflow: hidden;
      padding: 0;
      width: 90vw;

      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity var(--animation-normal) var(--ease-out),
        transform var(--animation-normal) var(--ease-out),
        overlay var(--animation-normal) var(--ease-out) allow-discrete,
        display var(--animation-normal) var(--ease-out) allow-discrete;

      &:popover-open {
        display: flex;
        flex-direction: column;
        opacity: 1;
        transform: translateY(0);

        @starting-style {
          opacity: 0;
          transform: translateY(16px);
        }
      }

      &::backdrop {
        background-color: var(--color-overlay);
        opacity: 0;
        transition:
          opacity var(--animation-normal) var(--ease-out),
          overlay var(--animation-normal) var(--ease-out) allow-discrete,
          display var(--animation-normal) var(--ease-out) allow-discrete;
      }

      &:popover-open::backdrop {
        opacity: 1;

        @starting-style {
          opacity: 0;
        }
      }

      &.size-sm {
        max-width: var(--content-width-sm);
      }

      &.size-md {
        max-width: var(--content-width-md);
      }

      &.size-lg {
        max-width: var(--content-width-lg);
      }

      &.size-xl {
        max-width: var(--content-width-xl);
      }

      @media (max-width: 639px) {
        &.fullscreen-mobile {
          border: none;
          border-radius: 0;
          height: 100dvh;
          max-height: none;
          max-width: none;
          width: 100vw;
        }
      }
    }
  }
</style>
