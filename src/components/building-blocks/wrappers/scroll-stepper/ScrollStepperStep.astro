---
import Component from "@component-utils/renderBlock.astro";
import type { ContentBlock } from "../../../../types";

const {
  mediaSections: _mediaSections = [],
  contentSections = [],
  useDefaultEditableBinding = false,
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const contentBlocks: ContentBlock[] = Array.isArray(contentSections) ? contentSections : [];
const contentDataAttributes = useDefaultEditableBinding
  ? { "data-editable": "array", "data-prop": "contentSections" }
  : {};
---

<div
  class:list={["scroll-stepper-step", className]}
  {...htmlAttributes}
>
  <div
    class="scroll-stepper-step-content flow"
    {...contentDataAttributes}
  >
    <Component
      contentSections={contentBlocks}
      useDefaultEditableBinding={useDefaultEditableBinding}
    />
  </div>
</div>
