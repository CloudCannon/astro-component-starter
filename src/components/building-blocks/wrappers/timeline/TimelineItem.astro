---
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import { isNonEmptyString } from "@component-utils/isNonEmptyString";

const {
  year: _year = "",
  date = "",
  title = "",
  body = "",
  iconName = "",
  layout = "vertical",
  grouped = false,
  headingLevel = "h3",
  useDefaultEditableBinding = false,
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const hasTitle = isNonEmptyString(title);
const hasBody = isNonEmptyString(body);
const hasDate = isNonEmptyString(date);
const isHorizontal = layout === "horizontal";
const isSplit = layout === "split";

const dateBinding =
  useDefaultEditableBinding && hasDate ? { "data-editable": "text", "data-prop": "date" } : {};
---

<li
  class:list={["timeline-entry", className]}
  {...htmlAttributes}
>
  {isSplit ? (
    <>
      <div class="timeline-split-content">
        {hasDate && (
          <span
            class="timeline-date"
            {...dateBinding}
          >
            {date}
          </span>
        )}
        {hasTitle && (
          <Heading
            class="timeline-title"
            level={headingLevel}
            size="xs"
            data-prop={useDefaultEditableBinding ? "title" : undefined}
          >
            {title}
          </Heading>
        )}
        {hasBody && (
          <SimpleText
            class="timeline-body"
            size="sm"
            data-prop={useDefaultEditableBinding ? "body" : undefined}
            text={body}
          />
        )}
      </div>
      <span
        class="timeline-split-marker"
        aria-hidden="true"
      >
        {isNonEmptyString(iconName) ? (
          <Icon
            name={iconName}
            size="sm"
          />
        ) : (
          <span class="timeline-dot" />
        )}
      </span>
    </>
  ) : isHorizontal ? (
    hasDate && (
      <div
        class="timeline-label"
        {...dateBinding}
      >
        {date}
      </div>
    )
  ) : grouped ? (
    <>
      {hasDate && (
        <span
          class="timeline-month"
          {...dateBinding}
        >
          {date}
        </span>
      )}
      <span
        class="timeline-dot"
        aria-hidden="true"
      />
    </>
  ) : (
    <span
      class="timeline-date"
      {...dateBinding}
    >
      {date}
    </span>
  )}
  {!isSplit && isHorizontal ? (
    <div
      class="timeline-band"
      aria-hidden="true"
    >
      <span class="timeline-dot" />
    </div>
  ) : (
    !grouped && (
      <div class="timeline-content">
        <span
          class="timeline-dot"
          aria-hidden="true"
        />
        {hasTitle && (
          <Heading
            class="timeline-title"
            level={headingLevel}
            size="xs"
            data-prop={useDefaultEditableBinding ? "title" : undefined}
          >
            {title}
          </Heading>
        )}
        {hasBody && (
          <SimpleText
            class="timeline-body"
            size="sm"
            data-prop={useDefaultEditableBinding ? "body" : undefined}
            text={body}
          />
        )}
      </div>
    )
  )}
  {!isSplit && (isHorizontal || grouped) && hasTitle && (
    <Heading
      class="timeline-title"
      level={headingLevel}
      size="xs"
      data-prop={useDefaultEditableBinding ? "title" : undefined}
    >
      {title}
    </Heading>
  )}
  {!isSplit && (isHorizontal || grouped) && hasBody && (
    <SimpleText
      class="timeline-body"
      size="sm"
      data-prop={useDefaultEditableBinding ? "body" : undefined}
      text={body}
    />
  )}
</li>
