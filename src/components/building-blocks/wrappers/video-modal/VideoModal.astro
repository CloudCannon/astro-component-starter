---
import Modal from "@wrappers/modal/Modal.astro";
import Video from "@core-elements/video/Video.astro";
import Image from "@core-elements/image/Image.astro";
import { slugifyLabel } from "@component-utils/slugify";

const {
  label,
  media,
  title,
  trigger,
  size = "xl",
  spaceBefore = "default",
  class: className,
  // Not forwarded: Modal's default binding targets `contentSections`, which this body lacks.
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const { type = "youtube", videoId, source } = media ?? {};
const {
  style: triggerStyle = "button",
  text: triggerText,
  variant: triggerVariant = "primary",
  size: triggerSize = "md",
  iconName: triggerIconName = "play-circle",
  image: posterImage = "",
  alt: posterAlt = "",
  aspectRatio: posterAspectRatio = "widescreen",
} = trigger ?? {};

const hasVideo =
  (type === "local-source" && source) || ((type === "youtube" || type === "vimeo") && videoId);

if (!_component && !hasVideo) return;

const usePoster = triggerStyle === "poster" && !!posterImage;
const posterLabel = label || title;
const posterPopoverId = usePoster
  ? `video-${posterLabel ? slugifyLabel(posterLabel) : crypto.randomUUID()}`
  : undefined;

// Unmuted autoplay needs the open gesture, so `setup.ts` injects the embed on open.
const embedSrc =
  type === "youtube"
    ? `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`
    : type === "vimeo"
      ? `https://player.vimeo.com/video/${videoId}?autoplay=1`
      : undefined;
---

<Modal
  label={label}
  popoverId={posterPopoverId}
  triggerText={usePoster ? undefined : triggerText}
  data-prop-trigger-text="trigger.text"
  triggerVariant={triggerVariant}
  triggerSize={triggerSize}
  triggerIconName={usePoster ? undefined : triggerIconName}
  size={size}
  sheet={false}
  class:list={["video-modal", "stackable", className]}
  spaceBefore={spaceBefore}
  _component={_component}
  {...htmlAttributes}
>
  {usePoster && (
    <button
      slot="trigger"
      type="button"
      class="video-modal-poster"
      popovertarget={posterPopoverId}
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-label={title ? `Play video: ${title}` : "Play video"}
    >
      <Image
        source={posterImage}
        alt={posterAlt}
        aspectRatio={posterAspectRatio}
        sizes="(max-width: 640px) 100vw, 800px"
        widths={[400, 800, 1280]}
        width={1280}
        data-prop-src="trigger.image"
        data-prop-alt="trigger.alt"
      />
      <span
        class="video-modal-poster-disc"
        aria-hidden="true"
      >
        <svg
          viewBox="0 0 24 24"
          width="28"
          height="28"
          fill="currentColor"
        >
          <path d="M8 5.5v13l11-6.5z" />
        </svg>
      </span>
    </button>
  )}
  <div
    class="video-modal-body"
    data-video-embed-src={embedSrc}
    data-video-title={title}
  >
    {type === "local-source" ? (
      <Video
        type="local-source"
        source={source}
        class="video-modal-player"
      />
    ) : (
      <div class="video-modal-embed">
        <div class="video-modal-consent">
          <p>Allow external media across this site to play this video.</p>
          <button
            type="button"
            data-external-media-enable
          >
            Allow all external media
          </button>
        </div>
      </div>
    )}
  </div>
</Modal>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllVideoModals } from "./setup";

  onPageLoad(() => setupAllVideoModals());
</script>

<style is:global>
  @layer components {
    .video-modal:has(> .video-modal-poster) {
      display: block;
    }

    .video-modal-poster {
      background: none;
      border: 0;
      border-radius: var(--radius-md);
      cursor: pointer;
      display: block;
      overflow: hidden;
      padding: 0;
      position: relative;
      width: 100%;

      .image,
      img {
        display: block;
        margin: 0;
        width: 100%;
      }

      .video-modal-poster-disc {
        align-items: center;
        background: var(--color-overlay);
        border-radius: var(--radius-full);
        color: var(--color-text-on-media);
        display: flex;
        height: 4rem;
        inset-block-start: 50%;
        inset-inline-start: 50%;
        justify-content: center;
        position: absolute;
        transition: transform var(--animation-fast) var(--ease-out);
        translate: -50% -50%;
        width: 4rem;
      }

      &:hover .video-modal-poster-disc {
        transform: scale(1.08);
      }
    }

    /* Close sits above the video: on the player, a YouTube/Vimeo iframe eats its clicks. */
    .video-modal [data-modal] {
      --video-modal-column: min(
        90vw,
        calc(
          (100dvh - var(--spacing-xl) * 2 - 2.75rem - var(--spacing-md)) * var(--ratio-widescreen)
        )
      );

      background: var(--color-overlay);
      border: 0;
      color: var(--color-text);
      height: 100%;
      inset: 0;
      margin: 0;
      opacity: 0;
      overflow: hidden;
      padding: var(--spacing-xl);
      transition:
        opacity var(--animation-normal) var(--ease-out),
        overlay var(--animation-normal) var(--ease-out) allow-discrete,
        display var(--animation-normal) var(--ease-out) allow-discrete;
      width: 100%;

      &:popover-open {
        align-items: center;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
        justify-content: center;
        opacity: 1;

        @starting-style {
          opacity: 0;
        }
      }

      &.size-sm :is(.modal-header, .modal-body) {
        max-width: var(--content-width-sm);
      }

      &.size-md :is(.modal-header, .modal-body) {
        max-width: var(--content-width-md);
      }

      &.size-lg :is(.modal-header, .modal-body) {
        max-width: var(--content-width-lg);
      }

      &.size-xl :is(.modal-header, .modal-body) {
        max-width: var(--content-width-xl);
      }
    }

    .video-modal .modal-header.no-header {
      display: flex;
      height: auto;
      justify-content: flex-end;
      position: static;
      width: var(--video-modal-column);
    }

    .video-modal .modal-header.no-header .modal-close {
      position: static;
    }

    /* Ghost tile, matching .gallery-lightbox-tile. */
    .video-modal .modal-close .button-inner.variant-ghost {
      background: transparent;
      border: var(--border-width-sm) solid var(--color-border-on-media);
      border-radius: var(--radius-sm);
      color: var(--color-text-on-media);
      height: 2.75rem;
      padding: 0;
      width: 2.75rem;

      &:hover,
      &:focus {
        background: var(--color-state-hover-on-media);
        border-color: var(--color-border-on-media);
        color: var(--color-text-on-media);
      }
    }

    .video-modal .modal-body {
      flex: none;
      overflow: hidden;
      width: var(--video-modal-column);
    }

    .video-modal-body {
      aspect-ratio: var(--ratio-widescreen);
      border-radius: var(--radius-xs);
      line-height: var(--line-height-none);
      overflow: hidden;

      > .video-modal-player,
      > .video-modal-embed {
        height: 100%;
        width: 100%;
      }

      .video-modal-consent {
        align-items: center;
        background-color: var(--color-bg-surface);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
        height: 100%;
        justify-content: center;
        line-height: var(--line-height-normal);
        padding: var(--spacing-md);
        text-align: center;

        p {
          color: var(--color-text-muted);
          margin: 0;
        }

        button {
          background-color: var(--color-bg-brand);
          border: var(--border-width-sm) solid var(--color-bg-brand);
          border-radius: var(--radius-xs);
          color: var(--color-brand-on);
          cursor: pointer;
          font: inherit;
          font-weight: var(--font-weight-semibold);
          padding: var(--spacing-em-sm);
        }
      }

      > .video-modal-player {
        display: block;
        margin-top: 0;
        object-fit: contain;
        background-color: black;
      }

      > .video-modal-embed > iframe {
        border: 0;
        height: 100%;
        width: 100%;
      }
    }
  }
</style>
