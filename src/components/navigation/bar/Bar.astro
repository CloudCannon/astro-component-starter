---
import Dropdown from "./Dropdown.astro";
import MegaPanel from "./MegaPanel.astro";
import { isCurrentPage, itemHasMegaMenu, type NavItem } from "./navState";

const {
  navData = [],
  class: className,
  "aria-label": ariaLabel = "Navigation",
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const navInstanceId = crypto.randomUUID();
const pathname = Astro.url.pathname;
---

<nav
  aria-label={ariaLabel}
  class:list={["bar", className]}
  {...htmlAttributes}
>
  <ul class="bar-list">
    {
      navData.map((item: NavItem) => {
        if (itemHasMegaMenu(item)) {
          return (
            <MegaPanel
              item={item}
              groupName={`bar-nav-top-${navInstanceId}`}
            />
          );
        }

        if (!item.children?.length) {
          return (
            <li class="nav-item">
              <a
                href={item.path}
                aria-current={isCurrentPage(pathname, item) ? "page" : undefined}
              >
                {item.name}
              </a>
            </li>
          );
        }

        return (
          <Dropdown
            item={item}
            groupName={`bar-nav-top-${navInstanceId}`}
          />
        );
      })
    }
  </ul>
</nav>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { syncExpanded } from "./toggleState";

  let barGlobalHandlersBound = false;

  function closeAll(root: ParentNode) {
    root.querySelectorAll<HTMLInputElement>(".nav-item-toggle").forEach((toggle) => {
      toggle.checked = false;
    });
    syncExpanded(root);
  }

  function handleToggleChange(e: Event) {
    const target = e.target;
    if (!(target instanceof HTMLInputElement)) return;

    const barNav = target.closest(".bar");
    if (!barNav) return;

    // Top-level toggles are checkboxes so they can close; only one may be open.
    if (target.type === "checkbox" && target.checked) {
      barNav
        .querySelectorAll<HTMLInputElement>(".nav-item-toggle[type='checkbox']")
        .forEach((checkbox) => {
          if (checkbox !== target) checkbox.checked = false;
        });
    }
    syncExpanded(barNav);
  }

  function handleTriggerClick(e: Event) {
    const label = e.currentTarget as HTMLElement;
    const toggle = document.getElementById(label.getAttribute("for") || "") as HTMLInputElement;

    if (toggle?.checked) {
      e.preventDefault();
      toggle.checked = false;
      toggle.dispatchEvent(new Event("change", { bubbles: true }));
    }
  }

  function handleKeydown(e: Event) {
    if (!(e instanceof KeyboardEvent)) return;
    if (e.key !== "Enter" && e.key !== " ") return;

    e.preventDefault();
    const label = e.currentTarget;
    if (!(label instanceof HTMLElement)) return;

    const toggle = document.getElementById(label.getAttribute("for") || "");

    if (toggle instanceof HTMLInputElement) {
      toggle.checked = !toggle.checked;
      toggle.dispatchEvent(new Event("change", { bubbles: true }));
    }
  }

  function initBarNavigation() {
    if (!barGlobalHandlersBound) {
      document.addEventListener("click", (e) => {
        const target = e.target;
        if (!(target instanceof Element) || target.closest(".bar")) return;

        document.querySelectorAll(".bar").forEach(closeAll);
      });

      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;

        // Closing hides the focused link; hand focus back to the panel's toggle.
        const bar = document.activeElement?.closest(".bar");
        const returnTo = bar?.querySelector<HTMLInputElement>(
          ".bar-list > .nav-item > .nav-item-toggle:checked"
        );

        document.querySelectorAll(".bar").forEach(closeAll);
        returnTo?.focus();
      });

      barGlobalHandlersBound = true;
    }

    document.querySelectorAll<HTMLElement>(".bar").forEach((barNav) => {
      if (barNav.dataset.barInitialized === "true") return;
      barNav.dataset.barInitialized = "true";

      syncExpanded(barNav);
      barNav.addEventListener("change", handleToggleChange);

      barNav
        .querySelectorAll(".nav-item-toggle-btn, .nav-item.has-children > .nav-item-trigger")
        .forEach((trigger) => {
          trigger.addEventListener("click", handleTriggerClick);
          trigger.addEventListener("keydown", handleKeydown);
        });

      // Clicks inside dropdown content must not reach the document handler, which closes dropdowns.
      barNav.querySelectorAll(".nav-item-content, .nav-item-nested").forEach((content) => {
        content.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          if (!target.closest(".nav-item-trigger") && !target.closest(".nav-item-link")) {
            e.stopPropagation();
          }
        });
      });
    });
  }

  onPageLoad(initBarNavigation);
</script>

<style is:global>
  @layer components {
    .bar {
      font-weight: var(--font-weight-semibold);
      .bar-list {
        align-items: center;
        display: flex;
        gap: var(--spacing-sm);
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav-item {
        position: relative;
      }

      .nav-item > a,
      .nav-item > .nav-item-trigger {
        border-radius: var(--radius-xs);
        color: var(--color-text-strong);
        cursor: pointer;
        display: block;
        font-weight: var(--font-weight-normal);
        padding: var(--spacing-sm) var(--spacing-md);
        text-decoration: none;
        transition: background var(--animation-normal) var(--ease-in-out);
        white-space: nowrap;

        &:hover {
          background: var(--color-state-hover);
        }
      }

      .nav-item-split {
        align-items: center;
        border-radius: var(--radius-xs);
        display: flex;
        flex-wrap: nowrap;
        min-width: 0;
        transition: background var(--animation-normal) var(--ease-in-out);

        .nav-item-link {
          color: var(--color-text-strong);
          cursor: pointer;
          display: block;
          flex: 1 1 auto;
          min-width: 0;
          padding: var(--spacing-sm) var(--spacing-xs) var(--spacing-sm) var(--spacing-md);
          text-decoration: none;
          transition: background var(--animation-normal) var(--ease-in-out);
          white-space: nowrap;
        }

        .nav-item-toggle-btn {
          align-items: center;
          aspect-ratio: 1;
          border-left: 1px solid transparent;
          border-radius: var(--radius-xs);
          box-sizing: border-box;
          cursor: pointer;
          display: flex;
          flex: 0 0 auto;
          height: 1.75em;
          justify-content: center;
          margin-inline-end: 4px;
          padding: 0;
          width: 1.75em;
          transition:
            background var(--animation-normal) var(--ease-in-out),
            border-color var(--animation-normal) var(--ease-in-out);
        }

        &:hover {
          background: var(--color-state-hover);

          .nav-item-toggle-btn {
            background: color-mix(in srgb, var(--color-state-hover), var(--color-text) 3%);
          }
        }

        .nav-item-toggle-btn:hover {
          background: color-mix(in srgb, var(--color-state-hover), var(--color-text) 8%);
          border-left-color: var(--color-border);
        }

        .nav-item-toggle-btn .nav-item-icon {
          align-items: center;
          display: flex;
          justify-content: center;
          line-height: var(--line-height-none);
          top: 0;
        }
      }

      .nav-item > a[aria-current="page"],
      .nav-item > .nav-item-trigger[aria-current="page"],
      .nav-item-split .nav-item-link[aria-current="page"] {
        text-decoration: underline dotted;
        text-decoration-color: var(--color-text-muted);
        text-underline-offset: 3px;
      }

      .nav-item-trigger {
        align-items: center;
        display: flex;
        gap: var(--spacing-xs);
      }

      .nav-item-icon {
        color: var(--color-text-muted);
        display: inline-block;
        transition:
          color var(--animation-normal) var(--ease-in-out),
          transform var(--animation-normal) var(--ease-in-out);
        width: 0.8rem;
        position: relative;
        top: 0.2rem;
      }

      .nav-item-trigger:hover .nav-item-icon {
        color: var(--color-text-strong);
      }

      .nav-item-toggle:checked ~ .nav-item-trigger .nav-item-icon,
      .nav-item-toggle:checked ~ .nav-item-split .nav-item-icon {
        transform: rotate(90deg);
      }

      /* The input is hidden by `.visually-hidden`, not `display: none`, so it
         stays in the tab order — which means drawing its focus ring on the
         visible trigger, wrapped in `.nav-item-split` or not. */
      .nav-item:has(> .nav-item-toggle:focus-visible) > .nav-item-trigger,
      .nav-item:has(> .nav-item-toggle:focus-visible) > .nav-item-split .nav-item-trigger {
        outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
        outline-offset: 2px;
      }

      .nav-item-toggle ~ .nav-item-content,
      .nav-item-toggle ~ .nav-item-nested {
        display: none;
      }

      .nav-item-toggle:checked ~ .nav-item-content {
        animation: grow-out-centered var(--animation-normal) var(--ease-out) forwards;
        display: block;
      }

      .nav-item-toggle:checked ~ .nav-item-nested {
        animation: grow-out var(--animation-normal) var(--ease-out) forwards;
        display: block;
      }

      .nav-item > .nav-item-content {
        background: var(--color-bg);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-xs);
        left: 50%;
        margin-top: var(--spacing-xs);
        min-width: 200px;
        position: absolute;
        top: 100%;
        transform: translateX(-50%);
        width: max-content;
        z-index: var(--layer-3);
      }

      .nav-item-content .nav-item {
        display: block;
      }

      .nav-item-content .nav-item > a,
      .nav-item-content .nav-item > .nav-item-trigger,
      .nav-item-content .nav-item-split {
        border-radius: 0;
      }

      .nav-item-content .nav-item > .nav-item-trigger,
      .nav-item-nested .nav-item > .nav-item-trigger {
        display: flex;
        justify-content: space-between;
        padding-inline-end: calc(var(--spacing-sm) + 2px);
      }

      .nav-item-nested .nav-item > a {
        border-radius: 0;
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-normal);
        padding-inline-end: 4px;
        padding-left: var(--spacing-xl);
      }

      .nav-item-nested .nav-item > .nav-item-trigger,
      .nav-item-nested .nav-item-split .nav-item-link {
        font-weight: var(--font-weight-normal);
      }
    }
  }
</style>
