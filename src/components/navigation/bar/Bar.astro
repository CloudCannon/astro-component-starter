---
import Dropdown from "./Dropdown.astro";
import MegaPanel from "./MegaPanel.astro";
import { isCurrentPage, itemHasMegaMenu, type NavItem } from "./navState";
import { slugifyLabel } from "@component-utils/slugify";
import { uniqueId } from "@component-utils/uniqueId";

const {
  navData = [],
  class: className,
  "aria-label": ariaLabel = "Navigation",
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

// Unique per nav: two bars sharing an `aria-label` would share one radio group.
const navGroupName = uniqueId(
  Astro.request,
  `bar-nav-top-${slugifyLabel(ariaLabel || "navigation")}`
);
const pathname = Astro.url.pathname;
---

<nav
  aria-label={ariaLabel}
  class:list={["bar", className]}
  {...htmlAttributes}
>
  <ul class="bar-list">
    {navData?.map((item: NavItem) => {
      if (itemHasMegaMenu(item)) {
        return (
          <MegaPanel
            item={item}
            groupName={navGroupName}
          />
        );
      }

      if (!item.children?.length) {
        return (
          <li class="nav-item">
            <a
              href={item.path}
              aria-current={isCurrentPage(pathname, item) ? "page" : undefined}
            >
              {item.name}
            </a>
          </li>
        );
      }

      return (
        <Dropdown
          item={item}
          groupName={navGroupName}
        />
      );
    })}
  </ul>
</nav>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { bindToggleKeys, syncExpanded } from "./toggleState";

  let barGlobalHandlersBound = false;

  function closeAll(root: ParentNode) {
    root.querySelectorAll<HTMLInputElement>(".nav-item-toggle").forEach((toggle) => {
      toggle.checked = false;
    });
    syncExpanded(root);
  }

  function handleToggleChange(e: Event) {
    const target = e.target;
    if (!(target instanceof HTMLInputElement)) return;

    const barNav = target.closest(".bar");
    if (!barNav) return;

    // Top-level toggles are checkboxes so they can close; only one may be open.
    if (target.type === "checkbox" && target.checked) {
      barNav
        .querySelectorAll<HTMLInputElement>(".nav-item-toggle[type='checkbox']")
        .forEach((checkbox) => {
          if (checkbox !== target) checkbox.checked = false;
        });
    }
    syncExpanded(barNav);
    clampOpenDropdowns(barNav);
  }

  /** CSS alone can't express "centred on the trigger, but not past the viewport edge". */
  function clampOpenDropdowns(barNav: Element) {
    barNav
      .querySelectorAll<HTMLElement>(".nav-item-toggle:checked ~ .nav-item-content")
      .forEach((panel) => {
        panel.style.removeProperty("--bar-dropdown-shift");

        const gutter = 8;
        const box = panel.getBoundingClientRect();
        const overflowEnd = box.right - (window.innerWidth - gutter);
        const overflowStart = gutter - box.left;
        const shift = overflowEnd > 0 ? -overflowEnd : overflowStart > 0 ? overflowStart : 0;

        if (shift !== 0) {
          panel.style.setProperty("--bar-dropdown-shift", `${Math.round(shift)}px`);
        }
      });
  }

  function handleTriggerClick(e: Event) {
    const label = e.currentTarget as HTMLElement;
    const toggle = document.getElementById(label.getAttribute("for") || "") as HTMLInputElement;

    if (toggle?.checked) {
      e.preventDefault();
      toggle.checked = false;
      toggle.dispatchEvent(new Event("change", { bubbles: true }));
    }
  }

  function initBarNavigation() {
    if (!barGlobalHandlersBound) {
      document.addEventListener("click", (e) => {
        const target = e.target;
        if (!(target instanceof Element) || target.closest(".bar")) return;

        document.querySelectorAll(".bar").forEach(closeAll);
      });

      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;

        // Closing hides the focused link; hand focus back to the panel's toggle.
        const bar = document.activeElement?.closest(".bar");
        const returnTo = bar?.querySelector<HTMLInputElement>(
          ".bar-list > .nav-item > .nav-item-toggle:checked"
        );

        document.querySelectorAll(".bar").forEach(closeAll);
        returnTo?.focus();
      });

      barGlobalHandlersBound = true;
    }

    document.querySelectorAll<HTMLElement>(".bar").forEach((barNav) => {
      if (barNav.dataset.barInitialized === "true") return;
      barNav.dataset.barInitialized = "true";

      syncExpanded(barNav);
      bindToggleKeys(barNav);
      barNav.addEventListener("change", handleToggleChange);

      barNav
        .querySelectorAll(".nav-item-toggle-btn, .nav-item.has-children > .nav-item-trigger")
        .forEach((trigger) => {
          trigger.addEventListener("click", handleTriggerClick);
        });

      // A press moves focus outside the nav; closing on that focusout would make the
      // trigger's own click reopen the panel, so presses are left to the click handlers.
      let pressedInside = false;

      barNav.addEventListener("pointerdown", () => {
        pressedInside = true;
      });
      window.addEventListener("pointerup", () => setTimeout(() => (pressedInside = false)));

      // Keyboard counterpart of the document click handler.
      barNav.addEventListener("focusout", (e) => {
        const next = (e as FocusEvent).relatedTarget;

        if (pressedInside || (next instanceof Node && barNav.contains(next))) return;

        closeAll(barNav);
      });

      barNav.querySelectorAll(".nav-item-content, .nav-item-nested").forEach((content) => {
        content.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          if (!target.closest(".nav-item-trigger") && !target.closest(".nav-item-link")) {
            e.stopPropagation();
          }
        });
      });
    });
  }

  onPageLoad(initBarNavigation);
</script>

<style is:global>
  @layer components {
    .bar {
      --bar-icon-size: 1.75em;
      --bar-chevron-size: 0.8rem;
      --bar-dropdown-min-width: 200px;

      font-weight: var(--font-weight-semibold);
      .bar-list {
        align-items: center;
        display: flex;
        gap: var(--spacing-sm);
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav-item {
        position: relative;
      }

      .nav-item > a,
      .nav-item > .nav-item-trigger {
        border-radius: var(--radius-xs);
        color: var(--color-text-strong);
        cursor: pointer;
        display: block;
        font-weight: var(--font-weight-normal);
        padding: var(--spacing-sm) var(--spacing-md);
        text-decoration: none;
        transition: background var(--animation-normal) var(--ease-in-out);
        white-space: nowrap;

        &:hover {
          background: var(--color-state-hover);
        }
      }

      .nav-item-split {
        align-items: center;
        border-radius: var(--radius-xs);
        display: flex;
        flex-wrap: nowrap;
        min-width: 0;
        transition: background var(--animation-normal) var(--ease-in-out);

        .nav-item-link {
          color: var(--color-text-strong);
          cursor: pointer;
          display: block;
          flex: 1 1 auto;
          min-width: 0;
          padding: var(--spacing-sm) var(--spacing-xs) var(--spacing-sm) var(--spacing-md);
          text-decoration: none;
          transition: background var(--animation-normal) var(--ease-in-out);
          white-space: nowrap;
        }

        .nav-item-toggle-btn {
          align-items: center;
          aspect-ratio: 1;
          border-left: var(--border-width-sm) solid transparent;
          border-radius: var(--radius-xs);
          box-sizing: border-box;
          cursor: pointer;
          display: flex;
          flex: 0 0 auto;
          height: var(--bar-icon-size);
          justify-content: center;
          margin-inline-end: var(--spacing-xs);
          padding: 0;
          width: var(--bar-icon-size);
          transition:
            background var(--animation-normal) var(--ease-in-out),
            border-color var(--animation-normal) var(--ease-in-out);
        }

        &:hover {
          background: var(--color-state-hover);

          .nav-item-toggle-btn {
            background: color-mix(in srgb, var(--color-state-hover), var(--color-text) 3%);
          }
        }

        .nav-item-toggle-btn:hover {
          background: color-mix(in srgb, var(--color-state-hover), var(--color-text) 8%);
          border-left-color: var(--color-border);
        }

        .nav-item-toggle-btn .nav-item-icon {
          align-items: center;
          display: flex;
          justify-content: center;
          line-height: var(--line-height-none);
          top: 0;
        }
      }

      .nav-item > a[aria-current="page"],
      .nav-item > .nav-item-trigger[aria-current="page"],
      .nav-item-split .nav-item-link[aria-current="page"] {
        text-decoration: underline dotted;
        text-decoration-color: var(--color-text-muted);
        text-underline-offset: 3px;
      }

      .nav-item-trigger {
        align-items: center;
        display: flex;
        gap: var(--spacing-xs);
      }

      .nav-item-icon {
        color: var(--color-text-muted);
        display: inline-block;
        transition:
          color var(--animation-normal) var(--ease-in-out),
          transform var(--animation-normal) var(--ease-in-out);
        width: var(--bar-chevron-size);
        position: relative;
        top: 0.2rem;
      }

      .nav-item-trigger:hover .nav-item-icon {
        color: var(--color-text-strong);
      }

      .nav-item-toggle:checked ~ .nav-item-trigger .nav-item-icon,
      .nav-item-toggle:checked ~ .nav-item-split .nav-item-icon {
        transform: rotate(90deg);
      }

      /* The toggle is `.visually-hidden` so it stays tabbable; its ring is drawn on the trigger. */
      .nav-item:has(> .nav-item-toggle:focus-visible) > .nav-item-trigger,
      .nav-item:has(> .nav-item-toggle:focus-visible) > .nav-item-split .nav-item-trigger {
        outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
        outline-offset: 2px;
      }

      .nav-item-toggle ~ .nav-item-content,
      .nav-item-toggle ~ .nav-item-nested {
        display: none;
      }

      .nav-item-toggle:checked ~ .nav-item-content {
        animation: grow-out-centered var(--animation-normal) var(--ease-out) forwards;
        display: block;
      }

      .nav-item-toggle:checked ~ .nav-item-nested {
        animation: grow-out var(--animation-normal) var(--ease-out) forwards;
        display: block;
      }

      .nav-item > .nav-item-content {
        background: var(--color-bg);
        border: var(--border-width-sm) solid var(--color-border-subtle);
        border-radius: var(--radius-xs);
        left: 50%;
        margin-top: var(--spacing-xs);
        max-width: calc(100vw - var(--spacing-md) * 2);
        min-width: var(--bar-dropdown-min-width);
        position: absolute;
        top: 100%;
        transform: translateX(calc(-50% + var(--bar-dropdown-shift, 0px)));
        width: max-content;
        z-index: var(--layer-3);
      }

      .nav-item-content .nav-item {
        display: block;
      }

      .nav-item-content .nav-item > a,
      .nav-item-content .nav-item > .nav-item-trigger,
      .nav-item-content .nav-item-split {
        border-radius: 0;
      }

      .nav-item-content .nav-item > .nav-item-trigger,
      .nav-item-nested .nav-item > .nav-item-trigger {
        display: flex;
        justify-content: space-between;
        padding-inline-end: calc(var(--spacing-sm) + 2px);
      }

      .nav-item-nested .nav-item > a {
        border-radius: 0;
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-normal);
        padding-inline-end: var(--spacing-xs);
        padding-left: var(--spacing-xl);
      }

      .nav-item-nested .nav-item > .nav-item-trigger,
      .nav-item-nested .nav-item-split .nav-item-link {
        font-weight: var(--font-weight-normal);
      }
    }
  }
</style>
