---
import { breadcrumbListJsonLd } from "@components/utils/breadcrumbTrail";
import Icon from "@core-elements/icon/Icon.astro";
import breadcrumbsData from "@data/breadcrumbs.json";

/**
 * `items` is the trail after the leading Home crumb, in order. The last item is
 * the current page; items with a `url` render as links, the rest as text.
 */
const { items = [], class: className, ...htmlAttributes } = Astro.props;

const homeLabel = String(breadcrumbsData.homeLabel ?? "").trim() || "Home";
const trail = [{ label: homeLabel, url: "/" }, ...items];

// Nearest linkable ancestor — the target of the mobile back-link.
const backTarget = trail
  .slice(0, -1)
  .reverse()
  .find((item) => item.url);

const structuredData = breadcrumbListJsonLd(items, {
  homeLabel,
  base: Astro.site ?? Astro.url,
});
---

<nav
  class:list={["breadcrumbs", className]}
  aria-label="Breadcrumb"
  data-pagefind-ignore
  {...htmlAttributes}
>
  <ol class="breadcrumbs-trail">
    {
      trail.map((item, index) => {
        const isCurrent = index === trail.length - 1;

        return (
          <li class="breadcrumbs-item">
            {index > 0 && (
              <Icon
                name="chevron-right"
                size="none"
                class="breadcrumbs-separator"
              />
            )}
            {item.url && !isCurrent ? (
              <a
                class="breadcrumbs-link"
                href={item.url}
              >
                {item.label}
              </a>
            ) : (
              <span
                class="breadcrumbs-current"
                aria-current={isCurrent ? "page" : undefined}
              >
                {item.label}
              </span>
            )}
          </li>
        );
      })
    }
  </ol>

  {
    backTarget && (
      <a
        class="breadcrumbs-back"
        href={backTarget.url}
      >
        <Icon
          name="chevron-left"
          size="none"
        />
        {backTarget.label}
      </a>
    )
  }
</nav>

<script
  type="application/ld+json"
  set:html={JSON.stringify(structuredData)}
/>

<style is:global>
  @layer components {
    .breadcrumbs {
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
    }

    .breadcrumbs .breadcrumbs-trail {
      align-items: center;
      display: flex;
      gap: var(--spacing-xs);
      list-style: none;
      margin: 0;
      min-width: 0;
      padding: 0;
    }

    .breadcrumbs .breadcrumbs-item {
      align-items: center;
      display: flex;
      gap: var(--spacing-xs);
      min-width: 0;
    }

    .breadcrumbs .breadcrumbs-separator {
      flex-shrink: 0;
      font-size: 0.75em;
      transform: translateY(0.09em);
    }

    .breadcrumbs .breadcrumbs-link {
      color: inherit;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.15em;
      white-space: nowrap;
    }

    .breadcrumbs .breadcrumbs-link:hover {
      color: var(--color-text-strong);
      text-decoration-thickness: 2px;
    }

    /* Long post titles clamp so the trail stays on one line. */
    .breadcrumbs .breadcrumbs-current {
      color: var(--color-text-strong);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .breadcrumbs .breadcrumbs-back {
      align-items: center;
      color: inherit;
      display: none;
      gap: var(--spacing-xs);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.15em;
      width: fit-content;
    }

    .breadcrumbs .breadcrumbs-back:hover {
      color: var(--color-text-strong);
      text-decoration-thickness: 2px;
    }

    /* On small screens the trail collapses to a back-link to the parent. */
    @media (max-width: 639px) {
      .breadcrumbs .breadcrumbs-trail {
        display: none;
      }

      .breadcrumbs .breadcrumbs-back {
        display: flex;
      }
    }
  }
</style>
