---
import Button from "@core-elements/button/Button.astro";
import Toggle from "@forms/toggle/Toggle.astro";
import ModalShell from "@wrappers/modal/ModalShell.astro";
import { slugifyLabel } from "@component-utils/slugify";
import type { AnalyticsConfig, PrivacyConfig } from "../../../integrations/consent/config";

type Props = { privacy: PrivacyConfig; analytics: AnalyticsConfig; label?: string };
const { privacy, analytics, label } = Astro.props as Props;
const hasAnalytics = analytics.provider !== "none";
// The component library renders a second instance on one page, so the id comes from the label.
const popoverId = slugifyLabel(label ?? "") || "privacy-settings";
---

<aside
  class="consent"
  hidden
  aria-label="Privacy choices"
>
  <span
    hidden
    data-consent-config={JSON.stringify(privacy)}
    data-analytics-config={JSON.stringify(analytics)}
    data-has-analytics={hasAnalytics}
  ></span>
  {hasAnalytics && (
    <div
      class="consent-banner"
      data-consent-banner
      data-theme="dark"
      role="region"
      aria-labelledby={`${popoverId}-heading`}
    >
      <div class="consent-copy">
        <h2 id={`${popoverId}-heading`}>{privacy.bannerHeading}</h2>
        <p>{privacy.bannerText}</p>
        <a href={privacy.policyUrl}>Read our privacy policy</a>
      </div>
      <div class="consent-actions">
        <Button
          text="Accept All"
          variant="primary"
          size="sm"
          data-consent-action="accept-all"
        />
        <Button
          text="Reject All"
          variant="primary"
          size="sm"
          data-consent-action="reject-all"
        />
        <Button
          text="Customize"
          variant="tertiary"
          size="sm"
          link={`^${popoverId}`}
          data-consent-action="customize"
        />
      </div>
    </div>
  )}

  <ModalShell
    popoverId={popoverId}
    size="sm"
    label={privacy.settingsLabel}
    fullScreenMobile
    class="consent-popover"
  >
    <div class="consent-modal-header">
      <h2>{privacy.settingsLabel}</h2>
      <Button
        text="Close"
        hideText
        iconName="x-mark"
        variant="ghost"
        size="lg"
        popovertarget={popoverId}
        popovertargetaction="hide"
      />
    </div>
    <div class="consent-modal-body">
      <div class="consent-category consent-category-necessary">
        <span>
          <strong>{privacy.necessaryLabel}</strong>
          <span>{privacy.necessaryDescription}</span>
        </span>
        <span class="consent-category-status">Always on</span>
      </div>
      {hasAnalytics && (
        <div class="consent-category">
          <Toggle
            class="consent-category-toggle"
            id={`${popoverId}-analytics`}
            label={privacy.analyticsLabel}
            inputAttributes={{
              "data-consent-category": "analytics",
              "aria-describedby": `${popoverId}-analytics-description`,
            }}
          />
          <span
            id={`${popoverId}-analytics-description`}
            class="consent-category-description"
          >
            {privacy.analyticsDescription}
          </span>
        </div>
      )}
      <div class="consent-category">
        <Toggle
          class="consent-category-toggle"
          id={`${popoverId}-external-media`}
          label={privacy.externalMediaLabel}
          inputAttributes={{
            "data-consent-category": "externalMedia",
            "aria-describedby": `${popoverId}-external-media-description`,
          }}
        />
        <span
          id={`${popoverId}-external-media-description`}
          class="consent-category-description"
        >
          {privacy.externalMediaDescription}
        </span>
      </div>
      <p class="consent-policy-link">
        For more information, <a href={privacy.policyUrl}>read our privacy policy</a>.
      </p>
    </div>
    <div class="consent-modal-footer">
      <div class="consent-modal-bulk-actions">
        <Button
          text="Accept All"
          variant="tertiary"
          size="sm"
          data-consent-action="accept-all"
        />
        <Button
          text="Reject All"
          variant="tertiary"
          size="sm"
          data-consent-action="reject-all"
        />
      </div>
      <Button
        text="Save choices"
        variant="primary"
        size="sm"
        data-consent-action="save"
      />
    </div>
  </ModalShell>
</aside>

<script>
  import { setupAllConsent } from "./setup";

  setupAllConsent();
  document.addEventListener("astro:page-load", () => setupAllConsent());
</script>

<style is:global>
  @layer components {
    .consent-banner {
      align-items: end;
      background-color: var(--color-bg);
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: var(--radius-md);
      bottom: var(--spacing-md);
      color: var(--color-text);
      display: grid;
      gap: var(--spacing-md);
      left: var(--spacing-md);
      max-width: min(var(--content-width-md), calc(100vw - var(--spacing-md) * 2));
      padding: var(--spacing-md);
      position: fixed;
      z-index: var(--layer-8);

      @media (min-width: 640px) {
        grid-template-columns: minmax(0, 1fr) auto;
      }
    }

    .consent-banner[hidden] {
      display: none;
    }

    .consent-copy {
      display: grid;
      gap: var(--spacing-xs);

      h2,
      p {
        margin: 0;
      }

      h2 {
        color: var(--color-text-strong);
        font-size: var(--font-size-lg);
      }

      p,
      a {
        font-size: var(--font-size-sm);
      }
    }

    .consent-actions,
    .consent-modal-footer,
    .consent-modal-bulk-actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-xs);
    }

    .component-viewer .consent-banner {
      position: absolute;
    }

    @media (min-width: 640px) {
      .modal-popover.consent-popover {
        max-height: min(85vh, 38rem);
      }
    }

    .consent-modal-header,
    .consent-modal-footer {
      align-items: center;
      background-color: var(--color-bg-surface);
      display: flex;
      justify-content: space-between;
      padding: var(--spacing-md);
    }

    .consent-modal-header h2 {
      font-size: var(--font-size-heading-sm);
      margin: 0;
    }

    .consent-modal-body {
      display: grid;
      gap: var(--spacing-md);
      overflow-y: auto;
      padding: var(--spacing-md);
    }

    .consent-policy-link {
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
      margin: 0;
    }

    .consent-category {
      align-items: start;
      border-top: var(--border-width-sm) solid var(--color-border);
      display: flex;
      gap: var(--spacing-md);
      justify-content: space-between;
      padding-top: var(--spacing-md);

      > span {
        display: grid;
        gap: var(--spacing-xs);
      }

      strong {
        color: var(--color-text-strong);
      }

      span span {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
      }
    }

    .consent-category:has(> .consent-category-toggle) {
      display: grid;
      gap: var(--spacing-xs);

      .toggle-container {
        flex-direction: row-reverse;
      }

      .toggle-label {
        color: var(--color-text-strong);
        font-weight: var(--font-weight-bold);
      }

      > .consent-category-description {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
      }
    }

    .consent-category-necessary {
      border-top: 0;
      padding-top: 0;
    }

    .consent-category-status {
      background-color: var(--color-bg-muted);
      border-radius: var(--radius-full);
      color: var(--color-text-muted);
      flex: none;
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-semibold);
      line-height: 1;
      padding: var(--spacing-xs) var(--spacing-sm);
    }

    @media (max-width: 639px) {
      .consent-banner {
        bottom: var(--spacing-sm);
        left: var(--spacing-sm);
        max-width: calc(100vw - var(--spacing-sm) * 2);
      }

      body:has(.mobile-menu-popover:popover-open) .consent-banner {
        display: none;
      }
    }
  }
</style>
