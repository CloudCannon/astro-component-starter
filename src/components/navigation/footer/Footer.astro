---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Bar from "@navigation/bar/Bar.astro";
import Divider from "@core-elements/divider/Divider.astro";
import Image from "@core-elements/image/Image.astro";
import SocialLinks from "@core-elements/social-links/SocialLinks.astro";
import Text from "@core-elements/text/Text.astro";
import type { SocialLink } from "../../../types";
import privacyData from "@data/privacy.json";
import { parsePrivacyConfig } from "../../../integrations/consent/config";

const privacy = parsePrivacyConfig(privacyData);
const {
  links = [],
  socials = [] as SocialLink[],
  footerText = "",
  logoSource,
  logoAlternateSource,
  logoAlt,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<footer
  class:list={["footer", className]}
  {...htmlAttributes}
>
  <CustomSection
    maxContentWidth="2xl"
    paddingHorizontal="md"
    paddingVertical="2xl"
    useDefaultEditableBinding={false}
  >
    <div class="footer-content">
      <div class="content-container">
        {logoSource && (
          <a
            href="/"
            class="footer-logo-link"
          >
            <Image
              source={logoSource}
              alternateSource={logoAlternateSource}
              alt={logoAlt}
              class="footer-logo"
              useDefaultEditableBinding={false}
            />
          </a>
        )}
      </div>
      <div class="content-container">
        <Bar
          navData={links}
          useDefaultEditableBinding={false}
          aria-label="Footer"
        />
      </div>
    </div>

    <Divider />

    <div class="footer-content">
      <div class="content-container">
        <Text
          class="footer-legal-text"
          text={footerText || ""}
          useDefaultEditableBinding={false}
        />
        {privacy.enabled && (
          <button
            type="button"
            class="footer-privacy-settings"
            data-consent-open
          >
            {privacy.settingsLabel}
          </button>
        )}
      </div>
      <div class="content-container">
        <SocialLinks
          class="footer-socials"
          links={socials}
          variant="ghost"
          size="md"
          alignmentHorizontal="end"
          useDefaultEditableBinding={false}
        />
      </div>
    </div>
  </CustomSection>
</footer>

<style is:global>
  @layer page-sections {
    .footer {
      container-type: inline-size;

      .footer-socials {
        @container (max-width: 639px) {
          .social-links-list {
            justify-content: center;
          }
        }
      }

      .footer-content {
        @container (min-width: 640px) {
          align-items: center;
          display: flex;
          flex-wrap: wrap;
          justify-content: space-between;
        }

        .content-container {
          flex: 1;
        }
      }

      .footer-legal-text {
        color: var(--color-text-muted);
        text-align: center;
        @container (min-width: 640px) {
          text-align: start;
        }
      }

      .footer-privacy-settings {
        background: transparent;
        border: 0;
        color: var(--color-text-muted);
        cursor: pointer;
        font: inherit;
        margin-top: var(--spacing-xs);
        padding: 0;
        text-decoration: underline;

        &:focus-visible {
          outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
          outline-offset: 2px;
        }
      }

      .footer-logo-link {
        display: inline-block;

        &:focus-visible {
          outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
          outline-offset: 2px;
        }
      }

      .footer-logo {
        flex-shrink: 0;

        img {
          margin-inline: auto;
          margin-bottom: var(--spacing-md);
          max-height: 2em;
          max-width: min(20em, 100%);
          width: auto;
          @container (min-width: 640px) {
            margin: 0;
          }
        }
      }

      .bar .bar-list {
        flex-flow: column wrap;
        @container (min-width: 640px) {
          flex-direction: row;
          justify-content: end;
        }
      }
    }
  }
</style>
