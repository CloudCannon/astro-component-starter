---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Bar from "@components/navigation/bar/Bar.astro";
import Divider from "@core-elements/divider/Divider.astro";
import Image from "@core-elements/image/Image.astro";
import SocialLinks from "@core-elements/social-links/SocialLinks.astro";
import Text from "@core-elements/text/Text.astro";
import type { SocialLink } from "../../../types";

const {
  links = [],
  socials = [] as SocialLink[],
  footerText = "",
  logoSource,
  logoAlternateSource,
  logoAlt,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<footer
  class="footer"
  {...htmlAttributes}
>
  <CustomSection
    maxContentWidth="2xl"
    paddingHorizontal="md"
    paddingVertical="2xl"
    useDefaultEditableBinding={false}
  >
    <div class="footer-content">
      <div class="content-container">
        <Image
          source={logoSource}
          alternateSource={logoAlternateSource}
          alt={logoAlt}
          class="footer-logo"
          useDefaultEditableBinding={false}
        />
      </div>
      <div class="content-container">
        <Bar
          navData={links}
          useDefaultEditableBinding={false}
          aria-label="Footer"
        />
      </div>
    </div>

    <Divider />

    <div class="footer-content">
      <div class="content-container">
        <Text
          class="footer-legal-text"
          text={footerText || ""}
          data-prop=""
          useDefaultEditableBinding={false}
        />
      </div>
      <div class="content-container">
        {
          /* The same block editors can place on a page — it owns the nav/list
            semantics, the 44px targets, and the new-tab rel attributes, so the
            footer doesn't hand-roll a second social row. */
        }
        <SocialLinks
          class="footer-socials"
          links={socials}
          variant="ghost"
          size="md"
          alignmentHorizontal="end"
        />
      </div>
    </div>
  </CustomSection>
</footer>

<style is:global>
  @layer page-sections {
    .footer {
      container-type: inline-size;

      /* Stacked footer: the socials centre under the legal line rather than
         sitting hard against the edge. */
      .footer-socials {
        @container (max-width: 639px) {
          .social-links-list {
            justify-content: center;
          }
        }
      }

      .footer-content {
        @container (min-width: 640px) {
          align-items: center;
          display: flex;
          flex-wrap: wrap;
          justify-content: space-between;
        }

        .content-container {
          flex: 1;
        }
      }

      .footer-legal-text {
        color: var(--color-text-muted);
        text-align: center;
        @container (min-width: 640px) {
          text-align: start;
        }
      }

      .footer-logo {
        flex-shrink: 0;
        margin-top: 0 !important;

        img {
          margin-inline: auto;
          margin-bottom: var(--spacing-md);
          max-height: 2em;
          max-width: min(20em, 100%);
          width: auto;
          @container (min-width: 640px) {
            margin: 0;
          }
        }
      }

      .bar .bar-list {
        flex-flow: column wrap;
        @container (min-width: 640px) {
          flex-direction: row;
          justify-content: end;
        }
      }
    }
  }
</style>
