---
import Button from "@core-elements/button/Button.astro";
import { slugifyLabel } from "@component-utils/slugify";
import Icon from "@core-elements/icon/Icon.astro";
import Image from "@core-elements/image/Image.astro";
import NavItemTrigger from "@components/navigation/bar/NavItemTrigger.astro";
import {
  createNavItemData,
  isCurrentPage,
  itemHasMegaMenu,
  type NavItem,
} from "@components/navigation/bar/navState";

const {
  logoSource,
  logoAlternateSource,
  logoAlt,
  navData = [],
  class: className,
  "aria-label": ariaLabel = "Mobile",
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const navInstanceId = slugifyLabel(ariaLabel || "mobile");
const toggleId = `mobile-toggle-${navInstanceId}`;
const pathname = Astro.url.pathname;
---

<!-- The checkbox is the real control: ARIA permits a `<label for>` no role, so a
  name set there is discarded. Naming the checkbox keeps the CSS-only toggle the
  CloudCannon editor needs while exposing a control that has a role and a name.
  The labels stay as click targets. -->
<input
  type="checkbox"
  id={toggleId}
  class="nav-toggle visually-hidden"
  aria-label="Toggle navigation menu"
  autocomplete="off"
/>
<label
  for={toggleId}
  class="nav-hamburger mobile-button"
>
  <Button
    variant="tertiary"
    size="lg"
    element="div"
    iconName="bars-3"
    hideText={true}
    class="mobile-nav-button"
  />
</label>

<nav
  aria-label={ariaLabel}
  class:list={["mobile", className]}
  data-toggle-id={toggleId}
  {...htmlAttributes}
>
  <div class="mobile-header">
    <div class="mobile-logo">
      <slot name="logo">
        <Image
          source={logoSource}
          alternateSource={logoAlternateSource}
          alt={logoAlt || "Astro Component Starter"}
          class="mobile-logo-image"
          useDefaultEditableBinding={false}
        />
      </slot>
    </div>
    <div class="mobile-header-actions">
      <label
        for={toggleId}
        class="mobile-close mobile-button"
      >
        <Button
          variant="tertiary"
          size="lg"
          element="span"
          iconName="x-mark"
          hideText={true}
          class="mobile-nav-close mobile-nav-button"
        />
      </label>
    </div>
  </div>

  <div class="mobile-content">
    <ul class="mobile-list">
      {
        navData?.map((item: NavItem) => {
          const itemData = createNavItemData(pathname, item, `mobile-nav-top-${navInstanceId}`);

          if (itemHasMegaMenu(item)) {
            return (
              <li class="nav-item has-children">
                <NavItemTrigger
                  item={itemData}
                  inputType="radio"
                  expanded={itemData.hasCurrent}
                />
                <div
                  id={itemData.contentId}
                  class="nav-item-content mobile-mega"
                >
                  {(item.megaMenu?.columns ?? []).map((column) => (
                    <Fragment>
                      {column.heading && <p class="mobile-mega-heading">{column.heading}</p>}
                      <ul class="nav-list">
                        {(column.items ?? []).map((link) => (
                          <li class="nav-item">
                            <a
                              href={link.path}
                              aria-current={isCurrentPage(pathname, link) ? "page" : undefined}
                            >
                              {link.icon && (
                                <span class="mobile-mega-icon">
                                  <Icon
                                    name={link.icon}
                                    size="none"
                                    aria-hidden="true"
                                  />
                                </span>
                              )}
                              {link.name}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </Fragment>
                  ))}
                </div>
              </li>
            );
          }

          if (!itemData.hasChildren) {
            return (
              <li class="nav-item">
                <a
                  href={itemData.path}
                  aria-current={itemData.isCurrent ? "page" : undefined}
                >
                  {itemData.name}
                </a>
              </li>
            );
          }

          return (
            <li class="nav-item has-children">
              <NavItemTrigger
                item={itemData}
                inputType="radio"
                expanded={itemData.hasCurrent}
              />
              <div
                id={itemData.contentId}
                class="nav-item-content"
              >
                <ul class="nav-list">
                  {itemData.children!.map((child) => {
                    const childData = createNavItemData(
                      pathname,
                      child,
                      `mobile-nav-${itemData.parentGroupId}`
                    );

                    if (!childData.hasChildren) {
                      return (
                        <li class="nav-item">
                          <a
                            href={childData.path}
                            aria-current={childData.isCurrent ? "page" : undefined}
                          >
                            {childData.name}
                          </a>
                        </li>
                      );
                    }

                    return (
                      <li class="nav-item has-children">
                        <NavItemTrigger
                          item={childData}
                          inputType="radio"
                          expanded={childData.hasCurrent}
                        />
                        <div
                          id={childData.contentId}
                          class="nav-item-content"
                        >
                          <ul class="nav-list">
                            {childData.children!.map((grandChild) => (
                              <li class="nav-item">
                                <a
                                  href={grandChild.path}
                                  aria-current={
                                    isCurrentPage(pathname, grandChild) ? "page" : undefined
                                  }
                                >
                                  {grandChild.name}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { trapFocus } from "@component-utils/focusTrap";
  import { bindToggleKeys, syncExpanded } from "@components/navigation/bar/toggleState";

  // Overlays live in one container so z-index stacking is predictable.
  function getOrCreateOverlaysContainer() {
    let container = document.getElementById("overlays-container");
    if (!container) {
      container = document.createElement("div");
      container.id = "overlays-container";
      container.style.cssText = "position: relative; z-index: 9999;";
      document.body.insertBefore(container, document.body.firstChild);
    }
    return container;
  }

  function initMobileNavigation() {
    const allMobileNavs = document.querySelectorAll<HTMLElement>(".mobile");
    const overlaysContainer = getOrCreateOverlaysContainer();

    allMobileNavs.forEach((nav) => {
      if (nav.dataset.mobileInitialized === "true") return;
      nav.dataset.mobileInitialized = "true";

      nav.classList.add("js-enabled");

      overlaysContainer.appendChild(nav);

      const toggleId = nav.getAttribute("data-toggle-id");
      const toggleElement = toggleId ? document.getElementById(toggleId) : null;
      const toggle = toggleElement instanceof HTMLInputElement ? toggleElement : null;
      const hamburger = document.querySelector<HTMLElement>(
        `label[for="${toggleId}"].nav-hamburger`
      );

      function handleNavToggle(isOpen: boolean) {
        if (isOpen) {
          nav.setAttribute("aria-hidden", "false");
          nav.style.transform = "translateX(0)";
          document.body.style.overflow = "hidden";
          // Into the panel, not the close affordance — that is a `<label>` and
          // takes no focus. The panel is also moved into the overlays container,
          // outside the checkbox's tab sequence, so place focus explicitly.
          nav.querySelector<HTMLElement>("a[href], button, input, [tabindex]")?.focus();
        } else {
          nav.setAttribute("aria-hidden", "true");
          nav.style.transform = "translateX(-100%)";
          document.body.style.overflow = "";
          // Focusing the checkbox draws the ring on the hamburger label.
          toggle?.focus();
        }
      }

      if (hamburger && toggle) {
        const toggleHandler = (e: Event) => {
          e.preventDefault();
          e.stopPropagation();
          toggle.checked = !toggle.checked;
          handleNavToggle(toggle.checked);
        };

        hamburger.addEventListener("click", toggleHandler);

        // A checkbox handles Space natively, but not Enter.
        toggle.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            toggleHandler(e);
          }
        });
      }

      const closeButton = nav.querySelector<HTMLElement>(".mobile-close");
      if (closeButton && toggle) {
        const closeHandler = (e: Event) => {
          e.preventDefault();
          e.stopPropagation();
          toggle.checked = false;
          handleNavToggle(false);
        };

        closeButton.addEventListener("click", closeHandler);
      }

      if (toggle) {
        toggle.addEventListener("change", (e) => {
          if (e.target instanceof HTMLInputElement) {
            handleNavToggle(e.target.checked);
          }
        });
      }

      const handleDropdownToggle = (e: Event) => {
        const target = e.target;
        if (!(target instanceof Element)) return;

        const trigger = target.closest(".nav-item-trigger");
        if (!trigger) return;

        const radioName = trigger.getAttribute("for");
        let dropdownToggle: HTMLInputElement | null = null;

        if (radioName) {
          const radioElement = document.getElementById(radioName);
          dropdownToggle = radioElement instanceof HTMLInputElement ? radioElement : null;
        } else {
          const parent = trigger.closest(".nav-item");
          dropdownToggle = parent?.querySelector<HTMLInputElement>(".nav-item-toggle") ?? null;
        }

        if (dropdownToggle) {
          e.preventDefault();
          dropdownToggle.checked = !dropdownToggle.checked;
          dropdownToggle.dispatchEvent(new Event("change", { bubbles: true }));
        }
      };

      nav.addEventListener("click", handleDropdownToggle);
      nav.addEventListener("change", () => syncExpanded(nav));
      bindToggleKeys(nav);
      // The open panel covers the page, so Tab must not walk into content
      // behind it. `aria-hidden` is the open flag `handleNavToggle` maintains.
      trapFocus(nav, () => nav.getAttribute("aria-hidden") === "false");

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && toggle?.checked) {
          toggle.checked = false;
          handleNavToggle(false);
        }
      });
    });
  }

  onPageLoad(initMobileNavigation);
</script>

<style is:global>
  @layer components {
    /* `.nav-toggle:checked ~` covers the pre-JS/editor DOM; `[aria-hidden]`
       covers the live site, where the panel is relocated into
       #overlays-container and is no longer the checkbox's sibling. */
    .nav-toggle:checked ~ .mobile,
    .mobile[aria-hidden="false"] {
      transform: translateX(0);
      /* No visibility delay on the way in, so the panel is focusable from the
         first frame of the slide. */
      transition:
        transform var(--animation-normal) var(--ease-in-out),
        visibility 0s;
      visibility: visible;
    }

    /* The checkbox is hidden by `.visually-hidden`, not `display: none`, which
       would drop it out of the tab order and the accessibility tree. */
    /* Draw the hidden control's focus ring on whichever label is on screen —
       only one is, since the open panel covers the hamburger. */
    .nav-toggle:focus-visible ~ .nav-hamburger,
    .nav-toggle:focus-visible ~ .mobile .mobile-close {
      outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
    }

    .mobile-button {
      border-radius: var(--radius-xs);
      display: inline-block;
      /* Inset offset: these buttons sit flush to the panel edge / scroll box. */
      outline-offset: -2px;

      &:focus-visible {
        outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
      }
    }

    .mobile {
      background: var(--color-bg);
      display: flex;
      flex-direction: column;
      height: 100vh;
      inset: 0;
      position: fixed;
      transform: translateX(-100%);
      /* transform alone leaves every link focusable off-canvas, so a desktop
         visitor tabs through the whole mobile menu. `visibility` is delayed by
         the slide duration so closing still animates. */
      transition:
        transform var(--animation-normal) var(--ease-in-out),
        visibility 0s linear var(--animation-normal);
      visibility: hidden;
      z-index: var(--layer-5);

      .mobile-header {
        align-items: center;
        border-bottom: var(--border-width-sm) solid var(--color-border-subtle);
        display: flex;
        flex-shrink: 0;
        height: 5rem;
        justify-content: space-between;
        padding: 0 var(--spacing-lg);

        .mobile-logo {
          align-items: center;
          display: flex;
          flex: 0 1 min(11rem, 100%);
          min-width: 0;
          width: min(11rem, 100%);
        }

        .mobile-header-actions {
          align-items: center;
          display: flex;
          gap: var(--spacing-xs);
        }
      }

      .mobile-content {
        flex: 1;
        overflow-y: auto;
      }

      .mobile-list {
        font-size: var(--font-size-lg);
      }

      .mobile-list,
      .nav-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav-item {
        border-bottom: var(--border-width-sm) solid var(--color-border-subtle);
        position: relative;
      }

      /*
       * Row shell shared by direct links and full-row label triggers.
       * Split rows (link + chevron toggle) use `.nav-item-split` below.
       */
      .nav-item > a,
      .nav-item > .nav-item-trigger:not(.nav-item-toggle-btn) {
        align-items: center;
        border-radius: var(--radius-xs);
        color: var(--color-text-strong);
        cursor: pointer;
        display: flex;
        font-weight: var(--font-weight-semibold);
        min-height: 2.5rem;
        padding: var(--spacing-md);
        text-decoration: none;
        transition: background-color var(--animation-normal) var(--ease-in-out);
        user-select: none;
        white-space: nowrap;
        width: 100%;

        &[aria-current="page"] {
          text-decoration: underline dotted;
          text-decoration-color: var(--color-text-muted);
          text-underline-offset: 3px;
        }

        &:hover,
        &:focus-visible {
          background: var(--color-state-hover);
          color: var(--color-text-strong);

          .nav-item-icon {
            color: var(--color-text-strong);
          }
        }
      }

      .nav-item > .nav-item-trigger:not(.nav-item-toggle-btn) {
        gap: var(--spacing-xs);
        justify-content: space-between;
        padding-inline-end: 0;

        .nav-item-icon {
          align-items: center;
          box-sizing: border-box;
          color: var(--color-text-muted);
          display: inline-flex;
          flex-shrink: 0;
          justify-content: center;
          line-height: var(--line-height-none);
          margin-inline: 2px var(--spacing-md);
          min-height: 1.75rem;
          min-width: 2.5rem;
          padding: var(--spacing-xs);
          transition:
            color var(--animation-normal) var(--ease-in-out),
            transform var(--animation-normal) var(--ease-in-out);
        }
      }

      .nav-item-split {
        align-items: stretch;
        border-radius: var(--radius-xs);
        display: flex;
        flex-wrap: nowrap;
        gap: var(--spacing-xs);
        min-width: 0;
        transition: background-color var(--animation-normal) var(--ease-in-out);
        width: 100%;

        &:hover {
          background: var(--color-state-hover);

          .nav-item-link {
            color: var(--color-text-strong);
          }

          .nav-item-toggle-btn {
            background: color-mix(in srgb, var(--color-state-hover), var(--color-text) 3%);
          }
        }

        .nav-item-link {
          align-items: center;
          border-radius: var(--radius-xs);
          color: var(--color-text-strong);
          cursor: pointer;
          display: flex;
          flex: 1 1 auto;
          font-weight: var(--font-weight-semibold);
          min-height: 2.5rem;
          min-width: 0;
          padding: var(--spacing-md) var(--spacing-xs) var(--spacing-md) var(--spacing-md);
          text-decoration: none;
          transition: color var(--animation-normal) var(--ease-in-out);
          user-select: none;
          white-space: nowrap;

          &[aria-current="page"] {
            text-decoration: underline dotted;
            text-decoration-color: var(--color-text-muted);
            text-underline-offset: 3px;
          }

          &:hover,
          &:focus-visible {
            color: var(--color-text-strong);
          }
        }

        .nav-item-toggle-btn {
          align-items: center;
          align-self: center;
          aspect-ratio: 1;
          background: transparent;
          border: none;
          border-left: var(--border-width-sm) solid transparent;
          border-radius: var(--radius-xs);
          box-sizing: border-box;
          color: var(--color-text-muted);
          cursor: pointer;
          display: inline-flex;
          flex: 0 0 auto;
          height: 2.5rem;
          justify-content: center;
          margin-inline: 2px var(--spacing-md);
          padding: 0;
          width: 2.5rem;
          transition:
            background-color var(--animation-normal) var(--ease-in-out),
            border-color var(--animation-normal) var(--ease-in-out),
            color var(--animation-normal) var(--ease-in-out);

          &:hover {
            background: color-mix(in srgb, var(--color-state-hover), var(--color-text) 8%);
            border-left-color: var(--color-border);
            color: var(--color-text-strong);
          }

          &:focus-visible {
            outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
            outline-offset: 2px;
          }

          .nav-item-icon {
            align-items: center;
            display: flex;
            justify-content: center;
            line-height: var(--line-height-none);
          }
        }
      }

      /* The radio drives expand/collapse via `:checked ~` selectors, and is
         hidden by `.visually-hidden` so it stays focusable. */
      .nav-item-content {
        display: none;
      }

      /* Draw the hidden control's focus ring on the trigger the user can see. */
      .nav-item:has(> .nav-item-toggle:focus-visible) > .nav-item-trigger,
      .nav-item:has(> .nav-item-toggle:focus-visible) > .nav-item-split .nav-item-trigger {
        outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
        outline-offset: 2px;
      }

      .nav-item-toggle:checked ~ .nav-item-content {
        animation: grow-out var(--animation-normal) var(--ease-out);
        display: block;
      }

      .mobile-mega .mobile-mega-heading {
        color: var(--color-text-muted);
        font-size: var(--font-size-xs);
        font-weight: var(--font-weight-semibold);
        letter-spacing: 0.08em;
        margin: 0;
        padding: var(--spacing-sm) var(--spacing-xl);
        text-transform: uppercase;
      }

      .mobile-mega .nav-list:not(:last-child) > .nav-item:last-child {
        border-bottom: var(--border-width-sm) solid var(--color-border-subtle);
      }

      .mobile-mega-icon {
        align-items: center;
        color: var(--color-text-muted);
        display: inline-flex;
        font-size: var(--font-size-lg);
        margin-inline-end: var(--spacing-sm);
      }

      .nav-item-icon {
        color: var(--color-text-muted);
        display: inline-block;
        transition: transform var(--animation-normal) var(--ease-in-out);
      }

      .nav-item-toggle:checked ~ .nav-item-trigger .nav-item-icon,
      .nav-item-toggle:checked ~ .nav-item-split .nav-item-icon {
        transform: rotate(90deg);
      }

      /*
       * Nested lists: deeper indentation. Level two inherits the primary
       * weight / size; level three drops to body-sm + regular.
       */
      .nav-list {
        & > .nav-item:last-child {
          border-bottom: none;
        }

        & > .nav-item > a,
        & > .nav-item > .nav-item-trigger:not(.nav-item-toggle-btn) {
          padding-inline: var(--spacing-xl);
        }

        & > .nav-item > .nav-item-split {
          padding-inline: var(--spacing-xl);
        }

        & > .nav-item > .nav-item-split .nav-item-link,
        & .nav-list > .nav-item > .nav-item-split .nav-item-link {
          padding: var(--spacing-md) var(--spacing-xs) var(--spacing-md) 0;
        }

        & .nav-list > .nav-item > a,
        & .nav-list > .nav-item > .nav-item-trigger:not(.nav-item-toggle-btn) {
          font-size: var(--font-size-sm);
          font-weight: var(--font-weight-normal);
          padding-inline-start: var(--spacing-2xl);
        }

        & .nav-list > .nav-item > .nav-item-split {
          padding-inline-end: var(--spacing-xl);
          padding-inline-start: var(--spacing-2xl);
        }

        & .nav-list > .nav-item > .nav-item-split .nav-item-link {
          font-size: var(--font-size-sm);
          font-weight: var(--font-weight-normal);
        }
      }
    }

    .mobile .mobile-header .mobile-logo .mobile-logo-image {
      display: flex;
      max-width: none;
      width: 100%;
    }

    .mobile .mobile-header .mobile-logo .mobile-logo-image > .image-inner {
      width: 100%;
    }

    .mobile .mobile-header .mobile-logo .mobile-logo-image picture {
      display: block;
      width: 100%;
    }

    .mobile .mobile-header .mobile-logo .mobile-logo-image img,
    .mobile .mobile-header .mobile-logo .mobile-logo-image svg,
    .mobile .mobile-header .mobile-logo svg {
      display: block;
      height: 2rem;
      max-width: 100%;
      width: auto;
    }

    .mobile-overlay {
      background: var(--color-bg);
      display: flex;
      flex-direction: column;
      height: 100vh;
      inset: 0;
      position: fixed;
      transform: translateX(-100%);
      transition: transform var(--animation-normal) var(--ease-in-out);
      z-index: var(--layer-6);

      &.open {
        transform: translateX(0);
      }
    }
  }
</style>
