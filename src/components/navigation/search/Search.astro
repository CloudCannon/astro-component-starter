---
/**
 * Site-wide search: an icon trigger in the nav that opens a modal built on
 * `ModalShell` + Pagefind 1.5's Component UI. Enabled via `search: true` in
 * `src/data/mainNav.json` (optional `searchPlaceholder`). Site chrome like
 * `theme-toggle` — no CloudCannon YAML, wired by hand in `MainNav.astro`.
 *
 * The index under `/pagefind/` is generated by the Pagefind CLI on build;
 * see `setup.ts` for the dev-server and CloudCannon-editor story.
 */
import Button from "@core-elements/button/Button.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import ModalShell from "@wrappers/modal/ModalShell.astro";
import SearchResult from "./SearchResult.astro";

const { placeholder = "Search this site…", class: className, ...htmlAttributes } = Astro.props;

const popoverId = "search-modal";

// Skeleton rows Pagefind shows while lazily rendering off-screen results.
const placeholderTemplate = `
  <li class="search-result is-placeholder" aria-hidden="true">
    <div class="search-result-media search-skeleton"></div>
    <div class="search-result-content">
      <p class="search-skeleton search-skeleton-title"></p>
      <p class="search-skeleton search-skeleton-line"></p>
      <p class="search-skeleton search-skeleton-line is-short"></p>
    </div>
  </li>
`;
---

<div
  class:list={["search", className]}
  {...htmlAttributes}
>
  <Button
    text="Search"
    hideText
    iconName="magnifying-glass"
    variant="ghost"
    size="lg"
    link={`^${popoverId}`}
    class="search-trigger"
  />
  <ModalShell
    popoverId={popoverId}
    size="md"
    label="Search"
    fullScreenMobile
    class="search-popover"
  >
    <pagefind-config bundle-path="/pagefind/"></pagefind-config>
    <div class="search-header">
      <div class="search-input">
        <pagefind-input placeholder={placeholder}></pagefind-input>
      </div>
      <Button
        iconName="x-mark"
        hideText
        text="Close"
        variant="ghost"
        size="lg"
        class="search-close"
        popovertarget={popoverId}
        popovertargetaction="hide"
      />
    </div>
    <div
      class="search-tabs"
      role="group"
      aria-label="Filter results by type"
    >
      <Button
        text="All"
        variant="ghost"
        size="sm"
        class="search-tab"
        data-search-tab=""
        aria-pressed="true"
      />
      <Button
        text="Pages"
        variant="ghost"
        size="sm"
        class="search-tab"
        data-search-tab="Page"
        aria-pressed="false"
      />
      <Button
        text="Articles"
        variant="ghost"
        size="sm"
        class="search-tab"
        data-search-tab="Article"
        aria-pressed="false"
      />
    </div>
    <div class="search-body">
      <SimpleText
        text="Search works on the published site — the index is generated at build time."
        size="sm"
        class="search-unavailable"
      />
      <pagefind-summary default-message="Start typing to search this site."></pagefind-summary>
      <pagefind-results>
        <script
          is:inline
          type="text/pagefind-template"
          data-template="placeholder"
          set:html={placeholderTemplate}
        />
      </pagefind-results>
      <template class="search-result-template">
        <SearchResult />
      </template>
    </div>
    <!-- Static hints instead of <pagefind-keyboard-hints>, whose "esc clear"
         hint is wrong here — Escape closes the modal (see setup.ts). -->
    <div
      class="search-footer"
      aria-hidden="true"
    >
      <span><kbd>↓</kbd>navigate</span>
      <span><kbd>↵</kbd>open</span>
      <span><kbd>esc</kbd>close</span>
    </div>
  </ModalShell>
</div>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllSearch } from "./setup";

  onPageLoad(() => setupAllSearch());
</script>

<style is:global>
  @import "@pagefind/component-ui/css/pagefind-component-ui.css" layer(pagefind);

  @layer components {
    .search {
      display: inline-flex;
    }

    .search-popover {
      /* Bridge Pagefind Component UI theming onto the site's semantic
         tokens, so dark mode needs no data-pf-theme wiring. */
      --pf-font: var(--font-body);
      --pf-text: var(--color-text);
      --pf-text-secondary: var(--color-text-muted);
      --pf-text-muted: var(--color-text-muted);
      --pf-background: var(--color-bg);
      --pf-border: var(--color-border);
      --pf-border-focus: var(--color-brand);
      --pf-hover: var(--color-state-hover);
      --pf-mark: var(--color-text-strong);
      --pf-outline-focus: var(--color-focus-ring);
      --pf-border-radius: var(--radius-xs);
      --pf-shadow-sm: var(--shadow-sm);
      --pf-shadow-md: var(--shadow-md);
      --pf-shadow-lg: var(--shadow-lg);
      --pf-skeleton: var(--color-bg-surface);
      --pf-skeleton-shine: var(--color-bg-muted);
      --pf-input-height: 3rem;
      --pf-summary-font-size: var(--font-size-sm);
      --pf-results-gap: 0;

      height: min(85vh, 40rem);

      @media (max-width: 639px) {
        height: 100dvh;
      }
    }

    .search-header {
      align-items: center;
      border-bottom: var(--border-width-sm) solid var(--color-border-subtle);
      display: flex;
      flex-shrink: 0;
      gap: var(--spacing-sm);
      padding: var(--spacing-sm) var(--spacing-sm) var(--spacing-sm) var(--spacing-md);

      &:focus-within {
        border-bottom-color: var(--color-text-strong);
      }

      .search-input {
        flex: 1;
        min-width: 0;
      }
    }

    .search-popover .pf-input {
      background-color: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .search-tabs {
      display: flex;
      flex-shrink: 0;
      gap: var(--spacing-sm);
      padding: var(--spacing-sm) var(--spacing-md);
    }

    .search-tabs .button.search-tab .button-inner {
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: var(--radius-full);
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
      padding: var(--spacing-em-xs) var(--spacing-em-md);

      &:hover,
      &:focus {
        background-color: var(--color-state-hover);
        color: var(--color-text-strong);
      }

      &[aria-pressed="true"] {
        background-color: var(--color-text-strong);
        border-color: var(--color-text-strong);
        color: var(--color-bg);
      }

      .search-tab-count {
        font-variant-numeric: tabular-nums;
        margin-inline-start: var(--spacing-em-sm);
        opacity: 0.6;

        &:empty {
          display: none;
        }
      }
    }

    .search-body {
      display: flex;
      flex: 1;
      flex-direction: column;
      overflow-y: auto;
      padding: var(--spacing-sm) var(--spacing-sm) var(--spacing-lg);

      pagefind-summary {
        display: block;
        flex-shrink: 0;
        padding: 0 var(--spacing-sm);
      }

      pagefind-results {
        display: block;
        padding-top: var(--spacing-sm);
      }

      .search-unavailable {
        background-color: var(--color-bg-surface);
        border: var(--border-width-sm) solid var(--color-border);
        border-radius: var(--radius-xs);
        color: var(--color-text-muted);
        display: none;
        margin: 0 var(--spacing-sm);
        max-width: 44ch;
        padding: var(--spacing-md);
      }
    }

    [data-search-unavailable] {
      .search-unavailable {
        display: block;
      }

      /* The friendly notice replaces Pagefind's raw error UI (the .pf-error
         boxes and the summary's error text). */
      .pf-error,
      pagefind-summary {
        display: none;
      }
    }

    .search-result {
      align-items: start;
      border-radius: var(--radius-xs);
      display: grid;
      gap: var(--spacing-md);

      grid-template-columns: 7rem 1fr;
      padding: var(--spacing-sm);

      position: relative;

      &:hover,
      &:focus-within {
        background-color: var(--color-state-hover);
      }

      &:hover .search-result-link {
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      &:hover .search-result-media {
        border-color: var(--color-border-strong);
      }

      &:focus-within {
        outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
        outline-offset: -2px;
      }
    }

    .search-result-media {
      background-color: var(--color-bg-surface);
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: var(--radius-xs);
      height: 5rem;
      overflow: hidden;
      width: 7rem;
    }

    .search-result-image {
      display: block;
      height: 100%;
      object-fit: cover;
      width: 100%;
    }

    .search-result-content {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);

      grid-column: 2;
      min-width: 0;

      p {
        margin: 0;
      }

      .heading,
      .simple-text {
        margin-block: 0;
      }
    }

    .search-result-link {
      color: var(--color-text-strong);
      text-decoration: none;

      &:focus-visible {
        outline: none;
      }

      &::after {
        content: "";
        inset: 0;
        position: absolute;
      }
    }

    .search-result .search-result-title .heading-inner {
      font-size: var(--font-size-md);
      letter-spacing: -0.005em;
      line-height: var(--line-height-tight);
    }

    .search-result-lead {
      color: var(--color-text-muted);
      font-variant-numeric: tabular-nums;
    }

    .search-result-excerpt {
      color: var(--color-text-muted);
      line-height: var(--line-height-normal);

      mark {
        background: var(--color-bg-highlight);
        border-radius: 2px;
        color: var(--color-text-strong);
        padding: 0 2px;
      }
    }

    .search-result-excerpt .simple-text-content {
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      display: -webkit-box;
      overflow: hidden;
      text-wrap: pretty;
    }

    .search-skeleton {
      /* An ambient loop, not a UI transition — off the --animation-* scale on
         purpose, which tops out at half a second. */
      --search-skeleton-duration: 1.4s;

      animation: search-skeleton-pulse var(--search-skeleton-duration) var(--ease-in-out) infinite;
      background-color: var(--color-bg-muted);
      border-radius: var(--radius-xs);
    }

    .search-skeleton-title {
      height: 1rem;
      width: 44%;
    }

    .search-skeleton-line {
      height: 0.75rem;
      width: 100%;

      &.is-short {
        width: 72%;
      }
    }

    @keyframes search-skeleton-pulse {
      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0.45;
      }
    }

    .search-footer {
      align-items: center;
      background-color: var(--color-bg-surface);
      border-top: var(--border-width-sm) solid var(--color-border);
      color: var(--color-text-muted);
      display: flex;
      flex-shrink: 0;
      font-size: var(--font-size-xs);
      gap: var(--spacing-md);
      padding: var(--spacing-sm) var(--spacing-md);

      kbd {
        background-color: var(--color-bg);
        border: var(--border-width-sm) solid var(--color-border);
        border-radius: var(--radius-xs);
        color: var(--color-text);
        font-family: var(--font-body);
        margin-inline-end: var(--spacing-em-xs);
        padding: 0 var(--spacing-xs);
      }

      @media (max-width: 639px) {
        display: none;
      }
    }
  }
</style>
