---
import NavItemTrigger from "@components/navigation/bar/NavItemTrigger.astro";
import {
  createNavItemData,
  isCurrentPage,
  type NavItem,
} from "@components/navigation/bar/navState";
import { slugifyLabel } from "@component-utils/slugify";

const {
  navData = [],
  class: className,
  "aria-label": ariaLabel = "Sidebar",
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const pathname = Astro.url.pathname;

// Scopes radio buttons per navigation instance. Two navs on one page need
// distinct `aria-label`s anyway, so the label is the stable scope.
const navInstanceId = slugifyLabel(ariaLabel || "side");
---

<nav
  aria-label={ariaLabel}
  class:list={["side", className]}
  {...htmlAttributes}
>
  <ul class="side-list">
    {
      navData?.map((item: NavItem) => {
        const itemData = createNavItemData(pathname, item, `side-nav-top-${navInstanceId}`);

        if (!itemData.hasChildren) {
          return (
            <li class="nav-item">
              {itemData.path ? (
                <a
                  href={itemData.path}
                  aria-current={itemData.isCurrent ? "page" : undefined}
                >
                  {itemData.name}
                </a>
              ) : (
                <span class="nav-item-static">{itemData.name}</span>
              )}
            </li>
          );
        }

        return (
          <li class="nav-item has-children">
            <NavItemTrigger
              item={itemData}
              inputType="radio"
              expanded={itemData.hasCurrent}
            />
            <div
              id={itemData.contentId}
              class="nav-item-content"
              data-open-on-load={itemData.hasCurrent ? "" : undefined}
            >
              <ul class="nav-list">
                {itemData.children!.map((child) => {
                  const childData = createNavItemData(
                    pathname,
                    child,
                    `side-nav-${itemData.parentGroupId}`
                  );

                  if (!childData.hasChildren) {
                    return (
                      <li class="nav-item">
                        {childData.path ? (
                          <a
                            href={childData.path}
                            aria-current={childData.isCurrent ? "page" : undefined}
                          >
                            {childData.name}
                          </a>
                        ) : (
                          <span class="nav-item-static">{childData.name}</span>
                        )}
                      </li>
                    );
                  }

                  return (
                    <li class="nav-item has-children">
                      <NavItemTrigger
                        item={childData}
                        inputType="radio"
                        expanded={childData.hasCurrent}
                      />
                      <div
                        id={childData.contentId}
                        class="nav-item-content"
                        data-open-on-load={childData.hasCurrent ? "" : undefined}
                      >
                        <ul class="nav-list">
                          {childData.children!.map((grandChild) => (
                            <li class="nav-item">
                              {grandChild.path ? (
                                <a
                                  href={grandChild.path}
                                  aria-current={
                                    isCurrentPage(pathname, grandChild) ? "page" : undefined
                                  }
                                >
                                  {grandChild.name}
                                </a>
                              ) : (
                                <span class="nav-item-static">{grandChild.name}</span>
                              )}
                            </li>
                          ))}
                        </ul>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ul>
</nav>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { bindToggleKeys } from "@components/navigation/bar/toggleState";

  function setupSideNavigation() {
    document.querySelectorAll<HTMLElement>(".side").forEach((sideNav) => {
      if (sideNav.dataset.sideInitialized === "true") return;
      sideNav.dataset.sideInitialized = "true";

      bindToggleKeys(sideNav);

      // Retire the no-animation flag only on panels that are currently closed.
      // Clearing it on an open one hands it a live `grow-out` and it replays
      // its expand under the pointer.
      sideNav.addEventListener("change", () => {
        sideNav.querySelectorAll(".nav-item-content[data-open-on-load]").forEach((panel) => {
          const toggle = panel.parentElement?.querySelector(":scope > .nav-item-toggle");
          if (!(toggle instanceof HTMLInputElement) || !toggle.checked) {
            panel.removeAttribute("data-open-on-load");
          }
        });
      });

      // A label re-checks an already-checked radio, which is a no-op; collapse
      // it by hand so a second click closes the panel.
      sideNav
        .querySelectorAll(".nav-item-toggle-btn, .nav-item.has-children > .nav-item-trigger")
        .forEach((trigger) => {
          trigger.addEventListener("click", (event) => {
            const label = event.currentTarget;
            if (!(label instanceof Element)) return;

            const toggle = document.getElementById(label.getAttribute("for") || "");
            if (toggle instanceof HTMLInputElement && toggle.checked) {
              event.preventDefault();
              toggle.checked = false;
              toggle.dispatchEvent(new Event("change", { bubbles: true }));
            }
          });
        });
    });
  }
  onPageLoad(setupSideNavigation);
</script>

<style is:global>
  @layer components {
    .side {
      .side-list,
      .nav-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav-item {
        list-style: none;
        position: relative;
      }

      /*
       * Row shell shared by direct links, static leaves and full-row label
       * triggers. Split rows (link + chevron toggle) use `.nav-item-split`
       * below. `min-height` + `padding-block` establish a consistent row
       * height across all of them.
       */
      .nav-item > a,
      .nav-item > .nav-item-static,
      .nav-item > .nav-item-trigger:not(.nav-item-toggle-btn) {
        align-items: center;
        border-radius: var(--radius-xs);
        color: inherit;
        display: flex;
        min-height: 1.75rem;
        padding: var(--spacing-sm) var(--spacing-md);
        text-decoration: none;
        transition: background-color var(--animation-normal) var(--ease-default);

        &:not(.nav-item-static):hover,
        &:not(.nav-item-static):focus-visible {
          background-color: var(--color-state-hover);
          color: var(--color-text-strong);

          .nav-item-icon {
            color: var(--color-text-strong);
          }
        }
      }

      .nav-item > a,
      .nav-item > .nav-item-static {
        font-weight: var(--font-weight-semibold);
      }

      .nav-item > .nav-item-static {
        color: var(--color-text-muted);
      }

      .nav-item > .nav-item-trigger:not(.nav-item-toggle-btn) {
        cursor: pointer;
        justify-content: space-between;
        padding-inline-end: 0;
        user-select: none;
        width: 100%;

        .nav-item-icon {
          align-items: center;
          box-sizing: border-box;
          display: inline-flex;
          flex-shrink: 0;
          justify-content: center;
          line-height: var(--line-height-none);
          margin-inline: 2px var(--spacing-xs);
          min-height: 1.75rem;
          min-width: 2.25rem;
          padding: var(--spacing-xs);
        }
      }

      /* Primary full-row trigger reads as a top-level heading */
      .side-list > .nav-item > .nav-item-trigger:not(.nav-item-toggle-btn) {
        font-weight: var(--font-weight-semibold);
      }

      .nav-item-split {
        align-items: stretch;
        border-radius: var(--radius-xs);
        display: flex;
        flex-wrap: nowrap;
        gap: var(--spacing-xs);
        min-width: 0;
        transition: background-color var(--animation-normal) var(--ease-default);
        width: 100%;

        &:hover {
          background-color: var(--color-state-hover);
          color: var(--color-text-strong);

          .nav-item-icon {
            color: var(--color-text-strong);
          }

          .nav-item-toggle-btn {
            background-color: color-mix(in srgb, var(--color-state-hover), var(--color-text) 3%);
          }
        }

        .nav-item-link {
          align-items: center;
          border-radius: var(--radius-xs);
          color: inherit;
          display: flex;
          flex: 1 1 auto;
          font-weight: var(--font-weight-semibold);
          min-height: 1.75rem;
          min-width: 0;
          padding: var(--spacing-sm) var(--spacing-xs) var(--spacing-sm) var(--spacing-md);
          text-decoration: none;
          transition: color var(--animation-normal) var(--ease-default);

          &:hover,
          &:focus-visible {
            color: var(--color-text-strong);
          }
        }

        .nav-item-toggle-btn {
          align-items: center;
          align-self: stretch;
          background: transparent;
          border: none;
          border-left: var(--border-width-sm) solid transparent;
          border-radius: var(--radius-xs);
          cursor: pointer;
          display: inline-flex;
          flex: 0 0 auto;
          justify-content: center;
          margin-inline: 2px var(--spacing-xs);
          min-width: 2.25rem;
          padding: 0 var(--spacing-xs);
          transition:
            background-color var(--animation-normal) var(--ease-default),
            border-color var(--animation-normal) var(--ease-default);

          &:hover {
            background-color: color-mix(in srgb, var(--color-state-hover), var(--color-text) 8%);
            border-left-color: var(--color-border);
          }

          &:focus-visible {
            outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
            outline-offset: 2px;
          }

          .nav-item-icon {
            align-items: center;
            display: flex;
            justify-content: center;
            line-height: var(--line-height-none);
          }
        }
      }

      .nav-item > a[aria-current="page"],
      .nav-item > .nav-item-trigger[aria-current="page"],
      .nav-item-split .nav-item-link[aria-current="page"] {
        text-decoration: underline dotted;
        text-decoration-color: var(--color-text-muted);
        text-underline-offset: 3px;
      }

      /* The radio drives expand/collapse via `:checked ~` selectors, and is
         hidden by `.visually-hidden` so it stays focusable. */
      .nav-item-content {
        display: none;
      }

      /* Draw the hidden control's focus ring on the trigger the user can see. */
      .nav-item:has(> .nav-item-toggle:focus-visible) > .nav-item-trigger,
      .nav-item:has(> .nav-item-toggle:focus-visible) > .nav-item-split .nav-item-trigger {
        outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
        outline-offset: 2px;
      }

      .nav-item-toggle:checked ~ .nav-item-content {
        animation: grow-out var(--animation-normal) var(--ease-out);
        display: block;
      }

      /* Groups holding the current page are served open; expanding something
         the visitor never asked for is not a transition. The flag is cleared
         once the panel closes, so every later open animates. */
      .nav-item-toggle:checked ~ .nav-item-content[data-open-on-load] {
        animation: none;
      }

      .nav-item-icon {
        color: var(--color-text-muted);
        display: inline-block;
        transition: transform var(--animation-normal) var(--ease-default);
      }

      .nav-item-toggle:checked ~ .nav-item-trigger .nav-item-icon,
      .nav-item-toggle:checked ~ .nav-item-split .nav-item-icon {
        transform: rotate(90deg);
      }

      .nav-list {
        & > .nav-item > a,
        & > .nav-item > .nav-item-static,
        & > .nav-item > .nav-item-trigger:not(.nav-item-toggle-btn) {
          font-weight: var(--font-weight-normal);
          padding-inline-start: var(--spacing-xl);
        }

        & > .nav-item > .nav-item-trigger:not(.nav-item-toggle-btn) {
          padding-inline-end: var(--spacing-sm);
        }

        & > .nav-item > .nav-item-split {
          box-sizing: border-box;
          padding-inline-start: var(--spacing-xl);
          padding-inline-end: var(--spacing-sm);
        }

        & > .nav-item > .nav-item-split .nav-item-link,
        & .nav-list > .nav-item > .nav-item-split .nav-item-link {
          font-weight: var(--font-weight-normal);
          padding: var(--spacing-sm) var(--spacing-xs) var(--spacing-sm) 0;
        }

        & .nav-list > .nav-item > a,
        & .nav-list > .nav-item > .nav-item-static,
        & .nav-list > .nav-item > .nav-item-trigger:not(.nav-item-toggle-btn) {
          padding-inline-start: var(--spacing-2xl);
        }

        & .nav-list > .nav-item > .nav-item-split {
          padding-inline-end: var(--spacing-xl);
          padding-inline-start: var(--spacing-2xl);
        }
      }
    }
  }
</style>
