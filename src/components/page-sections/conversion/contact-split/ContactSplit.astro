---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import Form from "@forms/form/Form.astro";
import Split from "@wrappers/split/Split.astro";
import { isAllowedExternalMediaUrl } from "../../../../integrations/consent/externalMedia";

type DetailProps = { icon?: string; label?: string; value?: string; url?: string };

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  subtext = "",
  details = [],
  formAction = "./",
  formBlocks = [],
  mapEmbedUrl = "",
  sectionLabel,
  maxContentWidth = "2xl",
  paddingHorizontal = "lg",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "base",
  background,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

// Not a literal "Map": every map would get the same accessible name.
const addressDetail = details?.find((detail: DetailProps) =>
  /address|location|map/i.test(`${detail.label ?? ""} ${detail.icon ?? ""}`)
);
const mapTitle = addressDetail?.value ? `Map of ${addressDetail.value}` : "Map";
const allowedMapEmbedUrl = isAllowedExternalMediaUrl(mapEmbedUrl) ? mapEmbedUrl : "";
---

<CustomSection
  class:list={["contact-split", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={background}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <div class="contact-split-card">
    <div class="contact-split-columns">
      <Split
        distributionMode="fixed-flexible"
        fixedWidth="400"
        alignmentVertical="top"
        minSplitWidth={640}
        gap="2xl"
      >
        <Fragment slot="first">
          <SimpleText
            class="eyebrow"
            size="sm"
            data-prop="eyebrow"
            text={eyebrow}
          />
          <Heading
            level={headingLevel}
            size="md"
            data-prop="heading"
          >
            {heading}
          </Heading>
          <Text
            class="contact-split-subtext"
            data-prop="subtext"
            text={subtext}
          />
          {details?.length > 0 && (
            <ul
              class="contact-details"
              data-editable="array"
              data-prop="details"
              data-direction="column"
            >
              {details?.map((detail: DetailProps) => (
                <li
                  class="contact-detail"
                  data-editable="array-item"
                >
                  <Icon
                    name={detail.icon}
                    size="md"
                  />
                  <span class="contact-detail-text">
                    {detail.label && <span class="visually-hidden">{detail.label}: </span>}
                    {detail.url ? (
                      <a
                        href={detail.url}
                        data-editable="text"
                        data-prop="value"
                      >
                        {detail.value}
                      </a>
                    ) : (
                      <span
                        data-editable="text"
                        data-prop="value"
                      >
                        {detail.value}
                      </span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </Fragment>
        <Fragment slot="second">
          <Form
            action={formAction}
            data-children-prop="formBlocks"
            formBlocks={formBlocks}
          />
        </Fragment>
      </Split>
    </div>
    {allowedMapEmbedUrl && (
      <div
        class="contact-split-map external-media-placeholder"
        data-external-media-src={allowedMapEmbedUrl}
        data-external-media-title={mapTitle}
      >
        <p>Allow external media across this site to view this map.</p>
        <button
          type="button"
          data-external-media-enable
        >
          Allow all external media
        </button>
      </div>
    )}
  </div>
</CustomSection>

<style is:global>
  @layer page-sections {
    .contact-split {
      .contact-split-card {
        border: var(--border-width-sm) solid var(--color-border);
        border-radius: var(--radius-md);
        overflow: hidden;
      }

      .contact-split-columns {
        padding: var(--spacing-2xl) var(--spacing-xl);
      }

      .contact-split-subtext .text-inner {
        color: var(--color-text-muted);
      }

      .contact-details {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
        list-style: none;
        margin: 0;
        padding: 0;

        > .contact-detail {
          display: flex;
          gap: var(--spacing-md);

          .icon {
            color: var(--color-text-muted);
            flex-shrink: 0;
            margin-top: var(--spacing-xs);
          }
        }
      }

      .contact-split-map {
        --contact-map-height: 12rem;

        background-color: var(--color-bg-surface);
        border-top: var(--border-width-sm) solid var(--color-border);

        iframe {
          border: none;
          display: block;
          height: var(--contact-map-height);
          width: 100%;
        }

        &.external-media-placeholder {
          align-items: center;
          display: flex;
          flex-direction: column;
          gap: var(--spacing-sm);
          justify-content: center;

          p {
            color: var(--color-text-muted);
            margin: 0;
          }

          button {
            background-color: var(--color-bg-brand);
            border: var(--border-width-sm) solid var(--color-bg-brand);
            border-radius: var(--radius-xs);
            color: var(--color-brand-on);
            cursor: pointer;
            font: inherit;
            font-weight: var(--font-weight-semibold);
            padding: var(--spacing-em-sm);
          }
        }
      }
    }
  }
</style>
