---
import { isNonEmptyString } from "@component-utils/isNonEmptyString";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Badge from "@core-elements/badge/Badge.astro";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import Segments from "@forms/segments/Segments.astro";
import PricingTiersItem from "@page-sections/conversion/pricing-tiers/PricingTiersItem.astro";
import Grid from "@wrappers/grid/Grid.astro";

type TierProps = Record<string, unknown>;

const {
  eyebrow = "",
  heading = "",
  subtext = "",
  showAnnualPricing = false,
  monthlyLabel = "Monthly",
  annualLabel = "Annual",
  annualBadge = "",
  defaultInterval = "monthly",
  tiers = [],
  sectionLabel,
  maxContentWidth = "2xl",
  paddingHorizontal = "lg",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor,
  background,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const billingName = `pricing-billing-${crypto.randomUUID()}`;
const annualSelected = defaultInterval === "annual";
---

<CustomSection
  class:list={["pricing-tiers", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={background}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    alignmentHorizontal="center"
    class="eyebrow"
    data-prop="eyebrow"
    text={eyebrow}
    size="sm"
  />
  <Heading
    level="h2"
    size="lg"
    alignmentHorizontal="center"
    data-prop="heading"
  >
    {heading}
  </Heading>
  <Text
    class="pricing-tiers-subtext"
    alignmentHorizontal="center"
    data-prop="subtext"
    text={subtext}
  />
  {
    showAnnualPricing && (
      <div class="pricing-tiers-billing">
        <Segments
          class="pricing-tiers-billing-segments"
          name={billingName}
          aria-label={`${monthlyLabel} or ${annualLabel}`}
          options={[
            {
              value: "monthly",
              label: monthlyLabel,
              checked: !annualSelected,
            },
            {
              value: "annual",
              label: annualLabel,
              checked: annualSelected,
            },
          ]}
        />
        {isNonEmptyString(annualBadge) && (
          <Badge
            class="pricing-tiers-billing-badge"
            variant="success"
            size="sm"
            text={annualBadge}
            data-prop="annualBadge"
          />
        )}
      </div>
    )
  }
  <Grid
    gap="lg"
    minItemWidth={272}
    maxItemWidth={420}
    layout="center"
    class="pricing-tiers-grid"
    data-children-prop="tiers"
  >
    {
      tiers.map((tier: TierProps) => (
        <PricingTiersItem
          data-id="page-sections/conversion/pricing-tiers/pricing-tiers-item"
          data-editable="array-item"
          {...tier}
          showAnnualPricing={showAnnualPricing}
        />
      ))
    }
  </Grid>
</CustomSection>

<style is:global>
  @layer page-sections {
    .pricing-tiers-billing {
      align-items: center;
      column-gap: var(--spacing-sm);
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      margin-top: var(--spacing-xl);

      > .pricing-tiers-billing-segments {
        grid-column: 2;
        width: max-content;
      }

      > .pricing-tiers-billing-badge {
        justify-self: start;
      }

      /* Stack so a long savings chip can't shove the switch off-center. */
      @media (width < 640px) {
        grid-template-columns: 1fr;
        justify-items: center;
        row-gap: var(--spacing-sm);

        > .pricing-tiers-billing-segments,
        > .pricing-tiers-billing-badge {
          grid-column: 1;
          justify-self: center;
        }
      }
    }

    .pricing-tiers-grid {
      /* The highlighted tier's "Most popular" badge overhangs its card top —
         the extra top margin is its headroom. */
      margin-top: var(--space-before-loose);
    }
  }
</style>
