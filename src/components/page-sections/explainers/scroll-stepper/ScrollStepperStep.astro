---
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";

const {
  eyebrow = "",
  title = "",
  description = "",
  imageSource = "",
  imageAlt = "",
  headingLevel = "h3",
  imageAspectRatio = "landscape",
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<div
  class:list={["scroll-stepper-step", className]}
  {...htmlAttributes}
>
  <div class="scroll-stepper-step-inner flow">
    <Image
      class="scroll-stepper-step-image"
      source={imageSource}
      alt={imageAlt || title}
      rounded={true}
      aspectRatio={imageAspectRatio}
      sizes="100vw"
      data-prop-src="imageSource"
      data-prop-alt="imageAlt"
    />
    <SimpleText
      class="eyebrow"
      data-prop="eyebrow"
      text={eyebrow}
      size="sm"
    />
    <Heading
      level={headingLevel}
      size="lg"
      spaceBefore="none"
      data-prop="title"
    >
      {title}
    </Heading>
    <Text
      data-prop="description"
      text={description}
    />
  </div>
</div>
