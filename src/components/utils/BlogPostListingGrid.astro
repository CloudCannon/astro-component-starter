---
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import Pagination from "@core-elements/pagination/Pagination.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Breadcrumbs from "@navigation/breadcrumbs/Breadcrumbs.astro";
import Card from "@wrappers/card/Card.astro";
import Grid from "@wrappers/grid/Grid.astro";
import GridItem from "@wrappers/grid/GridItem.astro";
import { formatPostDate } from "@component-utils/formatPostDate";

/** Paginated page object from `paginate()` (includes `data`, `url`, etc.). */
interface Props {
  page: any;
  emptyMessage: string;
  /** BCP 47 tag for the post dates. */
  locale?: string;
  /** Renders a Home › Blog › tag breadcrumb trail above the grid; grid uses a tighter top margin. */
  tagBreadcrumb?: {
    allPostsHref: string;
    allPostsLabel?: string;
    currentLabel: string;
  };
}

const { page, emptyMessage, locale = "en-US", tagBreadcrumb } = Astro.props;
---

{
  /* The leading gap stays an inline margin: whichever element comes first here
    is the section's first flow child, and `.flow > * + *` never gives that one
    a margin. Sibling gaps below do use `spaceBefore`. */
}

{
  page.data.length > 0 ? (
    <>
      {tagBreadcrumb && (
        <Breadcrumbs
          style="margin-top: var(--space-before-loose);"
          items={[
            { label: tagBreadcrumb.allPostsLabel ?? "Blog", url: tagBreadcrumb.allPostsHref },
            { label: tagBreadcrumb.currentLabel },
          ]}
        />
      )}
      <Grid
        gap="lg"
        minItemWidth="320"
        maxItemWidth="400"
        spaceBefore="default"
        style={tagBreadcrumb ? undefined : "margin-top: var(--space-before-loose);"}
      >
        {page.data.map((post: any) => {
          const pubDate = formatPostDate(post.data.date, locale);

          const slug = post.id?.replace(/\.mdx?$/, "") || post.slug;

          return (
            <GridItem>
              <Card
                link={`/blog/${slug}`}
                rounded={true}
                border={true}
                paddingVertical="lg"
                paddingHorizontal="lg"
              >
                {post.data.image && (
                  <Image
                    slot="before"
                    source={post.data.image}
                    decorative={true}
                    aspectRatio="landscape"
                    sizes="(max-width: 400px) 100vw, 400px"
                    widths={[320, 400, 640, 800]}
                    width={800}
                  />
                )}
                <SimpleText
                  size="sm"
                  style="color: var(--color-text-muted); margin-bottom: var(--spacing-xs);"
                >
                  {pubDate} • {post.data.author || "Anonymous"}
                </SimpleText>
                <Heading
                  level="h2"
                  size="md"
                  style="margin-bottom: var(--spacing-md); margin-top: var(--spacing-sm);"
                >
                  {post.data.title}
                </Heading>
                <SimpleText
                  size="sm"
                  style="color: var(--color-text-muted); margin-top: 0;"
                >
                  {post.data.description}
                </SimpleText>
              </Card>
            </GridItem>
          );
        })}
      </Grid>
      <Pagination
        page={page}
        showArrows={true}
        spaceBefore="loose"
      />
    </>
  ) : (
    <SimpleText
      alignmentHorizontal="center"
      style="margin-top: var(--space-before-loose);"
    >
      {emptyMessage}
    </SimpleText>
  )
}
