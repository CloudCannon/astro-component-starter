---
// Shared label + required-asterisk markup for form fields that use a standard
// `<label for>` association. Each consuming component keeps its own scoped
// `.<name>-required` styles, so `requiredClass` preserves per-component
// appearance (colour, margin side) exactly.
const { for: htmlFor, label, required = false, requiredClass } = Astro.props;
---

{
  label && (
    <label
      for={htmlFor}
      class="label"
    >
      {label}
      {required && (
        <span
          class:list={[requiredClass]}
          aria-hidden="true"
        >
          *
        </span>
      )}
    </label>
  )
}
