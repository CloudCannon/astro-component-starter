---
import { resolveOpenGraphImage } from "@component-utils/image";

interface SiteSeoData {
  name: string;
  url: string;
  logoSource: string;
  /** 1200×630 raster for social cards. Falls back to the logo when unset. */
  shareImage?: string | null;
  description: string;
  titleFormat: string;
  twitterSite?: string | null;
}

interface ArticleSeoData {
  publishedTime?: string | null;
  modifiedTime?: string | null;
  author?: string | string[] | null;
  tags?: string[] | null;
}

export interface Props {
  site: SiteSeoData;
  title: string;
  description?: string | null;
  keywords?: string[] | null;
  image?: string | null;
  /** Path to a build-time generated card, used when the page has no `image`. */
  generatedImage?: string | null;
  imageAlt?: string | null;
  canonical?: string | null;
  type?: "website" | "article";
  article?: ArticleSeoData | null;
  noindex?: boolean;
}

const {
  site,
  title,
  description,
  keywords,
  image,
  generatedImage,
  imageAlt,
  canonical,
  type: pageType = "website",
  article,
  noindex = false,
} = Astro.props;
// Search engines truncate titles around 60 characters and count `titleFormat`'s
// suffix too, so a long site name silently pushes every page over on its own.
// The page's own title is the half that has to survive: drop the suffix rather
// than let it crowd the title out.
const TITLE_LENGTH_BUDGET = 60;
const decoratedTitle = site.titleFormat.replace("{title}", title);
const formattedTitle =
  decoratedTitle.length > TITLE_LENGTH_BUDGET && title.length <= TITLE_LENGTH_BUDGET
    ? title
    : decoratedTitle;

if (import.meta.env.DEV && title.length > TITLE_LENGTH_BUDGET) {
  console.warn(
    `[seo] "${title}" is ${title.length} characters; search engines truncate around ${TITLE_LENGTH_BUDGET}.`
  );
}
const pageDescription = description || site.description;
const shareSource = generatedImage || image || site.shareImage || site.logoSource;
// A generated card is already a 1200x630 PNG under `/og/`, so it needs neither
// asset resolution nor the SVG warning below, and its dimensions are known.
const isGeneratedCard = Boolean(generatedImage) && shareSource === generatedImage;

if (import.meta.env.DEV && !isGeneratedCard && shareSource?.toLowerCase().endsWith(".svg")) {
  console.warn(
    `[seo] og:image resolves to "${shareSource}". Social crawlers do not render SVG — set "shareImage" in src/data/seo.json to a 1200×630 raster.`
  );
}
const share = isGeneratedCard
  ? { src: shareSource!, width: 1200, height: 630 }
  : shareSource
    ? await resolveOpenGraphImage(shareSource)
    : undefined;
const canonicalUrl = canonical || Astro.url.href;
const siteUrl = Astro.site || new URL(site.url);
const pageImageUrl = share ? new URL(share.src, siteUrl).href : undefined;
const pageImageAlt = imageAlt || (image || isGeneratedCard ? title : site.name);
const keywordContent = keywords?.filter(Boolean).join(", ");
const articleAuthors = Array.isArray(article?.author)
  ? article.author.filter(Boolean)
  : article?.author
    ? [article.author]
    : [];
const articleTags = article?.tags?.filter(Boolean) ?? [];
// The preview directives are opt-in: without them Google caps image previews
// and snippet length, which costs rich results and Discover eligibility.
const robotsContent = noindex
  ? "noindex"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
// X reads og:title / og:description / og:image as fallbacks, so only the card
// type and the site handle need their own tags.
const twitterCard = pageImageUrl ? "summary_large_image" : "summary";
const twitterSite = site.twitterSite?.trim();
---

<title>{formattedTitle}</title>
<meta
  name="robots"
  content={robotsContent}
/>
<link
  rel="canonical"
  href={canonicalUrl}
/>
<meta
  property="og:type"
  content={pageType}
/>
<meta
  property="og:title"
  content={formattedTitle}
/>
<meta
  property="og:url"
  content={canonicalUrl}
/>
<meta
  property="og:site_name"
  content={site.name}
/>
{
  pageDescription ? (
    <>
      <meta
        name="description"
        content={pageDescription}
      />
      <meta
        property="og:description"
        content={pageDescription}
      />
    </>
  ) : null
}
{
  keywordContent ? (
    <meta
      name="keywords"
      content={keywordContent}
    />
  ) : null
}
{
  pageImageUrl ? (
    <>
      <meta
        property="og:image"
        content={pageImageUrl}
      />
      {share?.width ? (
        <meta
          property="og:image:width"
          content={String(share.width)}
        />
      ) : null}
      {share?.height ? (
        <meta
          property="og:image:height"
          content={String(share.height)}
        />
      ) : null}
      {pageImageAlt ? (
        <meta
          property="og:image:alt"
          content={pageImageAlt}
        />
      ) : null}
    </>
  ) : null
}
<meta
  name="twitter:card"
  content={twitterCard}
/>
{
  twitterSite ? (
    <meta
      name="twitter:site"
      content={twitterSite}
    />
  ) : null
}
{
  pageType === "article" ? (
    <>
      {article?.publishedTime ? (
        <meta
          property="article:published_time"
          content={article.publishedTime}
        />
      ) : null}
      {article?.modifiedTime ? (
        <meta
          property="article:modified_time"
          content={article.modifiedTime}
        />
      ) : null}
      {articleAuthors.map((author) => (
        <meta
          property="article:author"
          content={author}
        />
      ))}
      {articleTags.map((tag) => (
        <meta
          property="article:tag"
          content={tag}
        />
      ))}
    </>
  ) : null
}
