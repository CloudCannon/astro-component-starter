---
const {
  id,
  labelledBy,
  selected = false,
  element: Element = "div",
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component: _component,
  ...htmlAttributes
} = Astro.props;
---

{/* `data-initial` is cleared by setup.ts on the first real switch — lets a
    consumer's CSS suppress a switch-in animation for the panel that's
    already showing on load, without also suppressing it for later switches
    back to that tab. */}
<Element
  class:list={["tab-panel", className]}
  id={id}
  role="tabpanel"
  aria-labelledby={labelledBy}
  aria-hidden={selected ? "false" : "true"}
  hidden={!selected}
  data-tab-panel
  data-initial={selected || undefined}
  {...htmlAttributes}
>
  <slot />
</Element>
