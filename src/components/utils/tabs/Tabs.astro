---
const {
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const hasSlotContent = Astro.slots.has("default");

if (!_component && !hasSlotContent) return;
---

<div
  class:list={["tabs", className]}
  data-tabs
  {...htmlAttributes}
>
  <slot />
</div>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllTabs } from "./setup";

  onPageLoad(() => setupAllTabs());
</script>
