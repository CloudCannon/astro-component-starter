---
import AnnouncementBar from "@navigation/announcement-bar/AnnouncementBar.astro";
import Footer from "@navigation/footer/Footer.astro";
import MainNavigation from "@navigation/main-nav/MainNav.astro";
import ThemeToggleScript from "@navigation/theme-toggle/ThemeToggleScript.astro";
import MainComponent from "@component-utils/MainComponent.astro";
import { resolveSearchThumbnail } from "@component-utils/image";
import announcementBarData from "@data/announcementBar.json";
import footerData from "@data/footer.json";
import mainNavData from "@data/mainNav.json";
import Layout from "@layouts/BaseLayout.astro";

import type { ContentBlock } from "../types";

type Props = {
  frontmatter?: {
    title: string;
    description?: string;
    keywords?: string[];
    image?: string;
    canonical?: string;
    type?: "website" | "article";
    article?: {
      publishedTime?: string;
      modifiedTime?: string;
      author?: string | string[];
      tags?: string[];
    };
    pageSections?: ContentBlock[];
    noindex?: boolean;
  };
  title?: string;
  description?: string;
  keywords?: string[];
  image?: string;
  canonical?: string;
  type?: "website" | "article";
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string | string[];
    tags?: string[];
  };
  noindex?: boolean;
  generatedImage?: string | null;
  disablePagefind?: boolean;
  /** The search's `Type` filter value; the tabs in `Search.astro` must name it. */
  pagefindType?: string;
  mainNav?: Record<string, unknown>;
  footer?: Record<string, unknown>;
  announcementBar?: Record<string, unknown>;
};

const {
  frontmatter,
  title: titleProp,
  description: descriptionProp,
  keywords: keywordsProp,
  image: imageProp,
  canonical: canonicalProp,
  type: typeProp,
  article: articleProp,
  noindex: noindexProp,
  generatedImage,
  disablePagefind = false,
  pagefindType = "Page",
  mainNav = mainNavData,
  footer = footerData,
  announcementBar = announcementBarData,
} = Astro.props as Props;

const title = frontmatter?.title ?? titleProp ?? "";
const description = frontmatter?.description ?? descriptionProp;
const keywords = frontmatter?.keywords ?? keywordsProp;
const image = frontmatter?.image ?? imageProp;
const canonical = frontmatter?.canonical ?? canonicalProp;
const type = frontmatter?.type ?? typeProp;
const article = frontmatter?.article ?? articleProp;
const noindex = frontmatter?.noindex ?? noindexProp ?? false;
const sections = frontmatter?.pageSections ?? [];
const indexed = !disablePagefind && !noindex;

// Unnamed, Pagefind thumbnails the first <img> in the body, decorative or not.
const heroWithImage = sections.find(
  (section: any) =>
    String(section?._component ?? "").startsWith("page-sections/heroes/") &&
    typeof section?.imageSource === "string" &&
    section.imageSource.trim()
) as { imageSource: string; imageAlt?: string } | undefined;
const thumbnailSource = image || heroWithImage?.imageSource;
const thumbnail = indexed && thumbnailSource ? await resolveSearchThumbnail(thumbnailSource) : null;
const thumbnailAlt = (image ? title : heroWithImage?.imageAlt) || title;

const primaryHeading = sections.find(
  (section: any) => typeof section?.heading === "string" && section.heading.trim()
)?.heading as string | undefined;
---

<Layout
  heading={primaryHeading}
  title={title}
  description={description}
  keywords={keywords}
  image={image}
  generatedImage={generatedImage}
  canonical={canonical}
  type={type}
  article={article}
  noindex={noindex}
>
  {mainNav.themeToggle && <ThemeToggleScript slot="head" />}
  <a
    class="skip-link"
    href="#main-content"
  >
    Skip to main content
  </a>
  <AnnouncementBar {...announcementBar} />
  <MainNavigation {...mainNav} />

  <main
    id="main-content"
    {...(indexed
      ? { "data-pagefind-body": true, "data-pagefind-filter": `Type:${pagefindType}` }
      : { "data-pagefind-ignore": "all" })}
  >
    {sections.length > 0 && (
      <div
        data-editable="component"
        data-component="utils/main-component"
        data-prop-sections="pageSections"
      >
        <MainComponent sections={sections} />
      </div>
    )}
    <div>
      <slot />
    </div>
    {indexed && (
      <span
        hidden
        data-pagefind-meta={thumbnail ? "image[data-src], image_alt[data-alt]" : "image:"}
        data-src={thumbnail}
        data-alt={thumbnail ? thumbnailAlt : undefined}
      />
    )}
  </main>
  <Footer
    {...footer}
    data-prop={footer === footerData ? "@file[/src/data/footer.json]" : undefined}
  />
</Layout>
