---
import footerData from "@data/footer.json";
import mainNavData from "@data/mainNav.json";
import Page from "@layouts/Page.astro";
import CustomSection from "@page-sections/builders/custom-section/CustomSection.astro";
import { ogCardPath } from "../utils/og/paths";
import { getCollection, render, type CollectionEntry } from "astro:content";

export interface Props {
  page: CollectionEntry<"pages">;
}

export async function getStaticPaths() {
  const pages = await getCollection("pages");

  return pages
    .filter((page) => {
      const slug = page.id.replace(/(^|\/)index$/, "");

      return slug !== "blog";
    })
    .map((page) => {
      const slug = page.id.replace(/(^|\/)index$/, "");

      if (slug.length === 0) return { params: { slug: undefined }, props: { page } };
      return { params: { slug }, props: { page } };
    });
}

const { page } = Astro.props;
const { Content } = await render(page);
const hasBody = Boolean(page.body?.trim());
---

<Page
  frontmatter={page.data}
  generatedImage={ogCardPath("page", page)}
  mainNav={mainNavData}
  footer={footerData}
>
  {hasBody && (
    <CustomSection
      maxContentWidth="md"
      paddingHorizontal="lg"
      paddingVertical="4xl"
    >
      <div class="prose">
        <Content />
      </div>
    </CustomSection>
  )}
</Page>
