---
import { breadcrumbListJsonLd } from "@components/utils/breadcrumbTrail";
import { slugifyLabel } from "@components/utils/slugify";
import Badge from "@core-elements/badge/Badge.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import breadcrumbsData from "@data/breadcrumbs.json";
import Page from "@layouts/Page.astro";
import Toc from "@navigation/toc/Toc.astro";
import CustomSection from "@page-sections/builders/custom-section/CustomSection.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { loadBlogPageContext } from "../../utils/blog";

// Automatically import all components from building-blocks and page-sections for MDX
const buildingBlocksImports = import.meta.glob("../../components/building-blocks/**/*.astro", {
  eager: true,
});

const pageSectionsImports = import.meta.glob("../../components/page-sections/**/*.astro", {
  eager: true,
});

// Merge both import objects
const componentImports = { ...buildingBlocksImports, ...pageSectionsImports };

// Build components object with PascalCase names from file paths
const mdxComponents: Record<string, any> = {};

Object.entries(componentImports).forEach(([path, module]) => {
  const pathParts = path.split("/");
  const fileName = pathParts[pathParts.length - 1].replace(".astro", "");

  // Component name is already PascalCase from filename
  const componentName = fileName;

  mdxComponents[componentName] = (module as any).default;
});

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post: CollectionEntry<"blog">) => {
    const slug = post.id.replace(/\.mdx?$/, "");

    return {
      params: { slug },
      props: { post },
    };
  });
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = post.data.showToc && tocHeadings.length > 0;
const { blogPage } = await loadBlogPageContext();
const blogListingLabel = blogPage?.data?.title ?? "Blog";
const date = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const dateIso = post.data.date.toISOString().slice(0, 10);
const category = post.data.tags[0]?.trim() ?? "";
const categoryHref = category ? `/blog/tag/${slugifyLabel(category)}/` : "";
const article = {
  publishedTime: post.data.date.toISOString(),
  author: post.data.author,
  tags: post.data.tags,
};

const breadcrumbJsonLd = breadcrumbListJsonLd(
  [{ label: blogListingLabel, url: "/blog/" }, { label: post.data.title }],
  { homeLabel: breadcrumbsData.homeLabel, base: Astro.site ?? Astro.url }
);
---

<Page
  title={post.data.title}
  description={post.data.description}
  keywords={post.data.keywords}
  image={post.data.image}
  type="article"
  article={article}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJsonLd)}
  />
  <CustomSection
    maxContentWidth={showToc ? "2xl" : "xl"}
    paddingHorizontal="lg"
    paddingVertical="4xl"
    colorScheme="inherit"
    backgroundColor="base"
    class="post-container"
    data-pagefind-filter="Type:Article"
  >
    <div class:list={[showToc && "post-with-toc"]}>
      <header class="post-header">
        <a
          class="post-back"
          href="/blog/"
        >
          ← {blogListingLabel}
        </a>

        <Heading
          data-prop="title"
          data-pagefind-meta="title"
          level="h1"
          size="2xl"
          class="post-title"
        >
          {post.data.title}
        </Heading>

        {
          post.data.description && (
            <SimpleText
              data-prop="description"
              data-pagefind-meta="description"
              data-pagefind-weight="3"
              size="lg"
              class="post-description"
            >
              {post.data.description}
            </SimpleText>
          )
        }

        <SimpleText
          size="sm"
          class="post-meta"
        >
          {
            category && (
              <>
                <a
                  class="post-meta-category"
                  href={categoryHref}
                >
                  {category}
                </a>
                <span
                  class="post-meta-separator"
                  aria-hidden="true"
                >
                  ·
                </span>
              </>
            )
          }
          <time
            datetime={dateIso}
            data-pagefind-meta={`published:${dateIso}`}
            data-pagefind-sort={`date:${dateIso}`}
          >
            {date}
          </time>
          <span
            class="post-meta-separator"
            aria-hidden="true"
          >
            ·
          </span>
          <span
            data-prop="author"
            data-pagefind-filter="Author"
            data-pagefind-meta="author"
          >
            {post.data.author}
          </span>
        </SimpleText>
      </header>

      {
        post.data.image && (
          <Image
            source={post.data.image}
            alt={post.data.title}
            rounded={true}
            data-prop-src="image"
            data-prop-alt="title"
            class="post-image"
            aspectRatio="widescreen"
            positionVertical="center"
            imageElementAttributes={{
              "data-pagefind-meta": "image[src], image_alt[alt]",
            }}
          />
        )
      }

      {showToc && <Toc headings={tocHeadings} />}
      <div
        class="post prose"
        data-editable="text"
        data-prop="@content"
      >
        <Content components={mdxComponents} />
      </div>
      {
        post.data.tags.length > 0 && (
          <div
            class="post-tags"
            data-editable="array"
            data-prop="tags"
            data-direction="row"
          >
            {post.data.tags.map((tag) => (
              <Badge
                text={tag.trim()}
                link={`/blog/tag/${slugifyLabel(tag.trim())}/`}
                showArrow={false}
                variant="plain"
                size="sm"
                data-pagefind-filter="Tag"
                data-editable="array-item"
                data-id={tag.trim()}
              />
            ))}
          </div>
        )
      }
    </div>
  </CustomSection>
</Page>

<style is:global>
  .post-container.custom-section > .outer-content > .content {
    padding-bottom: 0 !important;
  }

  .post-header {
    margin-inline: auto;
    max-width: 70ch;
  }

  .post-back {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    transition: color var(--animation-fast) var(--ease-out);
  }

  .post-back:hover {
    color: var(--color-text);
  }

  .post-title {
    margin-top: var(--spacing-lg);
  }

  .post-description {
    color: var(--color-text-muted);
    margin-top: var(--spacing-md);
  }

  .post-meta {
    color: var(--color-text-muted);
    margin-top: var(--spacing-lg);
  }

  .post-meta .post-meta-separator {
    color: var(--color-border);
    padding-inline: var(--spacing-sm);
  }

  .post-meta .post-meta-category {
    color: inherit;
    text-decoration: none;
    transition: color var(--animation-fast) var(--ease-out);
  }

  .post-meta .post-meta-category:hover {
    color: var(--color-text);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-inline: auto;
    margin-top: var(--spacing-xl);
    max-width: 70ch;
  }

  .post {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 70ch)
      minmax(0, 1fr);
    margin-inline: auto;
    margin-top: var(--spacing-xl);
  }

  .post-with-toc > .toc {
    margin-top: var(--spacing-xl);
  }

  /* Four explicit rows so `grid-row: 3 / -1` resolves against a known last
     line — an implicit-only grid treats -1 as line 1. */
  @media (width >= 1024px) {
    .post-with-toc {
      column-gap: var(--spacing-2xl);
      display: grid;
      grid-template-columns: 16rem minmax(0, 1fr);
      grid-template-rows: auto auto auto auto;
    }

    .post-with-toc > .post-header,
    .post-with-toc > .post-image,
    .post-with-toc > .post,
    .post-with-toc > .post-tags {
      grid-column: 2;
      min-width: 0;
    }

    .post-with-toc > .post-header {
      grid-row: 1;
    }

    .post-with-toc > .post-image {
      grid-row: 2;
    }

    .post-with-toc > .post {
      grid-row: 3;
      margin-inline: 0;
    }

    .post-with-toc > .post-tags {
      grid-row: 4;
    }

    .post-with-toc > .toc {
      align-self: start;
      grid-column: 1;
      grid-row: 3 / -1;
      position: sticky;
      /* 5rem matches .main-nav's bar height. */
      top: calc(5rem + var(--spacing-lg));
    }
  }

  .post > * {
    grid-column: 2;
  }

  .post > .wide,
  .post > pre,
  .post > .image,
  .post > .video {
    grid-column: 1 / -1;
  }

  .post > h1,
  .post > h2,
  .post > h3,
  .post > h4,
  .post > h5,
  .post > h6 {
    margin-bottom: 0;
    margin-top: 1rem;

    &:first-child {
      margin-top: 0;
    }
  }

  .post > .astro-code {
    margin-block: var(--spacing-xl);
  }

  .post-image {
    margin-top: var(--spacing-xl);
  }
</style>
