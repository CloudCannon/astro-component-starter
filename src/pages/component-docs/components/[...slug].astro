---
import ComponentLayout from "@component-docs/layouts/ComponentLayout.astro";
import { getComponentIndex } from "@component-docs/shared/componentIndex";
import { isComponentLibraryDisabled } from "@component-docs/shared/componentLibraryFlag";
import { getMergedSlotDocs } from "@component-docs/shared/metadata";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  // Skip component docs routes if DISABLE_COMPONENT_LIBRARY is set
  if (isComponentLibraryDisabled()) {
    return [];
  }

  const entries = await getComponentIndex();

  return entries.map((entry) => ({
    params: { slug: entry.key },
    props: { page: entry.docsEntry, configData: entry.config, componentKey: entry.key },
  }));
}

const { page, configData, componentKey } = Astro.props;
const frontmatter = page?.data ?? {};
const Content = page ? (await render(page)).Content : null;
const slotDocs = await getMergedSlotDocs(componentKey);

const searchPattern = `${componentKey}/examples/`.toLowerCase();

let examples: CollectionEntry<"docs-component-examples">[] = [];

try {
  examples = await getCollection("docs-component-examples", ({ id }) => {
    return id && id.toLowerCase().startsWith(searchPattern);
  });
} catch (error) {
  console.error("Error loading examples:", error);
}
---

<ComponentLayout
  frontmatter={frontmatter}
  configData={configData}
  examples={examples}
  componentKey={componentKey}
  slotDocs={slotDocs}
>
  {Content && <Content />}
</ComponentLayout>
