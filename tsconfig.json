{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "jsx": "preserve",
    "types": ["astro/client"],
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@building-blocks/*": ["src/components/building-blocks/*"],
      "@core-elements/*": ["src/components/building-blocks/core-elements/*"],
      "@forms/*": ["src/components/building-blocks/forms/*"],
      "@wrappers/*": ["src/components/building-blocks/wrappers/*"],
      "@navigation/*": ["src/components/navigation/*"],
      "@page-sections/*": ["src/components/page-sections/*"],
      "@explainers/*": ["src/components/page-sections/explainers/*"],
      "@builders/*": ["src/components/page-sections/builders/*"],
      "@component-utils/*": ["src/components/utils/*"],
      "@component-docs/*": ["src/component-docs/*"],
      "@layouts/*": ["src/layouts/*"],
      "@styles/*": ["src/styles/*"],
      "@data/*": ["src/data/*"],
      "@content/*": ["src/content/*"],
      "@assets/*": ["src/assets/*"]
    }
  },
  "include": [".astro/types.d.ts", "src/env.d.ts", "**/*"],
  "exclude": ["node_modules", "dist"]
}
